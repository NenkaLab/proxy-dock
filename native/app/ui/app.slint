// ProxyDock window (proxydock-ui.exe): Material 3 Expressive on Slint's "material" style (build.rs), same look as
// the prototype. Pages so far: the proxy cards and the log; everything comes from the core process over ipc.
import { ListView, Palette, ScrollView } from "std-widgets.slint";
import {
    NodeEditor, BaseNode, Pin, PinTypes, NodeEditorEvents, NodeEditorInternalCallbacks, NodeEditorComputations, LinkData, GroupData, GroupStyleDefaults, DragState, PinGrab,
} from "@nodeeditor";

export { PinTypes, NodeEditorEvents, NodeEditorInternalCallbacks, NodeEditorComputations, DragState, PinGrab, GroupStyleDefaults }
import "../../../fonts/PretendardVariable.ttf";
import "../../../fonts/JetBrainsMono.ttf";

// M3 color roles, light / dark: the seed's roles (l-* / d-*) are set from the theme colour (core theme.rs);
// the defaults are the baseline for seed #0061A4
export global M3 {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    in property <color> l-primary: #0061a4;
    in property <color> d-primary: #9ecaff;
    out property <color> primary: dark ? d-primary : l-primary;
    in property <color> l-on-primary: #ffffff;
    in property <color> d-on-primary: #003258;
    out property <color> on-primary: dark ? d-on-primary : l-on-primary;
    in property <color> l-primary-container: #d1e4ff;
    in property <color> d-primary-container: #00497d;
    out property <color> primary-container: dark ? d-primary-container : l-primary-container;
    in property <color> l-on-primary-container: #001d36;
    in property <color> d-on-primary-container: #d1e4ff;
    out property <color> on-primary-container: dark ? d-on-primary-container : l-on-primary-container;
    in property <color> l-secondary-container: #d7e3f7;
    in property <color> d-secondary-container: #3b4858;
    out property <color> secondary-container: dark ? d-secondary-container : l-secondary-container;
    in property <color> l-on-secondary-container: #101c2b;
    in property <color> d-on-secondary-container: #d7e3f7;
    out property <color> on-secondary-container: dark ? d-on-secondary-container : l-on-secondary-container;
    out property <color> error: dark ? #ffb4ab : #ba1a1a;
    out property <color> error-container: dark ? #93000a : #ffdad6;
    out property <color> on-error-container: dark ? #ffdad6 : #410002;
    out property <color> green-container: dark ? #1f5129 : #b7f1bc;
    out property <color> on-green-container: dark ? #b7f1bc : #002107;
    in property <color> l-tertiary-container: #f2daff;
    in property <color> d-tertiary-container: #523f5f;
    out property <color> tertiary-container: dark ? d-tertiary-container : l-tertiary-container;
    in property <color> l-on-tertiary-container: #251431;
    in property <color> d-on-tertiary-container: #f2daff;
    out property <color> on-tertiary-container: dark ? d-on-tertiary-container : l-on-tertiary-container;
    in property <color> l-surface-container-highest: #e0e2e8;
    in property <color> d-surface-container-highest: #32353a;
    out property <color> surface-container-highest: dark ? d-surface-container-highest : l-surface-container-highest;
    out property <color> amber-container: dark ? #5a4300 : #ffdf9e;
    out property <color> on-amber-container: dark ? #ffdf9e : #261a00;
    in property <color> l-surface: #f8f9ff;
    in property <color> d-surface: #111418;
    out property <color> surface: dark ? d-surface : l-surface;
    in property <color> l-surface-container-low: #f2f3f9;
    in property <color> d-surface-container-low: #191c20;
    out property <color> surface-container-low: dark ? d-surface-container-low : l-surface-container-low;
    in property <color> l-surface-container: #eceef4;
    in property <color> d-surface-container: #1d2024;
    out property <color> surface-container: dark ? d-surface-container : l-surface-container;
    in property <color> l-surface-container-high: #e6e8ee;
    in property <color> d-surface-container-high: #272a2f;
    out property <color> surface-container-high: dark ? d-surface-container-high : l-surface-container-high;
    in property <color> l-on-surface: #191c20;
    in property <color> d-on-surface: #e1e2e8;
    out property <color> on-surface: dark ? d-on-surface : l-on-surface;
    in property <color> l-on-surface-variant: #43474e;
    in property <color> d-on-surface-variant: #c3c7cf;
    out property <color> on-surface-variant: dark ? d-on-surface-variant : l-on-surface-variant;
    in property <color> l-outline-variant: #c3c7cf;
    in property <color> d-outline-variant: #43474e;
    out property <color> outline-variant: dark ? d-outline-variant : l-outline-variant;
}

// text settings (proxydock-ui.rs `show_settings`): the size of all text (Python "Text size", 115% = 1),
// and the log's monospace font
export global Type {
    in property <float> scale: 1;
    in property <string> mono: "JetBrains Mono";
}

global Motion {
    out property <duration> fast-spatial: 350ms;
    out property <duration> fast-effects: 150ms;
}

export struct Wire { i: int, o: int }
// a router output's colour: its key (rule id / "default"), whether it has its own, the colour its link has
export struct OutColor { key: string, own: bool, color: color }
// a line under a block's title: its text and tone (0 normal, 1 warning, 2 muted, 3 via chain, 4 on)
export struct InfoLine { text: string, tone: int }

// an entry of a right-click menu (`action` goes back to the core)
export struct MenuLeaf { action: string, title: string, checked: bool }
// a program in the program picker (Python `ProgramPicker`)
export struct PickItem { name: string, checked: bool }

export struct NodeData {
    id: int,
    title: string,
    detail: string,
    // 0 inbound (card), 1 router / IF, 2 outbound, 3 pass-through, 4 PC
    kind: int,
    x: float,
    y: float,
    selected: bool,
    ins: int,
    outs: int,
    in-labels: [string],
    out-labels: [string],
    wires: [Wire],
    // pass-through: wired freely (its inputs and outputs added to apart)
    routed: bool,
    // pass-through: open as a box (named lanes, wiring edited inside); folded = the small block
    open: bool,
    // a card block: its id and state ("running" / "starting" / "stopped" / "error"), else ""
    card: string,
    state: string,
    // the state in words with its message ("Running", "error - port in use")
    state-text: string,
    // the lines under the title (canvas.rs `lines`)
    lines: [InfoLine],
    // a card's options (its block's chips) and an IF in switch mode (its on / off buttons)
    autostart: bool,
    auto-restart: bool,
    has-switch: bool,
    switch-on: bool,
    // the colour its links leave in, whether it is its own (not followed); a router's outputs' colours
    swatch: color,
    own-color: bool,
    out-colors: [OutColor],
    // its canvas group (0 = none); a collapsed group's stand-in block has kind 5
    group-id: int,
    // its fill colour (a group's stand-in: the group's colour); transparent = by kind
    fill: color,
    // traffic through the block right now ("" when none)
    rate: string,
    // an outbound block's latency: "123 ms", "✕", "…" ("" = none); tone 0 testing, 1 fast, 2 slow, 3 very slow / failed
    badge: string,
    badge-tone: int,
    // its right-click menu (edit::block_menu): its own entries, one submenu, "disconnect all", duplicate / delete
    menu: [MenuLeaf],
    menu-sub-title: string,
    menu-sub: [MenuLeaf],
    menu-cut: bool,
    menu-tail: bool,
}


// the canvas menus' texts (proxydock-ui.rs `labels`)
export global CanvasText {
    in property <string> run: "Run";
    in property <string> at-start: "At start";
    in property <string> auto-restart: "Auto-restart";
    in property <string> switched-on: "Switched on";
    in property <string> switched-off: "Switched off";
    in property <string> add-lane: "Add a lane";
    in property <string> add-input: "Input";
    in property <string> add-output: "Output";
    in property <string> stop: "Stop";
    in property <string> add-inbound: "Add inbound";
    in property <string> add-outbound: "Add outbound";
    in property <string> add-router: "Add router";
    in property <string> from-link: "From a share link (clipboard)";
    in property <string> router: "Router";
    in property <string> if-block: "IF";
    in property <string> relay: "Pass-through";
    in property <string> wireless: "Wireless pair";
    in property <string> fit: "Fit";
    in property <string> latency: "Test latency";
    in property <string> undo: "Undo";
    in property <string> redo: "Redo";
    in property <string> cut: "Disconnect all links";
    in property <string> duplicate: "Duplicate";
    in property <string> delete: "Delete";
    // the types the add menus offer: [type, name]
    in property <[MenuLeaf]> inbounds;
    in property <[MenuLeaf]> outbounds;
    // the list page's "New proxy" templates: [index, "name — what it is for"]
    in property <[MenuLeaf]> templates;
}

// the settings page's texts (translated in proxydock-ui.rs)
export struct SettingsText {
    title: string, apply: string, changed: string, revert: string,
    defaults: string, allowed: string, allowed-desc: string, private: string, private-desc: string,
    timeout: string, timeout-desc: string, logconn: string, logconn-desc: string, logclose: string, logclose-desc: string,
    dns: string, dns-desc: string, dnsvia: string, dnsvia-desc: string,
    engine: string, latest: string, latest-badge: string, latest-desc: string,
    logs: string, logfile: string, open-folder: string,
    display: string, language: string, language-desc: string, theme: string, theme-desc: string,
    scale: string, scale-desc: string, logsize: string, logsize-desc: string, close: string, close-desc: string,
    text-size: string, text-size-desc: string, fonts: string, ui-font: string, ui-font-desc: string,
    mono-font: string, mono-font-desc: string,
    startup: string, login: string, login-desc: string, hidden: string, hidden-desc: string, admin: string, admin-desc: string,
    updates: string, check-updates: string, check-updates-desc: string,
    firewall: string, fw-block: string, fw-block-desc: string, fw-on: string, fw-off: string,
    // the settings' categories (short names)
    cat-defaults: string,
    cat-startup: string,
}

// one field of the block editor (src/bin/proxydock-ui.rs fills it from core::form)
export struct FieldRow {
    key: string,
    // "" = drawn as the second box of the previous row
    label: string,
    desc: string,
    // "text" / "secret" / "int" / "bool" / "choice"
    kind: string,
    text: string,
    checked: bool,
    options: [string],
    index: int,
    visible: bool,
    // "item": the buttons' labels (their actions stay in the Rust side), and an icon that stands for a label
    // ("up" / "down" move the item; "" = the label)
    buttons: [string],
    button-icons: [string],
    // a button whose work runs (a download, a network check)
    busy: bool,
    // the description's colour: 0 normal, 1 success, 2 failure
    tone: int,
    // its card's place in a group (the rows between headings): the group's outer corners are round;
    // a heading: the first row shown (no room above it)
    first: bool,
    last: bool,
    // it continues the row above on that row's card / the row below continues it
    joined: bool,
    held: bool,
}

export struct CardRow {
    id: string,
    name: string,
    summary: string,
    // "running" / "starting" / "stopped" / "error"
    state: string,
    state-text: string,
    error: string,
    traffic: string,
    action: string,
    // its block's right-click menu (for the ⋯ button)
    menu: [MenuLeaf],
    menu-sub-title: string,
    menu-sub: [MenuLeaf],
    menu-cut: bool,
    menu-tail: bool,
}

// an outbound block, a router / IF or the PC block on the list page
export struct BlockRow {
    key: string,
    title: string,
    detail: string,
    // 1 router / IF, 2 outbound, 4 the PC block
    kind: int,
    // an IF in switch mode: its switch shown (and its state)
    has-switch: bool,
    switch-on: bool,
    menu: [MenuLeaf],
    menu-sub-title: string,
    menu-sub: [MenuLeaf],
    menu-cut: bool,
    menu-tail: bool,
}

// a dot moving along a link with traffic (world coordinates; size in world px)
export struct FlowDot { x: float, y: float, size: float, color: color }

export struct LogRow {
    text: string,
    // 0 normal, 1 warning, 2 problem (failure, auth, block, error), 3 connection
    tone: int,
    // a card's line: the card's id and the message (a connection line can show its way on the canvas)
    card: string,
    message: string,
    routable: bool,
    // its level tag (TCP, UDP, BLOCK, AUTH, FAIL, ERROR, WARN, SET, INFO): its colour
    level: string,
}

// the log's colours by level (Python `LOG_COLORS_DARK / LIGHT`)
global LogColors {
    pure public function of(level: string) -> color {
        if M3.dark {
            return level == "TCP" ? #6ccb5f : level == "UDP" ? #60cdff : level == "BLOCK" ? #ffb86c : level == "AUTH" ? #d7a6ff
                : level == "FAIL" ? #f7a8b8 : level == "ERROR" ? #ff6b6b : level == "WARN" ? #fce100 : level == "SET" ? #e8d44d : #a8a8a8;
        }
        return level == "TCP" ? #107c10 : level == "UDP" ? #005fb8 : level == "BLOCK" ? #c25e00 : level == "AUTH" ? #8764b8
            : level == "FAIL" ? #a4262c : level == "ERROR" ? #c42b1c : level == "WARN" ? #8a7400 : level == "SET" ? #7a6a00 : #5c5c5c;
    }
}

// A block on the canvas. Pin ids: input lane i = node * 64 + i * 2, output lane o = node * 64 + o * 2 + 1
// (proxydock-ui.rs pin_in / pin_out).
// a row of the colour palette's menu part (48px, M3 menu item)
component PaletteRow inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> checked;
    callback clicked();
    height: 48px;
    background: row-ta.has-hover ? M3.on-surface.with-alpha(0.08) : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        Image {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            source: root.checked ? @image-url("icons/check.svg") : root.icon;
            colorize: M3.on-surface-variant;
        }
        Text {
            text: root.text;
            font-size: 14px * Type.scale;
            color: M3.on-surface;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    row-ta := TouchArea { clicked => { root.clicked(); } }
}

// a small M3 filter chip inside a block: a check and filled when on (an IF's switch: its colour when on)
component NodeChip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <color> fg;
    in property <color> fill: transparent;
    callback clicked();
    height: 32px;
    border-radius: 8px;
    preferred-width: chip-lay.preferred-width;
    min-width: chip-lay.preferred-width;
    property <bool> colored: root.fill != transparent;
    background: root.on ? (root.colored ? root.fill : root.fg.with-alpha(0.18)) : transparent;
    border-width: root.on ? 0px : 1px;
    border-color: root.fg.with-alpha(0.35);
    Rectangle {
        border-radius: parent.border-radius;
        background: chip-ta.pressed ? root.fg.with-alpha(0.12) : chip-ta.has-hover ? root.fg.with-alpha(0.08) : transparent;
    }
    chip-lay := HorizontalLayout {
        padding-left: root.on && !root.colored ? 4px : 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;
        if root.on && !root.colored: Image {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            source: @image-url("icons/check.svg");
            colorize: root.fg;
        }
        Text {
            text: root.text;
            font-size: 12px * Type.scale;
            font-weight: 500;
            color: root.on && root.colored ? #ffffff : root.fg;
            vertical-alignment: center;
        }
    }
    chip-ta := TouchArea { clicked => { root.clicked(); } }
}

// a pass-through lane's name on its box: a chip; double-click to rename the lane
component LaneChip inherits Rectangle {
    in property <string> text;
    in property <bool> right;
    in property <color> fg;
    callback renamed();
    height: 26px;
    border-radius: 13px;
    background: chip-ta.has-hover ? root.fg.with-alpha(0.14) : root.fg.with-alpha(0.08);
    Text {
        x: 10px;
        width: parent.width - 20px;
        horizontal-alignment: root.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        vertical-alignment: center;
        text: root.text;
        font-size: 12px * Type.scale;
        font-weight: 500;
        color: root.fg;
        overflow: elide;
    }
    chip-ta := TouchArea {
        double-clicked => { root.renamed(); }
    }
}

component ProxyNode inherits BaseNode {
    in property <string> title;
    in property <string> detail;
    in property <int> kind;
    in property <int> ins;
    in property <int> outs;
    in property <[string]> in-labels;
    in property <[string]> out-labels;
    in property <[Wire]> wires;
    in property <bool> routed;
    in property <bool> open;
    in property <string> state;
    in property <string> state-text;
    in property <[InfoLine]> lines;
    in property <bool> autostart;
    in property <bool> auto-restart;
    in property <bool> has-switch;
    in property <bool> switch-on;
    callback set-flag(string, bool);
    callback set-switch(bool);
    in property <color> swatch;
    in property <bool> own-color;
    in property <[OutColor]> out-colors;
    // a colour swatch clicked: the output's key ("" = the block), where (window coordinates)
    callback pick-color(string, length, length);
    // a wireless half: its pair number ("#3") on a pill; clicked to change it
    callback edit-number();
    in property <string> rate;
    in property <string> badge;
    in property <int> badge-tone;
    callback toggle();
    callback edit();
    in property <[MenuLeaf]> menu;
    in property <string> menu-sub-title;
    in property <[MenuLeaf]> menu-sub;
    in property <bool> menu-cut;
    in property <bool> menu-tail;
    callback menu-action(string);

    // layout: the title row, the info lines (and a card's state, the traffic), then a row per port with its name
    // (6: a group's port, a chip with its name: no info lines, its one lane level with the name)
    property <bool> port: root.kind == 6;
    property <length> top: root.port ? 0px : 44px;
    property <length> line-h: 12px * Type.scale * 1.5;
    // a pass-through (not a wireless half): open, a box with a named chip per lane and its wiring between them
    property <bool> relay: root.kind == 3 && root.detail == "";
    property <bool> box: root.relay && root.open;
    property <length> lane-h: root.box ? 36px : 28px;
    property <length> inset: root.box ? 128px : 40px;
    property <int> rows: max(ins, outs);
    property <bool> lanes: kind == 1 || root.box || (kind == 3 && (ins > 1 || outs > 1 || wires.length > 0));
    // blocks traffic passes keep a line for its speed (faded while there is none), so they keep their size
    property <bool> shows-rate: root.kind <= 3;
    property <int> line-count: root.lines.length + (root.state != "" ? 1 : 0) + (root.shows-rate ? 1 : 0);
    // a card: Run / At start / Auto-restart chips; an IF in switch mode: its on / off buttons (Python's block widgets)
    property <bool> chips: root.state != "" || root.has-switch;
    property <length> chips-top: root.top + root.line-count * root.line-h + 6px;
    property <length> ports-top: root.chips-top + (root.chips ? 40px : 4px) + root.head-h;
    // the block grows to fit its chips (measured as all on: with their check, so a click never resizes it)
    property <length> base-width: kind == 0 ? 260px : kind == 1 ? 280px : root.box ? 400px : kind == 3 ? 220px : root.port ? 180px : 260px;
    property <length> card-chips-w: root.state != "" ? card-measure.preferred-width + 32px : 0px;
    property <length> switch-chips-w: root.has-switch ? 2 * max(on-measure.preferred-width, off-measure.preferred-width) + 6px + 32px : 0px;
    node-width: max(root.base-width, root.card-chips-w, root.switch-chips-w);
    card-measure := HorizontalLayout {
        visible: false;
        spacing: 6px;
        NodeChip { text: CanvasText.run; on: true; }
        NodeChip { text: CanvasText.at-start; on: true; }
        NodeChip { text: CanvasText.auto-restart; on: true; }
    }
    on-measure := NodeChip { visible: false; text: CanvasText.switched-on; on: true; }
    off-measure := NodeChip { visible: false; text: CanvasText.switched-off; on: true; }
    // an open pass-through: its inside wires are dragged on the box, the buttons under its title add lanes
    // (folded, the wiring is only shown)
    property <bool> lane-edit: root.box;
    property <length> head-h: root.lane-edit ? 36px : 0px;
    node-height: root.ports-top + (root.rows > 0 ? root.rows * root.lane-h + 8px : 0px);

    // a fill colour chosen for the block (5, a collapsed group standing in for its blocks: the group's colour)
    in property <color> fill: transparent;
    property <bool> filled: root.fill.alpha > 0;
    property <color> container: root.filled ? root.fill.mix(M3.surface-container-high, 0.35)
        : kind == 0 ? M3.green-container : kind == 1 ? M3.tertiary-container
        : kind == 3 ? M3.secondary-container : kind >= 4 ? M3.surface-container-highest : M3.primary-container;
    property <color> on-container: root.filled || kind >= 4 ? M3.on-surface
        : kind == 0 ? M3.on-green-container : kind == 1 ? M3.on-tertiary-container
        : kind == 3 ? M3.on-secondary-container : M3.on-primary-container;

    // y of the centre of port row n
    pure function lane-y(n: int) -> length {
        return root.ports-top + n * root.lane-h + root.lane-h / 2;
    }
    // an info line's colour by its tone (0 normal, 1 warning, 2 muted, 3 via chain, 4 on)
    pure function tone-color(tone: int) -> color {
        return tone == 1 ? (M3.dark ? #e8b339 : #9a6700) : tone == 2 ? root.on-container.with-alpha(0.6)
            : tone == 3 ? (M3.dark ? #ebbe6e : #8a5a00) : tone == 4 ? (M3.dark ? #6ccb5f : #107c10) : root.on-container.with-alpha(0.85);
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.container;
        // selected blocks morph to a rounder shape (expressive shape change)
        border-radius: root.port ? root.node-height / 2 : root.selected ? 28px : 18px;
        border-width: root.selected ? 3px : 0px;
        border-color: M3.primary;
        drop-shadow-blur: root.selected ? 12px : 3px;
        drop-shadow-offset-y: root.selected ? 4px : 1px;
        drop-shadow-color: #00000038;
        animate border-radius, drop-shadow-blur, drop-shadow-offset-y {
            duration: Motion.fast-spatial; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90);
        }
        // a card's state: a dot before the title
        if root.state != "": Rectangle {
            x: 16px; y: 19px;
            width: 10px; height: 10px; border-radius: 5px;
            background: root.state == "running" ? #2e9d4a : root.state == "starting" ? #d29b00
                : root.state == "error" ? M3.error : root.on-container.with-alpha(0.35);
        }
        Text {
            x: root.state != "" ? 34px : 20px; y: root.port ? (root.node-height - self.height) / 2 : 12px;
            width: root.node-width - self.x - (root.state != "" ? 84px : root.relay ? 84px : root.kind <= 3 || root.kind == 5 ? 52px : 14px)
                - (root.kind <= 2 ? 28px : 0px) - (root.badge != "" ? badge-pill.width + 6px : 0px);
            text: root.title;
            font-size: 16px * Type.scale;
            font-weight: 700;
            color: root.on-container;
            overflow: elide;
        }
        badge-pill := Rectangle {
            visible: root.badge != "";
            x: root.node-width - self.width - (root.state != "" ? 82px : root.kind <= 3 ? 50px : 12px) - (root.kind <= 2 ? 28px : 0px);
            y: 15px;
            width: root.badge == "✕" ? 28px : badge-text.preferred-width + 14px;
            height: 20px;
            border-radius: 10px;
            background: root.badge-tone == 1 ? #3fa34d : root.badge-tone == 2 ? #d9a21b : root.badge-tone == 3 ? #e5534b : #9aa0a6;
            if root.badge == "✕": Image {
                width: 14px;
                height: 14px;
                source: @image-url("icons/close.svg");
                colorize: #ffffff;
            }
            badge-text := Text {
                visible: root.badge != "✕";
                text: root.badge;
                font-size: 11px * Type.scale;
                font-weight: 700;
                color: #ffffff;
            }
        }
        // the info lines (a block without any shows its detail)
        for line[i] in root.lines: Image {
            visible: line.tone == 1;
            x: 20px;
            y: root.top + i * root.line-h + (root.line-h - self.height) / 2;
            width: 12px * Type.scale;
            height: 12px * Type.scale;
            source: @image-url("icons/warning.svg");
            colorize: root.tone-color(1);
        }
        for line[i] in root.lines: Text {
            x: line.tone == 1 ? 24px + 12px * Type.scale : 20px;
            y: root.top + i * root.line-h;
            width: root.node-width - 14px - self.x;
            text: line.text;
            font-size: 12px * Type.scale;
            color: root.tone-color(line.tone);
            overflow: elide;
        }
        if root.state != "": Rectangle {
            x: 21px;
            y: root.top + root.lines.length * root.line-h + (root.line-h - self.height) / 2;
            width: 7px; height: 7px; border-radius: 3.5px;
            background: root.state == "running" ? (M3.dark ? #6ccb5f : #107c10) : transparent;
            border-width: root.state == "running" ? 0px : 1.5px;
            border-color: root.state == "starting" ? (M3.dark ? #e8b339 : #9a6700) : root.state == "error" ? M3.error : root.on-container.with-alpha(0.6);
        }
        if root.state != "": Text {
            x: 34px;
            y: root.top + root.lines.length * root.line-h;
            width: root.node-width - 48px;
            text: root.state-text;
            font-size: 12px * Type.scale;
            color: root.state == "running" ? (M3.dark ? #6ccb5f : #107c10) : root.state == "starting" ? (M3.dark ? #e8b339 : #9a6700)
                : root.state == "error" ? M3.error : root.on-container.with-alpha(0.6);
            overflow: elide;
        }
        if root.shows-rate: Text {
            x: 20px;
            y: root.top + (root.line-count - 1) * root.line-h;
            text: root.rate != "" ? root.rate : "0 B/s";
            font-size: 11px * Type.scale;
            font-family: Type.mono;
            font-weight: 600;
            color: root.on-container;
            opacity: root.rate != "" ? 1 : 0.4;
            animate opacity { duration: Motion.fast-effects; }
        }
        if root.state != "": HorizontalLayout {
            x: 16px;
            y: root.chips-top;
            width: root.node-width - 32px;
            height: 32px;
            spacing: 6px;
            NodeChip {
                text: CanvasText.run;
                on: root.state == "running" || root.state == "starting";
                fg: root.on-container;
                clicked => { root.toggle(); }
            }
            NodeChip {
                text: CanvasText.at-start;
                on: root.autostart;
                fg: root.on-container;
                clicked => { root.set-flag("autostart", !root.autostart); }
            }
            NodeChip {
                text: CanvasText.auto-restart;
                on: root.auto-restart;
                fg: root.on-container;
                clicked => { root.set-flag("auto_restart", !root.auto-restart); }
            }
        }
        if root.has-switch: HorizontalLayout {
            x: 16px;
            y: root.chips-top;
            width: root.node-width - 32px;
            height: 32px;
            spacing: 6px;
            NodeChip {
                horizontal-stretch: 1;
                text: CanvasText.switched-on;
                on: root.switch-on;
                fill: #3fa34d;
                fg: root.on-container;
                clicked => { root.set-switch(true); }
            }
            NodeChip {
                horizontal-stretch: 1;
                text: CanvasText.switched-off;
                on: !root.switch-on;
                fill: #c9463f;
                fg: root.on-container;
                clicked => { root.set-switch(false); }
            }
        }
        if root.rows > 0: Rectangle {
            x: 12px;
            y: root.ports-top - 5px;
            width: parent.width - 24px;
            height: 1px;
            background: root.on-container.with-alpha(0.15);
        }
        // the block's colour (Python's swatch): click for the palette; a ring when it only follows what comes in
        if root.kind <= 2: Rectangle {
            x: root.node-width - (root.state != "" ? 76px : 44px) - 28px; y: 12px;
            width: 24px; height: 24px; border-radius: 12px;
            background: swatch-ta.has-hover ? root.on-container.with-alpha(0.14) : transparent;
            Rectangle {
                width: 14px; height: 14px; border-radius: 7px;
                background: root.own-color ? root.swatch : transparent;
                border-width: root.own-color ? 1px : 3px;
                border-color: root.own-color ? root.on-container.with-alpha(0.4) : root.swatch;
            }
            swatch-ta := TouchArea {
                clicked => { root.pick-color("", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
            }
        }
        // a wireless half's pair number: click to change it (Python: double-click the number)
        if root.kind == 3 && root.detail != "" && root.ins + root.outs <= 1: Rectangle {
            x: root.node-width - 44px - self.width - 6px;
            y: 12px;
            width: num-text.preferred-width + 20px;
            height: 24px;
            border-radius: 12px;
            background: num-ta.has-hover ? root.on-container.with-alpha(0.22) : root.on-container.with-alpha(0.12);
            num-text := Text {
                text: root.detail;
                font-size: 12px * Type.scale;
                font-weight: 700;
                color: root.on-container;
            }
            num-ta := TouchArea { clicked => { root.edit-number(); } }
        }
        // the editor (blocks that have settings: all but the PC block)
        if root.kind <= 3: Rectangle {
            x: root.node-width - (root.state != "" ? 76px : 44px); y: 8px;
            width: 32px; height: 32px; border-radius: 16px;
            background: edit-ta.has-hover ? root.on-container.with-alpha(0.14) : transparent;
            Image {
                width: 18px;
                height: 18px;
                source: @image-url("icons/edit.svg");
                colorize: root.on-container;
            }
            edit-ta := TouchArea { clicked => { root.edit(); } }
        }
        // a pass-through: fold the box to a small block / open it again
        if root.relay: Rectangle {
            x: root.node-width - 76px; y: 8px;
            width: 32px; height: 32px; border-radius: 16px;
            background: fold-ta.has-hover ? root.on-container.with-alpha(0.14) : transparent;
            Image {
                width: 20px;
                height: 20px;
                source: root.open ? @image-url("icons/unfold_less.svg") : @image-url("icons/unfold_more.svg");
                colorize: root.on-container;
            }
            fold-ta := TouchArea { clicked => { root.menu-action(root.open ? "relay.fold" : "relay.open"); } }
        }
        // a collapsed group's stand-in: expand it again (its members come back where they were)
        if root.kind == 5: Rectangle {
            x: root.node-width - 44px; y: 8px;
            width: 32px; height: 32px; border-radius: 16px;
            background: expand-ta.has-hover ? root.on-container.with-alpha(0.14) : transparent;
            Image {
                width: 20px;
                height: 20px;
                source: @image-url("icons/unfold_more.svg");
                colorize: root.on-container;
            }
            expand-ta := TouchArea { clicked => { root.edit(); } }
        }
        // a card: run / stop in the corner
        if root.state != "": Rectangle {
            x: root.node-width - 44px; y: 8px;
            width: 32px; height: 32px; border-radius: 16px;
            background: run-ta.has-hover ? root.on-container.with-alpha(0.14) : transparent;
            Image {
                width: 20px;
                height: 20px;
                source: root.state == "running" || root.state == "starting" ? @image-url("icons/stop_circle.svg") : @image-url("icons/play_arrow.svg");
                colorize: root.on-container;
            }
            run-ta := TouchArea { clicked => { root.toggle(); } }
        }
    }

    // pass-through: the wiring inside the block
    for w in root.lanes && root.kind == 3 ? root.wires : []: Path {
        x: 0; y: 0;
        width: root.node-width;
        height: root.node-height;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: root.node-width / 1px;
        viewbox-height: root.node-height / 1px;
        stroke: root.on-container.with-alpha(0.6);
        stroke-width: 2px;
        MoveTo { x: root.inset / 1px; y: root.lane-y(w.i) / 1px; }
        CubicTo {
            control-1-x: root.node-width / 2px; control-1-y: root.lane-y(w.i) / 1px;
            control-2-x: root.node-width / 2px; control-2-y: root.lane-y(w.o) / 1px;
            x: (root.node-width - root.inset) / 1px; y: root.lane-y(w.o) / 1px;
        }
    }

    // a pass-through's inner dots: drag from one to a dot on the other side to wire the lanes inside the block,
    // from an input dot to nowhere to leave that input unwired (Python RelayItem)
    property <int> drag-side;    // 0 none, 1 from an input dot, 2 from an output dot
    property <int> drag-k;
    property <length> drag-x;
    property <length> drag-y;
    pure function lane-at(y: length, count: int) -> int {
        return y < root.ports-top || y >= root.ports-top + count * root.lane-h ? -1 : floor((y - root.ports-top) / root.lane-h);
    }
    function drop-wire(x: length, y: length) {
        if root.drag-side == 1 {
            if abs(x - (root.node-width - root.inset)) < 24px && root.lane-at(y, root.outs) >= 0 {
                root.menu-action("lane.wire." + root.drag-k + "." + root.lane-at(y, root.outs));
            } else if abs(x - root.inset) > 24px || root.lane-at(y, root.ins) != root.drag-k {
                root.menu-action("lane.wire." + root.drag-k + ".-1");
            }
        } else if root.drag-side == 2 && abs(x - root.inset) < 24px && root.lane-at(y, root.ins) >= 0 {
            root.menu-action("lane.wire." + root.lane-at(y, root.ins) + "." + root.drag-k);
        }
        root.drag-side = 0;
    }
    if root.lane-edit && root.drag-side != 0: Path {
        x: 0; y: 0;
        width: root.node-width;
        height: root.node-height;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: root.node-width / 1px;
        viewbox-height: root.node-height / 1px;
        stroke: M3.dark ? #6ccb5f : #107c10;
        stroke-width: 2px;
        MoveTo {
            x: (root.drag-side == 1 ? root.inset : root.node-width - root.inset) / 1px;
            y: root.lane-y(root.drag-k) / 1px;
        }
        LineTo { x: root.drag-x / 1px; y: root.drag-y / 1px; }
    }
    for i in root.lane-edit ? root.ins : 0: Rectangle {
        x: root.inset - 5px;
        y: root.lane-y(i) - 5px;
        width: 10px; height: 10px; border-radius: 5px;
        background: root.container;
        border-width: 2px;
        border-color: root.on-container.with-alpha(0.7);
    }
    for o in root.lane-edit ? root.outs : 0: Rectangle {
        x: root.node-width - root.inset - 5px;
        y: root.lane-y(o) - 5px;
        width: 10px; height: 10px; border-radius: 5px;
        background: root.container;
        border-width: 2px;
        border-color: root.on-container.with-alpha(0.7);
    }
    for side in root.lane-edit ? 2 : 0: TouchArea {
        x: (side == 0 ? root.inset : root.node-width - root.inset) - 14px;
        y: root.ports-top;
        width: 28px;
        height: (side == 0 ? root.ins : root.outs) * root.lane-h;
        mouse-cursor: crosshair;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.drag-side = side + 1;
                root.drag-k = root.lane-at(self.y + self.mouse-y, side == 0 ? root.ins : root.outs);
                root.drag-x = self.x + self.mouse-x;
                root.drag-y = self.y + self.mouse-y;
                if root.drag-k < 0 { root.drag-side = 0; }
            } else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag-side != 0 {
                root.drop-wire(self.x + self.mouse-x, self.y + self.mouse-y);
            }
        }
        moved => {
            root.drag-x = self.x + self.mouse-x;
            root.drag-y = self.y + self.mouse-y;
        }
    }
    // "+ Add a lane" under the lanes (Python's footer); a freely wired block: "+ Input" and "+ Output" (its two
    // sides grow apart, as in the editor)
    for btn[k] in root.lane-edit ? (root.routed ? 2 : 1) : 0: Rectangle {
        property <length> w: (root.node-width - 24px - (root.routed ? 8px : 0px)) / (root.routed ? 2 : 1);
        x: 12px + k * (self.w + 8px);
        y: root.ports-top - root.head-h - 2px;
        width: self.w;
        height: 28px;
        border-radius: 14px;
        background: add-ta.pressed ? root.on-container.with-alpha(0.16) : add-ta.has-hover ? root.on-container.with-alpha(0.12) : root.on-container.with-alpha(0.06);
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            Image {
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                source: @image-url("icons/add.svg");
                colorize: root.on-container;
            }
            Text {
                text: !root.routed ? CanvasText.add-lane : k == 0 ? CanvasText.add-input : CanvasText.add-output;
                font-size: 12px * Type.scale;
                font-weight: 500;
                color: root.on-container;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        add-ta := TouchArea { clicked => { root.menu-action(k == 0 ? "lane.add.inputs" : "lane.add.outputs"); } }
    }

    // an open pass-through: each lane's name on a chip (double-click to rename it)
    for label[i] in root.box ? root.in-labels : []: LaneChip {
        x: 14px;
        y: root.lane-y(i) - self.height / 2;
        width: root.inset - 30px;
        text: label;
        fg: root.on-container;
        renamed => { root.menu-action("lane.rename.inputs." + i); }
    }
    for label[o] in root.box ? root.out-labels : []: LaneChip {
        x: root.node-width - root.inset + 16px;
        y: root.lane-y(o) - self.height / 2;
        width: root.inset - 30px;
        text: label;
        right: true;
        fg: root.on-container;
        renamed => { root.menu-action("lane.rename.outputs." + o); }
    }
    // each port's name, small, inside the block next to its dot (M3 Label Small)
    for label[i] in root.box ? [] : root.in-labels: Text {
        x: 16px;
        y: root.lane-y(i) - self.height / 2;
        width: root.node-width / 2 - 20px;
        text: label;
        font-size: 11px * Type.scale;
        font-weight: 500;
        color: root.on-container.with-alpha(0.75);
        overflow: elide;
    }
    for c[o] in root.kind == 1 ? root.out-colors : []: Rectangle {
        x: root.node-width - 38px;
        y: root.lane-y(o) - 12px;
        width: 24px; height: 24px; border-radius: 12px;
        background: out-ta.has-hover ? root.on-container.with-alpha(0.14) : transparent;
        out-label-w := Text {
            visible: false;
            text: root.out-labels[o];
            font-size: 11px * Type.scale;
            font-weight: 500;
        }
        Rectangle {
            width: 10px; height: 10px; border-radius: 5px;
            background: c.own ? c.color : transparent;
            border-width: c.own ? 0px : 2px;
            border-color: c.color;
        }
        out-ta := TouchArea {
            clicked => { root.pick-color(c.key, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        }
    }
    // (a Router's colour dot sits right of its name, next to the port)
    for label[o] in root.box ? [] : root.out-labels: Text {
        x: root.node-width / 2 + 4px;
        y: root.lane-y(o) - self.height / 2;
        width: root.node-width / 2 - (root.kind == 1 ? 42px : 20px);
        horizontal-alignment: right;
        text: label;
        font-size: 11px * Type.scale;
        font-weight: 500;
        color: root.on-container.with-alpha(0.75);
        overflow: elide;
    }

    for i in root.ins: Pin {
        x: -self.width / 2;
        y: root.lane-y(i) - self.height / 2;
        pin-id: root.node-id * 64 + i * 2;
        node-id: root.node-id;
        pin-type: PinTypes.input;
        node-screen-x: root.screen-x;
        node-screen-y: root.screen-y;
    }
    for o in root.outs: Pin {
        x: root.node-width - self.width / 2;
        y: root.lane-y(o) - self.height / 2;
        pin-id: root.node-id * 64 + o * 2 + 1;
        node-id: root.node-id;
        pin-type: PinTypes.output;
        node-screen-x: root.screen-x;
        node-screen-y: root.screen-y;
    }
    // the right-click menu (Run / Stop follows the card's live state)
    ContextMenuArea {
        x: 0;
        y: 0;
        width: root.node-width;
        height: root.node-height;
        Menu {
            for e in root.menu: MenuItem {
                title: e.action == "toggle" ? (root.state == "running" || root.state == "starting" ? CanvasText.stop : CanvasText.run) : e.title;
                activated => { root.menu-action(e.action); }
            }
            if root.menu-sub-title != "": Menu {
                title: root.menu-sub-title;
                for e in root.menu-sub: MenuItem {
                    checkable: e.checked;
                    checked: e.checked;
                    title: e.title;
                    activated => { root.menu-action(e.action); }
                }
            }
            if root.menu-cut: MenuSeparator {}
            if root.menu-cut: MenuItem {
                title: CanvasText.cut;
                activated => { root.menu-action("cut"); }
            }
            if root.menu-tail: MenuSeparator {}
            if root.menu-tail: MenuItem {
                title: CanvasText.duplicate;
                activated => { root.menu-action("duplicate"); }
            }
            if root.menu-tail: MenuItem {
                title: CanvasText.delete;
                activated => { root.menu-action("delete"); }
            }
        }
    }
}

component ToolbarButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    // no room: the icon alone
    in property <bool> compact;
    in property <bool> filled;
    in property <bool> enabled: true;
    callback clicked();
    // (48: the toolbar's 64 less its padding of 8 on every side, so the buttons sit in the middle)
    height: 48px;
    width: root.compact ? 48px : label.preferred-width + 60px;
    accessible-role: button;
    accessible-label: root.text;
    opacity: root.enabled ? 1 : 0.38;
    // pressed buttons square off, then spring back
    border-radius: ta.pressed ? 12px : 24px;
    background: filled ? M3.primary : ta.has-hover && root.enabled ? M3.on-surface.with-alpha(0.08) : transparent;
    animate border-radius { duration: Motion.fast-spatial; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
    Image {
        x: root.compact ? (parent.width - self.width) / 2 : 16px;
        width: 20px;
        height: 20px;
        source: root.icon;
        colorize: root.filled ? M3.on-primary : M3.on-surface;
    }
    label := Text {
        x: 44px;
        visible: !root.compact;
        text: root.text;
        font-size: 14px * Type.scale;
        font-weight: 600;
        color: root.filled ? M3.on-primary : M3.on-surface;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// --- the app's own fields: one height and one corner radius everywhere (the material style's differ) ---

global Field {
    out property <length> height: 40px;
    out property <length> radius: 12px;
}

// a one-line text box; long text scrolls to its end while it has focus
component AppLineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <bool> read-only;
    in property <InputType> input-type: InputType.text;
    in property <length> font-size: 14px * Type.scale;
    in property <string> font-family;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    public function select-all() { input.select-all(); }
    forward-focus: input;
    height: Field.height;
    min-width: 80px;
    border-radius: Field.radius;
    background: root.read-only ? transparent : M3.surface-container-high;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? M3.primary : M3.outline-variant;
    opacity: root.enabled ? 1 : 0.5;
    clip: true;
    Rectangle {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        clip: true;
        input := TextInput {
            property <length> room: parent.width;
            // the end stays in view while typing past the edge
            x: self.has-focus && self.preferred-width > self.room ? self.room - self.preferred-width : 0px;
            width: max(self.room, self.preferred-width + 2px);
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            text <=> root.text;
            enabled: root.enabled;
            read-only: root.read-only;
            input-type: root.input-type;
            font-size: root.font-size;
            font-family: root.font-family;
            color: M3.on-surface;
            selection-background-color: M3.primary.with-alpha(0.35);
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
        }
        if root.text == "" && !input.has-focus: Text {
            x: 0;
            width: parent.width;
            height: parent.height;
            text: root.placeholder-text;
            font-size: root.font-size;
            color: M3.on-surface-variant.with-alpha(0.7);
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Edge protection: where a scrolled area's content goes on past its top or bottom, it fades into the background
component EdgeFade inherits Rectangle {
    // the scroll view's viewport-y (0 or less), viewport-height and visible-height
    in property <length> offset;
    in property <length> content;
    in property <length> view;
    // the colour behind the content
    in property <color> fade-color;
    in property <length> size: 28px;
    Rectangle {
        y: 0;
        height: root.size;
        opacity: root.offset < -1px ? 1 : 0;
        animate opacity { duration: 150ms; }
        background: @linear-gradient(180deg, root.fade-color 0%, root.fade-color.with-alpha(0) 100%);
    }
    Rectangle {
        y: root.height - root.size;
        height: root.size;
        opacity: root.content + root.offset > root.view + 1px ? 1 : 0;
        animate opacity { duration: 150ms; }
        background: @linear-gradient(0deg, root.fade-color 0%, root.fade-color.with-alpha(0) 100%);
    }
}

// one entry of a drop-down list
component ComboItem inherits Rectangle {
    in property <string> text;
    // its own font ("" = the window's): a language's name in that language's font
    in property <string> font;
    in property <bool> current;
    callback picked();
    height: 44px;
    border-radius: 12px;
    background: root.current ? M3.secondary-container : item-ta.has-hover ? M3.on-surface.with-alpha(0.08) : transparent;
    Text {
        x: 14px;
        width: parent.width - 48px;
        text: root.text;
        font-size: 14px * Type.scale;
        font-family: root.font;
        color: root.current ? M3.on-secondary-container : M3.on-surface;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.current: Image {
        x: parent.width - 32px;
        width: 18px;
        height: 18px;
        source: @image-url("icons/check.svg");
        colorize: M3.on-secondary-container;
    }
    item-ta := TouchArea { clicked => { root.picked(); } }
}

// a drop-down list
component AppComboBox inherits Rectangle {
    in property <[string]> model;
    // a font per entry (optional)
    in property <[string]> fonts;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    callback selected(string);
    height: Field.height;
    min-width: 100px;
    border-radius: Field.radius;
    background: ta.has-hover && root.enabled ? M3.surface-container-highest : M3.surface-container-high;
    border-width: 1px;
    border-color: M3.outline-variant;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: combobox;
    accessible-value: root.model[root.current-index];
    Text {
        x: 14px;
        width: parent.width - 48px;
        text: root.model[root.current-index];
        font-size: 14px * Type.scale;
        font-family: root.current-index < root.fonts.length ? root.fonts[root.current-index] : "";
        color: M3.on-surface;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: parent.width - 34px;
        width: 20px;
        height: 20px;
        source: @image-url("icons/expand_more.svg");
        colorize: M3.on-surface-variant;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.width;
        // (Slint keeps it in the window, moved up if need be: no taller than the window, a longer list scrolls)
        height: min(self.full, 380px, Palette.window-height - 16px);
        property <length> full: root.model.length * 44px + 16px;
        property <bool> scrolls: self.full > self.height + 0.5px;
        Rectangle {
            border-radius: 16px;
            background: M3.surface-container-highest;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000059;
            // a short list as it is, a long one scrolls
            if !popup.scrolls: VerticalLayout {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: root.model.length * 44px;
                alignment: start;
                for item[i] in root.model: ComboItem {
                    text: item;
                    font: i < root.fonts.length ? root.fonts[i] : "";
                    current: i == root.current-index;
                    picked => {
                        root.current-index = i;
                        root.selected(item);
                    }
                }
            }
            if popup.scrolls: Rectangle {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                combo-list := ListView {
                    for item[i] in root.model: ComboItem {
                        text: item;
                        font: i < root.fonts.length ? root.fonts[i] : "";
                        current: i == root.current-index;
                        picked => {
                            root.current-index = i;
                            root.selected(item);
                        }
                    }
                }
                EdgeFade {
                    // (not over the scroll bar)
                    x: 0;
                    width: parent.width - 14px;
                    offset: combo-list.content-y;
                    content: combo-list.content-height;
                    view: combo-list.visible-height;
                    fade-color: M3.surface-container-highest;
                }
            }
        }
    }
}

// a number with − and + (typed numbers are kept within minimum..maximum)
component AppSpinBox inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <bool> enabled: true;
    height: Field.height;
    border-radius: Field.radius;
    background: M3.surface-container-high;
    border-width: num.has-focus ? 2px : 1px;
    border-color: num.has-focus ? M3.primary : M3.outline-variant;
    opacity: root.enabled ? 1 : 0.5;
    function set(v: int) {
        root.value = max(root.minimum, min(root.maximum, v));
        num.text = root.value;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 4px;
        spacing: 2px;
        num := TextInput {
            horizontal-stretch: 1;
            vertical-alignment: center;
            input-type: InputType.number;
            text: root.value;
            font-size: 14px * Type.scale;
            color: M3.on-surface;
            enabled: root.enabled;
            edited => {
                if self.text.is-float() {
                    root.value = max(root.minimum, min(root.maximum, self.text.to-float()));
                }
            }
            accepted => { root.set(self.text.is-float() ? self.text.to-float() : root.value); }
        }
        for step[i] in [-1, 1]: Rectangle {
            width: 32px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: step-ta.has-hover && root.enabled ? M3.on-surface.with-alpha(0.10) : transparent;
            Image {
                width: 18px;
                height: 18px;
                source: step < 0 ? @image-url("icons/remove.svg") : @image-url("icons/add.svg");
                colorize: M3.on-surface;
            }
            step-ta := TouchArea {
                enabled: root.enabled;
                clicked => { root.set(root.value + step); }
            }
        }
    }
}

// One field of the editor on its card (the settings' look): its name and what it does on the left,
// its control on the right; a heading is the small coloured title of the group of cards under it.
// M3 Expressive small button: 40 high, 16 at the sides, a 20 px icon, Label Large; round, squarer while pressed.
// primary: filled (primary), else tonal (secondary container)
component AppButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    // only the icon (the text stays the accessible name)
    in property <bool> icon-only;
    // (the icons are always drawn in the label's colour)
    in property <bool> colorize-icon: true;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    property <color> fg: !root.enabled ? M3.on-surface.with-alpha(0.38) : root.primary ? M3.on-primary : M3.on-secondary-container;
    height: 40px;
    preferred-width: lay.preferred-width;
    // (a button's text is never cut short)
    min-width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: ta.pressed && root.enabled ? 8px : 20px;
    animate border-radius { duration: Motion.fast-spatial; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
    background: !root.enabled ? M3.on-surface.with-alpha(0.12) : root.primary ? M3.primary : M3.secondary-container;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    // state layer
    Rectangle {
        border-radius: parent.border-radius;
        background: !root.enabled ? transparent : ta.pressed ? root.fg.with-alpha(0.10) : ta.has-hover ? root.fg.with-alpha(0.08) : transparent;
    }
    lay := HorizontalLayout {
        padding-left: root.icon-only ? 10px : 16px;
        padding-right: root.icon-only ? 10px : 16px;
        spacing: 8px;
        alignment: center;
        if root.icon.width > 0: Image {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.fg;
        }
        if root.text != "" && !(root.icon-only && root.icon.width > 0): Text {
            text: root.text;
            font-size: 14px * Type.scale;
            font-weight: 500;
            color: root.fg;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// M3 switch: a 52x32 track, the thumb grows when on
component AppSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: root.checked ? M3.primary : M3.surface-container-highest;
    border-width: root.checked ? 0px : 2px;
    border-color: M3.on-surface-variant;
    opacity: root.enabled ? 1 : 0.38;
    animate background { duration: 150ms; }
    accessible-role: switch;
    accessible-checked: root.checked;
    accessible-action-default => { ta.clicked(); }
    Rectangle {
        property <length> d: ta.pressed ? 28px : root.checked ? 24px : 16px;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        x: (root.checked ? 36px : 16px) - self.d / 2;
        y: (root.height - self.d) / 2;
        background: root.checked ? M3.on-primary : M3.on-surface-variant;
        animate x, width, height { duration: 150ms; easing: ease-out; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// One field of the editor on its card, the M3 list way: the name and what it does on the left and a small
// control on the right (switch, menu, number, button); a field that needs the width (text, a key) goes under
// the name, its description under it. A row continuing the one above (a second box) is all field.
// A heading is the small coloured title of the group of cards under it.
component FormRow inherits Rectangle {
    in property <FieldRow> f;
    callback changed(string, string);
    // a button (index -1) or an item's button n
    callback pressed(string, int);
    property <bool> heading: f.kind == "heading";
    // a small control on the right of the name
    property <bool> inline: !f.joined && (f.kind == "bool" || f.kind == "choice" || f.kind == "int" || f.kind == "button" || f.kind == "item");
    property <length> top-r: f.joined ? 0px : f.first ? 28px : 4px;
    property <length> bottom-r: f.held ? 0px : f.last ? 28px : 4px;
    property <color> desc-color: f.tone == 1 ? #1e7f3c : f.tone == 2 ? M3.error : M3.on-surface-variant;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding-top: root.heading ? (f.first ? 4px : 20px) : (f.first || f.joined ? 0px : 2px);
        padding-bottom: root.heading ? 8px : 0px;
        if root.heading: HorizontalLayout {
            padding-left: 20px;
            Text {
                text: f.label;
                font-size: 14px * Type.scale;
                font-weight: 500;
                color: M3.primary;
                wrap: word-wrap;
            }
        }
        if !root.heading: Rectangle {
            background: M3.surface-container-low;
            border-top-left-radius: root.top-r;
            border-top-right-radius: root.top-r;
            border-bottom-left-radius: root.bottom-r;
            border-bottom-right-radius: root.bottom-r;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                // (a row and the one continuing it: 8 px between them on the shared card)
                padding-top: f.joined ? 4px : 16px;
                padding-bottom: f.held ? 4px : 16px;
                spacing: 8px;
                // the name (and what it does) on the left, a small control on the right
                if root.inline: HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        alignment: center;
                        if f.kind != "button" && f.label != "": Text {
                            text: f.label;
                            font-size: 16px * Type.scale;
                            color: M3.on-surface;
                            wrap: word-wrap;
                        }
                        // an item: its text under its name
                        if f.kind == "item" && f.text != "": Text {
                            text: f.text;
                            font-size: 13px * Type.scale;
                            font-family: Type.mono;
                            color: M3.on-surface-variant;
                            wrap: char-wrap;
                        }
                        if f.desc != "": Text {
                            text: f.desc;
                            font-size: 14px * Type.scale;
                            color: root.desc-color;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                      alignment: center;
                      HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        if f.kind == "bool": AppSwitch {
                            y: (parent.height - self.height) / 2;
                            checked: f.checked;
                            toggled => { root.changed(f.key, self.checked ? "true" : "false"); }
                        }
                        if f.kind == "choice": AppComboBox {
                            width: 280px;
                            model: f.options;
                            current-index: f.index;
                            selected => { root.changed(f.key, self.current-index); }
                        }
                        if f.kind == "int": AppLineEdit {
                            width: 160px;
                            text: f.text;
                            input-type: InputType.number;
                            edited(t) => { root.changed(f.key, t); }
                        }
                        if f.kind == "button": AppButton {
                            text: f.label;
                            enabled: !f.busy;
                            clicked => { root.pressed(f.key, -1); }
                        }
                        // an item's buttons, or the buttons that belong to this field (Browse, Refresh, Add...)
                        for b[i] in f.buttons: AppButton {
                            text: b;
                            icon: f.button-icons[i] == "up" ? @image-url("icons/arrow_upward.svg")
                                : f.button-icons[i] == "down" ? @image-url("icons/arrow_downward.svg") : @image-url("");
                            icon-only: f.button-icons[i] != "";
                            clicked => { root.pressed(f.key, i); }
                        }
                      }
                    }
                }
                // a field that needs the width: the name, the field, then what it does
                if !root.inline && f.label != "" && f.kind != "button": Text {
                    text: f.label;
                    font-size: 16px * Type.scale;
                    color: M3.on-surface;
                    wrap: word-wrap;
                }
                if !root.inline && f.desc != "": Text {
                    text: f.desc;
                    font-size: 14px * Type.scale;
                    color: root.desc-color;
                    wrap: word-wrap;
                }
                if !root.inline && f.kind == "info": AppLineEdit {
                    text: f.text;
                    read-only: true;
                    font-size: 12px * Type.scale;
                    font-family: Type.mono;
                }
                if !root.inline && (f.kind == "text" || f.kind == "secret" || f.kind == "int"): HorizontalLayout {
                    spacing: 8px;
                    AppLineEdit {
                        horizontal-stretch: 1;
                        text: f.text;
                        input-type: f.kind == "secret" ? InputType.password : f.kind == "int" ? InputType.number : InputType.text;
                        edited(t) => { root.changed(f.key, t); }
                    }
                    for b[i] in f.buttons: AppButton {
                        text: b;
                        clicked => { root.pressed(f.key, i); }
                    }
                }
                if !root.inline && f.kind == "choice": AppComboBox {
                    model: f.options;
                    current-index: f.index;
                    selected => { root.changed(f.key, self.current-index); }
                }
                if !root.inline && f.kind == "bool": HorizontalLayout {
                    alignment: end;
                    AppSwitch {
                        checked: f.checked;
                        toggled => { root.changed(f.key, self.checked ? "true" : "false"); }
                    }
                }
                if !root.inline && f.kind == "button": HorizontalLayout {
                    alignment: end;
                    AppButton {
                        text: f.label;
                        enabled: !f.busy;
                        clicked => { root.pressed(f.key, -1); }
                    }
                }
                if !root.inline && f.kind == "item": HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: f.text;
                        color: M3.on-surface-variant;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        font-family: Type.mono;
                    }
                    for b[i] in f.buttons: AppButton {
                        text: b;
                        clicked => { root.pressed(f.key, i); }
                    }
                }
            }
        }
    }
}

// the theme picker's cards: a preview of the app in that theme (system: half light, half dark) and its name
component ThemeCard inherits Rectangle {
    in property <string> label;
    // 0 the system's, 1 light, 2 dark
    in property <int> kind;
    in property <bool> selected;
    callback clicked();
    height: card-lay.preferred-height;
    // the three the same width
    preferred-width: 120px;
    min-width: 96px;
    horizontal-stretch: 1;
    border-radius: 24px;
    border-width: root.selected ? 3px : 1px;
    border-color: root.selected ? M3.primary : M3.outline-variant;
    background: ta.has-hover ? M3.on-surface.with-alpha(0.04) : transparent;
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    card-lay := VerticalLayout {
        padding: 10px;
        spacing: 8px;
        preview := Rectangle {
            height: 84px;
            border-radius: 16px;
            clip: true;
            background: root.kind == 2 ? M3.d-surface-container : M3.l-surface-container;
            // the system's: the right half dark
            if root.kind == 0: Rectangle {
                x: parent.width / 2;
                width: parent.width / 2;
                background: M3.d-surface-container;
            }
            for bar[i] in [{ y: 16px, w: 0.70, accent: true }, { y: 38px, w: 0.45, accent: false }, { y: 58px, w: 0.55, accent: false }]: Rectangle {
                x: 14px;
                y: bar.y;
                width: (parent.width - 28px) * bar.w;
                height: bar.accent ? 14px : 10px;
                border-radius: self.height / 2;
                clip: true;
                // light colours on the left, dark on the right (system: split in the middle of the card)
                property <color> light: bar.accent ? M3.l-primary : M3.l-outline-variant;
                property <color> dark: bar.accent ? M3.d-primary : M3.d-outline-variant;
                background: root.kind == 2 ? self.dark : self.light;
                if root.kind == 0: Rectangle {
                    x: preview.width / 2 - parent.x;
                    width: max(0px, parent.width - self.x);
                    background: parent.dark;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            padding-bottom: 2px;
            if root.selected: Image {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                source: @image-url("icons/check.svg");
                colorize: M3.primary;
            }
            Text {
                text: root.label;
                font-size: 14px * Type.scale;
                font-weight: root.selected ? 600 : 500;
                color: M3.on-surface;
                vertical-alignment: center;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// the page's buttons beside its title: the proxies' "stop all", the editor's cancel and save
component PageActions inherits HorizontalLayout {
    in property <int> page;
    // in the merged title bar (Windows 11 / macOS): icon buttons
    in property <bool> icon-only;
    in property <bool> has-cards;
    in property <string> t-stop-all;
    in property <string> t-cancel;
    in property <string> t-save;
    callback stop-all();
    callback cancel();
    callback save();
    in property <string> t-new-proxy;
    in property <string> t-new-outbound;
    callback add(string, string);
    in property <string> t-copy-log;
    in property <string> t-clear-log;
    callback log-copy();
    callback log-clear();
    alignment: end;
    spacing: 8px;
    // the "add" buttons' menus (no width; first, so their spacing is not after the last button)
    router-menu := ContextMenuArea {
        width: 0;
        Menu {
            MenuItem {
                title: CanvasText.router;
                activated => { root.add("router", ""); }
            }
            MenuItem {
                title: CanvasText.if-block;
                activated => { root.add("if", ""); }
            }
        }
    }
    out-menu := ContextMenuArea {
        width: 0;
        Menu {
            for t in CanvasText.outbounds: MenuItem {
                title: t.title;
                activated => { root.add("outbound", t.action); }
            }
        }
    }
    proxy-menu := ContextMenuArea {
        width: 0;
        Menu {
            for t in CanvasText.templates: MenuItem {
                title: t.title;
                activated => { root.add("template", t.action); }
            }
        }
    }
    if root.page == 1 && root.has-cards: AppButton {
        text: root.t-stop-all;
        icon: root.icon-only ? @image-url("icons/stop_circle.svg") : @image-url("");
        icon-only: root.icon-only;
        clicked => { root.stop-all(); }
    }
    if root.page == 2: AppButton {
        text: root.t-clear-log;
        icon-only: root.icon-only;
        icon: @image-url("icons/delete.svg");
        clicked => { root.log-clear(); }
    }
    if root.page == 2: AppButton {
        text: root.t-copy-log;
        icon-only: root.icon-only;
        icon: @image-url("icons/content_copy.svg");
        clicked => { root.log-copy(); }
    }
    // the list page's "add" buttons open menus (Python's drop-down buttons)
    if root.page == 1: AppButton {
        text: CanvasText.add-router;
        icon-only: root.icon-only;
        icon: @image-url("icons/alt_route.svg");
        clicked => { router-menu.show({ x: self.absolute-position.x - router-menu.absolute-position.x, y: self.absolute-position.y - router-menu.absolute-position.y + self.height + 4px }); }
    }
    if root.page == 1: AppButton {
        text: root.t-new-outbound;
        icon-only: root.icon-only;
        icon: @image-url("icons/logout.svg");
        clicked => { out-menu.show({ x: self.absolute-position.x - out-menu.absolute-position.x, y: self.absolute-position.y - out-menu.absolute-position.y + self.height + 4px }); }
    }
    if root.page == 1: AppButton {
        text: root.t-new-proxy;
        icon-only: root.icon-only;
        icon: @image-url("icons/add.svg");
        primary: true;
        clicked => { proxy-menu.show({ x: self.absolute-position.x - proxy-menu.absolute-position.x + self.width - 420px, y: self.absolute-position.y - proxy-menu.absolute-position.y + self.height + 4px }); }
    }
    if root.page == 3: AppButton {
        text: root.t-cancel;
        icon: root.icon-only ? @image-url("icons/close.svg") : @image-url("");
        icon-only: root.icon-only;
        clicked => { root.cancel(); }
    }
    if root.page == 3: AppButton {
        text: root.t-save;
        icon: root.icon-only ? @image-url("icons/save.svg") : @image-url("");
        icon-only: root.icon-only;
        primary: true;
        clicked => { root.save(); }
    }
    if root.page == 5: AppComboBox {
        width: root.icon-only ? 200px : 240px;
        model: Stats.choices;
        current-index <=> Stats.choice;
        selected => { Stats.changed(); }
    }
    if root.page == 6: AppComboBox {
        width: root.icon-only ? 180px : 220px;
        model: Conn.proxies;
        current-index <=> Conn.proxy;
        enabled: Conn.proxies.length > 0;
        selected => { Conn.proxy-changed(); }
    }
    if root.page == 6: AppButton {
        min-width: root.icon-only ? 40px : 190px;
        icon-only: root.icon-only;
        text: Conn.button;
        icon: @image-url("icons/network_check.svg");
        colorize-icon: true;
        primary: true;
        enabled: Conn.button-enabled;
        clicked => { Conn.start(); }
    }
}

// a settings category (or a group's name) in the list left of the settings
export struct SettingsCat { label: string, icon: image, page: int, cat: int, header: bool, show: bool }

component CatItem inherits Rectangle {
    in property <SettingsCat> item;
    // only the icon (a narrow window); the groups' names go
    in property <bool> compact;
    in property <bool> active;
    callback clicked;
    visible: root.item.show && !(root.item.header && root.compact);
    height: !self.visible ? 0px : root.item.header ? 36px : 40px;
    border-radius: 20px;
    background: root.item.header ? transparent : root.active ? M3.secondary-container : ta.has-hover ? M3.surface-container-high : transparent;
    animate background { duration: Motion.fast-effects; }
    accessible-role: button;
    accessible-label: root.item.label;
    if root.item.header: Text {
        x: 16px;
        y: parent.height - self.height - 6px;
        width: parent.width - 16px;
        text: root.item.label;
        font-size: 13px * Type.scale;
        font-weight: 600;
        color: M3.on-surface-variant;
        overflow: elide;
    }
    if !root.item.header: HorizontalLayout {
        padding-left: root.compact ? 0px : 16px;
        padding-right: root.compact ? 0px : 12px;
        alignment: root.compact ? center : start;
        spacing: 12px;
        Image {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            source: root.item.icon;
            colorize: root.active ? M3.on-secondary-container : M3.on-surface-variant;
        }
        if !root.compact: Text {
            text: root.item.label;
            font-size: 14px * Type.scale;
            font-weight: root.active ? 600 : 500;
            color: root.active ? M3.on-secondary-container : M3.on-surface;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        enabled: !root.item.header;
        clicked => { root.clicked(); }
    }
}

component RailItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 64px;
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 32px;
                border-radius: 16px;
                background: root.active ? M3.secondary-container : (ta.has-hover ? M3.surface-container-high : transparent);
                animate background { duration: Motion.fast-effects; }
                Image {
                    width: 24px;
                    height: 24px;
                    source: root.icon;
                    colorize: root.active ? M3.on-secondary-container : M3.on-surface-variant;
                }
            }
        }
        Text {
            text: root.label;
            font-size: 12px * Type.scale;
            font-weight: root.active ? 700 : 500;
            color: root.active ? M3.on-surface : M3.on-surface-variant;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <string> state;
    height: 28px;
    border-radius: 14px;
    background: state == "running" ? M3.green-container : state == "starting" ? M3.amber-container
        : state == "error" ? M3.error-container : M3.surface-container-high;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            font-size: 13px * Type.scale;
            font-weight: 600;
            vertical-alignment: center;
            color: state == "running" ? M3.on-green-container : state == "starting" ? M3.on-amber-container
                : state == "error" ? M3.on-error-container : M3.on-surface-variant;
        }
    }
}

component Card inherits Rectangle {
    in property <CardRow> card;
    in property <string> t-copy;
    // a narrow list: no state chip, Run / Stop as an icon
    in property <bool> narrow;
    callback toggle(string);
    callback edit(string);
    // the card's address / link for client apps, to the clipboard
    callback copy(string);
    // an entry of the ⋯ menu
    callback menu-action(string, string);
    border-radius: 20px;
    background: open-ta.has-hover ? M3.surface-container : M3.surface-container-low;
    animate background { duration: Motion.fast-effects; }
    // the card itself opens the editor (Python: a click on the card)
    open-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.edit(root.card.id); }
    }
    HorizontalLayout {
        padding: 16px;
        padding-left: 20px;
        spacing: 16px;
        VerticalLayout {
            spacing: 4px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: card.name;
                font-size: 16px * Type.scale;
                font-weight: 500;
                color: M3.on-surface;
                overflow: elide;
            }
            Text {
                text: card.summary;
                font-size: 14px * Type.scale;
                color: M3.on-surface-variant;
                overflow: elide;
            }
            if card.error != "": Text {
                text: card.error;
                font-size: 13px * Type.scale;
                color: M3.error;
                wrap: word-wrap;
            }
            if card.traffic != "": Text {
                text: card.traffic;
                font-size: 12px * Type.scale;
                font-family: Type.mono;
                color: M3.on-surface-variant;
            }
        }
        if !root.narrow: VerticalLayout {
            alignment: center;
            Chip { text: card.state-text; state: card.state; }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                AppButton {
                    icon: @image-url("icons/content_copy.svg");
                    colorize-icon: true;
                    accessible-label: root.t-copy;
                    clicked => { root.copy(card.id); }
                }
            }
            VerticalLayout {
                alignment: center;
                AppButton {
                    icon: @image-url("icons/more_vert.svg");
                    colorize-icon: true;
                    clicked => { card-more.show({ x: self.absolute-position.x - card-more.absolute-position.x, y: self.absolute-position.y - card-more.absolute-position.y + self.height + 4px }); }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            AppButton {
                text: card.action;
                icon: !root.narrow ? @image-url("") : card.state == "running" || card.state == "starting"
                    ? @image-url("icons/stop_circle.svg") : @image-url("icons/play_arrow.svg");
                icon-only: root.narrow;
                primary: card.state != "running" && card.state != "starting";
                clicked => { root.toggle(card.id); }
            }
        }
    }
    // the ⋯ menu: the block's own right-click menu (edit::block_menu)
    card-more := ContextMenuArea {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        Menu {
            for e in root.card.menu: MenuItem {
                title: e.action == "toggle" ? ((root.card.state == "running" || root.card.state == "starting") ? CanvasText.stop : CanvasText.run) : e.title;
                activated => { root.menu-action(root.card.id, e.action); }
            }
            if root.card.menu-sub-title != "": Menu {
                title: root.card.menu-sub-title;
                for e in root.card.menu-sub: MenuItem {
                    checkable: e.checked;
                    checked: e.checked;
                    title: e.title;
                    activated => { root.menu-action(root.card.id, e.action); }
                }
            }
            if root.card.menu-cut: MenuSeparator {}
            if root.card.menu-cut: MenuItem {
                title: CanvasText.cut;
                activated => { root.menu-action(root.card.id, "cut"); }
            }
            if root.card.menu-tail: MenuSeparator {}
            if root.card.menu-tail: MenuItem {
                title: CanvasText.duplicate;
                activated => { root.menu-action(root.card.id, "duplicate"); }
            }
            if root.card.menu-tail: MenuItem {
                title: CanvasText.delete;
                activated => { root.menu-action(root.card.id, "delete"); }
            }
        }
    }
}

// a section's title on the list page (M3 Title Small, primary)
component ListTitle inherits HorizontalLayout {
    in property <string> text;
    in property <bool> first;
    padding-left: 20px;
    padding-top: root.first ? 4px : 20px;
    padding-bottom: 4px;
    Text {
        text: root.text;
        font-size: 14px * Type.scale;
        font-weight: 500;
        color: M3.primary;
    }
}

// An outbound block, a router / IF or the PC block on the list page: name, what it is, an IF's switch, ⋯ menu
component BlockCard inherits Rectangle {
    in property <BlockRow> block;
    callback open(string);
    callback switched(string, bool);
    callback menu-action(string, string);
    property <bool> running: false;
    border-radius: 20px;
    background: open-ta.has-hover ? M3.surface-container : M3.surface-container-low;
    animate background { duration: Motion.fast-effects; }
    min-height: 72px;
    open-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { if root.block.kind != 4 { root.open(root.block.key); } }
    }
    HorizontalLayout {
        padding: 16px;
        padding-left: 20px;
        spacing: 16px;
        VerticalLayout {
            spacing: 4px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.block.title;
                font-size: 16px * Type.scale;
                font-weight: 500;
                color: M3.on-surface;
                overflow: elide;
            }
            if root.block.detail != "": Text {
                text: root.block.detail;
                font-size: 14px * Type.scale;
                color: M3.on-surface-variant;
                overflow: elide;
            }
        }
        if root.block.has-switch: VerticalLayout {
            alignment: center;
            AppSwitch {
                checked: root.block.switch-on;
                toggled => { root.switched(root.block.key, self.checked); }
            }
        }
        VerticalLayout {
            alignment: center;
            AppButton {
                icon: @image-url("icons/more_vert.svg");
                colorize-icon: true;
                clicked => { block-more.show({ x: self.absolute-position.x - block-more.absolute-position.x, y: self.absolute-position.y - block-more.absolute-position.y + self.height + 4px }); }
            }
        }
    }
    // the ⋯ menu: the block's own right-click menu (edit::block_menu)
    block-more := ContextMenuArea {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        Menu {
            for e in root.block.menu: MenuItem {
                title: e.action == "toggle" ? (root.running ? CanvasText.stop : CanvasText.run) : e.title;
                activated => { root.menu-action(root.block.key, e.action); }
            }
            if root.block.menu-sub-title != "": Menu {
                title: root.block.menu-sub-title;
                for e in root.block.menu-sub: MenuItem {
                    checkable: e.checked;
                    checked: e.checked;
                    title: e.title;
                    activated => { root.menu-action(root.block.key, e.action); }
                }
            }
            if root.block.menu-cut: MenuSeparator {}
            if root.block.menu-cut: MenuItem {
                title: CanvasText.cut;
                activated => { root.menu-action(root.block.key, "cut"); }
            }
            if root.block.menu-tail: MenuSeparator {}
            if root.block.menu-tail: MenuItem {
                title: CanvasText.duplicate;
                activated => { root.menu-action(root.block.key, "duplicate"); }
            }
            if root.block.menu-tail: MenuItem {
                title: CanvasText.delete;
                activated => { root.menu-action(root.block.key, "delete"); }
            }
        }
    }
}

// The settings page's values, choices and texts (proxydock-ui.rs fills them from the core's "settings")
export global Settings {
    in property <SettingsText> text;
    in-out property <string> allowed;
    in-out property <bool> private;
    in-out property <int> timeout: 120;
    in-out property <bool> logconn;
    in-out property <bool> logclose;
    in-out property <string> dns;
    in-out property <bool> dnsvia;
    in-out property <bool> logfile;
    in-out property <int> language;
    in-out property <int> theme;
    in-out property <int> scale;
    in-out property <int> logsize: 10;
    in-out property <bool> close;
    in-out property <bool> latest;
    in-out property <bool> admin;
    in property <bool> saved-admin;
    // text size (index in sizes), the UI font and the log font (index in their lists; 0 = built in)
    in-out property <int> text-size;
    in property <int> saved-text-size;
    in property <[string]> sizes;
    in-out property <int> ui-font;
    in property <int> saved-ui-font;
    in property <[string]> ui-fonts;
    in-out property <int> mono-font;
    in property <int> saved-mono-font;
    in property <[string]> mono-fonts;
    // Windows only: start at login (applied at once), the firewall rule (text, and whether it is on; -1 = checking)
    in property <bool> windows;
    // start at login works here (Windows, macOS, Linux)
    in property <bool> startup-supported;
    in-out property <bool> login;
    in-out property <bool> hidden;
    in property <string> fw-text;
    in property <int> fw-state: -1;
    callback set-login(bool);
    in-out property <bool> check-updates;
    in property <bool> saved-check-updates;
    callback set-hidden(bool);
    callback firewall(bool);
    in property <[string]> languages;
    in property <[string]> language-fonts;
    in property <[string]> themes;
    in property <[string]> scales;
    in property <string> engine;
    in property <string> log-dir;
    // the values as saved: the apply bar shows while anything differs
    in property <string> saved-allowed;
    in property <bool> saved-private;
    in property <int> saved-timeout;
    in property <bool> saved-logconn;
    in property <bool> saved-logclose;
    in property <string> saved-dns;
    in property <bool> saved-dnsvia;
    in property <bool> saved-logfile;
    in property <int> saved-language;
    in property <int> saved-theme;
    // the theme colour: "" = the app's, "system" = Windows' accent colour, else a colour (core theme.rs makes the
    // window's colours from it)
    in-out property <string> theme-color;
    in property <string> saved-theme-color;
    in property <color> system-accent;
    in property <[color]> presets;
    in property <[string]> preset-values;
    in property <color> custom-color;
    // (the theme colour is none of the above)
    in property <bool> theme-color-custom;
    in property <string> t-theme-color: "Theme colour";
    in property <string> t-system: "System";
    in property <string> t-custom: "Custom";
    callback pick-theme-color();
    callback preview-theme-color(string);
    in property <int> saved-scale;
    in property <int> saved-logsize;
    in property <bool> saved-close;
    in property <bool> saved-latest;
    out property <bool> dirty: admin != saved-admin || check-updates != saved-check-updates || text-size != saved-text-size || ui-font != saved-ui-font
        || mono-font != saved-mono-font || allowed != saved-allowed || private != saved-private || timeout != saved-timeout || logconn != saved-logconn || logclose != saved-logclose || dns != saved-dns || dnsvia != saved-dnsvia || logfile != saved-logfile || language != saved-language || theme != saved-theme || theme-color != saved-theme-color || scale != saved-scale || logsize != saved-logsize || close != saved-close || latest != saved-latest;
    public function revert() {
        self.allowed = self.saved-allowed;
        self.private = self.saved-private;
        self.timeout = self.saved-timeout;
        self.logconn = self.saved-logconn;
        self.logclose = self.saved-logclose;
        self.dns = self.saved-dns;
        self.dnsvia = self.saved-dnsvia;
        self.logfile = self.saved-logfile;
        self.language = self.saved-language;
        self.theme = self.saved-theme;
        if self.theme-color != self.saved-theme-color {
            self.theme-color = self.saved-theme-color;
            self.preview-theme-color(self.theme-color);
        }
        self.scale = self.saved-scale;
        self.logsize = self.saved-logsize;
        self.close = self.saved-close;
        self.latest = self.saved-latest;
        self.admin = self.saved-admin;
        self.check-updates = self.saved-check-updates;
        self.text-size = self.saved-text-size;
        self.ui-font = self.saved-ui-font;
        self.mono-font = self.saved-mono-font;
    }
    callback apply();
    callback open-log-dir();
}

// The VPN bypass VMs (Settings > VPN bypass; proxydock-ui.rs fills them from the core's "settings" -> "bypass")
export struct BypassItem {
    name: string,
    label: string,
    // index in Bypass.adapters (-1: none / not connected now), its name
    adapter: int,
    adapter-name: string,
    // index in Bypass.memories
    memory: int,
    static-ip: bool,
    address: string,
    gateway: string,
    dns: string,
    // prepared with the user's consent for this network card
    ready: bool,
    // running cards that use it
    in-use: int,
    // the user's switch (off: stopped, no card may use it) and whether it runs now
    enabled: bool,
    running: bool,
}
export struct BypassText {
    title: string, intro: string, adapter: string, adapter-desc: string, memory: string, memory-desc: string,
    ip: string, ip-desc: string, dhcp: string, static: string, address: string, gateway: string, dns: string,
    save-ip: string, prepare: string, reprepare: string, remove: string, ready: string, not-ready: string,
    in-use: string, keep: string, keep-desc: string, vm-on: string, vm-on-desc: string, running: string, add-title: string, add-desc: string, add: string,
    name-hint: string, consent-title: string, consent-check: string, consent-create: string,
}
export global Bypass {
    in property <BypassText> text;
    in property <bool> available;
    // why not (Windows Home, Hyper-V off, ...)
    in property <string> reason;
    in property <[string]> adapters;
    in property <[string]> memories;
    in property <[string]> ip-modes;
    in property <[BypassItem]> items;
    in property <bool> keep;
    // a VM is being prepared or removed (one at a time), and what it is doing
    in property <bool> working;
    in property <string> progress;
    // the consent dialog: the instance asking, its text (filled by proxydock-ui.rs)
    in-out property <bool> consent-open;
    in property <string> consent-name;
    in property <string> consent-body;
    in-out property <bool> consent-agreed;
    callback set-adapter(string, int);
    callback set-memory(string, int);
    callback set-ip(string, bool, string, string, string);
    // "Create" / "Apply again": asks for consent first when the instance has none for its network card
    callback prepare(string);
    callback consent-yes(string);
    callback remove(string);
    callback add(string);
    callback set-keep(bool);
    callback set-enabled(string, bool);
    callback refresh();
}

// a theme colour choice: a filled circle (a ring and a check when chosen), an optional icon and a label under it
component ThemeDot inherits VerticalLayout {
    in property <color> fill;
    in property <bool> chosen;
    in property <image> icon;
    in property <string> label;
    callback clicked();
    // (dark marks on a light colour)
    property <bool> light: (root.fill.red * 0.299 + root.fill.green * 0.587 + root.fill.blue * 0.114) / 255 > 0.6;
    spacing: 4px;
    alignment: start;
    width: 60px;
    HorizontalLayout {
    alignment: center;
    Rectangle {
        width: 44px;
        height: 44px;
        border-radius: 22px;
        border-width: root.chosen ? 3px : 0px;
        border-color: M3.on-surface;
        Rectangle {
            width: root.chosen ? 32px : 40px;
            height: self.width;
            border-radius: self.width / 2;
            background: root.fill;
            border-width: 1px;
            border-color: M3.outline-variant;
            animate width { duration: Motion.fast-effects; }
        }
        if root.chosen: Image {
            width: 18px;
            height: 18px;
            source: @image-url("icons/check.svg");
            colorize: root.light ? #191c20 : white;
        }
        if !root.chosen && root.icon.width > 0: Image {
            width: 20px;
            height: 20px;
            source: root.icon;
            colorize: root.light ? #191c20 : white;
        }
        TouchArea { clicked => { root.clicked(); } }
    }
    }
    Text {
        text: root.label;
        font-size: 11px * Type.scale;
        color: M3.on-surface-variant;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// A group of settings (M3 list): a small title in the primary colour, then each setting on a card of its own;
// the group's outer corners are round, the cards are 3 px apart.
component SettingsSection inherits VerticalLayout {
    in property <string> title;
    // (kept for the callers; the group title stands without an icon)
    in property <image> icon;
    spacing: 8px;
    // in line with the cards' text
    HorizontalLayout {
        padding-left: 20px;
        Text {
            text: root.title;
            font-size: 14px * Type.scale;
            font-weight: 600;
            color: M3.primary;
            wrap: word-wrap;
        }
    }
    Rectangle {
        border-radius: 28px;
        clip: true;
        VerticalLayout {
            spacing: 2px;
            @children
        }
    }
}

// a card in a settings group, for content that is not a single row
component SettingTile inherits Rectangle {
    background: M3.surface-container-low;
    border-radius: 4px;
    VerticalLayout {
        padding: 20px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 8px;
        @children
    }
}

// One setting on its card: its name and what it does on the left, its control on the right
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> desc;
    in property <string> badge;
    // the description is a path (or the like): monospace, wrapped at any character
    in property <bool> desc-path;
    background: M3.surface-container-low;
    border-radius: 4px;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: center;
            HorizontalLayout {
                // the badge right after the name
                alignment: start;
                spacing: 8px;
                Text {
                    text: root.label;
                    font-size: 16px * Type.scale;
                    font-weight: 400;
                    color: M3.on-surface;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                if root.badge != "": Rectangle {
                    width: badge-label.preferred-width + 16px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 11px;
                    background: M3.tertiary-container;
                    badge-label := Text {
                        text: root.badge;
                        font-size: 11px * Type.scale;
                        font-weight: 700;
                        color: M3.on-tertiary-container;
                    }
                }
            }
            if root.desc != "": Text {
                text: root.desc;
                font-size: (root.desc-path ? 12px : 13px) * Type.scale;
                font-family: root.desc-path ? Type.mono : "";
                color: M3.on-surface-variant;
                wrap: root.desc-path ? char-wrap : word-wrap;
            }
        }
        // the controls in the middle of the card's height
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                @children
            }
        }
    }
}

// A setting whose field takes the card's width: its name, what it does, then the field
component SettingField inherits SettingTile {
    in property <string> label;
    in property <string> desc;
    Text {
        text: root.label;
        font-size: 16px * Type.scale;
        font-weight: 400;
        color: M3.on-surface;
        wrap: word-wrap;
    }
    if root.desc != "": Text {
        text: root.desc;
        font-size: 14px * Type.scale;
        color: M3.on-surface-variant;
        wrap: word-wrap;
    }
    @children
}

component SettingsDefaults inherits SettingsSection {
    title: Settings.text.defaults;
    SettingField {
        label: Settings.text.allowed;
        desc: Settings.text.allowed-desc;
        AppLineEdit { text <=> Settings.allowed; }
    }
    SettingRow {
        label: Settings.text.private;
        desc: Settings.text.private-desc;
        AppSwitch { checked <=> Settings.private; }
    }
    SettingRow {
        label: Settings.text.timeout;
        desc: Settings.text.timeout-desc;
        AppSpinBox {
            width: 150px;
            minimum: 10;
            maximum: 86400;
            value <=> Settings.timeout;
        }
    }
    SettingRow {
        label: Settings.text.logconn;
        desc: Settings.text.logconn-desc;
        AppSwitch { checked <=> Settings.logconn; }
    }
    SettingRow {
        label: Settings.text.logclose;
        desc: Settings.text.logclose-desc;
        AppSwitch { checked <=> Settings.logclose; }
    }
    SettingField {
        label: Settings.text.dns;
        desc: Settings.text.dns-desc;
        AppLineEdit {
            text <=> Settings.dns;
            placeholder-text: "https://cloudflare-dns.com/dns-query, tls://dns.google, 1.1.1.1";
        }
    }
    SettingRow {
        label: Settings.text.dnsvia;
        desc: Settings.text.dnsvia-desc;
        AppSwitch { checked <=> Settings.dnsvia; }
    }
}

component SettingsStartup inherits SettingsSection {
    title: Settings.text.startup;
    SettingRow {
        label: Settings.text.login;
        desc: Settings.text.login-desc;
        AppSwitch {
            checked <=> Settings.login;
            toggled => { Settings.set-login(self.checked); }
        }
    }
    SettingRow {
        label: Settings.text.hidden;
        desc: Settings.text.hidden-desc;
        AppSwitch {
            enabled: Settings.login;
            checked <=> Settings.hidden;
            toggled => { Settings.set-hidden(self.checked); }
        }
    }
    // (Windows: UAC; macOS / Linux have no such start)
    if Settings.windows: SettingRow {
        label: Settings.text.admin;
        desc: Settings.text.admin-desc;
        AppSwitch { checked <=> Settings.admin; }
    }
}

component SettingsUpdates inherits SettingsSection {
    title: Settings.text.updates;
    SettingRow {
        label: Settings.text.check-updates;
        desc: Settings.text.check-updates-desc;
        AppSwitch { checked <=> Settings.check-updates; }
    }
}

component SettingsFirewall inherits SettingsSection {
    title: Settings.text.firewall;
    SettingField {
        label: Settings.text.fw-block;
        desc: Settings.text.fw-block-desc;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: Settings.fw-text;
                font-size: 14px * Type.scale;
                font-weight: 600;
                color: Settings.fw-state == 1 ? #2e9d4a : M3.on-surface-variant;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            AppButton {
                text: Settings.text.fw-on;
                enabled: Settings.fw-state == 0;
                clicked => { Settings.firewall(true); }
            }
            AppButton {
                text: Settings.text.fw-off;
                enabled: Settings.fw-state == 1;
                clicked => { Settings.firewall(false); }
            }
        }
    }
}

component SettingsBypass inherits VerticalLayout {
    spacing: 24px;
    SettingsSection {
        title: Bypass.text.title;
        SettingTile {
            Text {
                text: Bypass.text.intro;
                font-size: 14px * Type.scale;
                color: M3.on-surface-variant;
                wrap: word-wrap;
            }
            if !Bypass.available && Bypass.reason != "": HorizontalLayout {
                spacing: 8px;
                Image {
                    width: 18px;
                    height: 18px;
                    source: @image-url("icons/warning.svg");
                    colorize: M3.error;
                }
                Text {
                    text: Bypass.reason;
                    font-size: 14px * Type.scale;
                    font-weight: 600;
                    color: M3.error;
                    wrap: word-wrap;
                }
            }
            if Bypass.progress != "": Text {
                text: Bypass.progress;
                font-size: 14px * Type.scale;
                color: M3.primary;
                wrap: word-wrap;
            }
        }
        SettingRow {
            label: Bypass.text.keep;
            desc: Bypass.text.keep-desc;
            AppSwitch {
                checked: Bypass.keep;
                toggled => { Bypass.set-keep(self.checked); }
            }
        }
    }
    SettingsSection {
        title: Bypass.text.add-title;
        SettingField {
            label: Bypass.text.name-hint;
            desc: Bypass.text.add-desc;
            HorizontalLayout {
                spacing: 8px;
                new-name := AppLineEdit { placeholder-text: Bypass.text.name-hint; }
                AppButton {
                    text: Bypass.text.add;
                    icon: @image-url("icons/add.svg");
                    enabled: new-name.text != "";
                    clicked => {
                        Bypass.add(new-name.text);
                        new-name.text = "";
                    }
                }
            }
        }
    }
    for item in Bypass.items: SettingsSection {
        title: item.label + " · " + (!item.ready ? Bypass.text.not-ready : item.running ? Bypass.text.running : Bypass.text.ready)
            + (item.in-use > 0 ? " · " + Bypass.text.in-use : "");
        SettingRow {
            label: Bypass.text.vm-on;
            desc: Bypass.text.vm-on-desc;
            AppSwitch {
                enabled: item.ready && Bypass.available && !Bypass.working;
                checked: item.enabled && item.ready;
                toggled => { Bypass.set-enabled(item.name, self.checked); }
            }
        }
        SettingRow {
            label: Bypass.text.adapter;
            desc: item.adapter < 0 && item.adapter-name != "" ? Bypass.text.adapter-desc + " (" + item.adapter-name + ")" : Bypass.text.adapter-desc;
            AppComboBox {
                width: 190px;
                enabled: Bypass.available && !Bypass.working && item.in-use == 0 && Bypass.adapters.length > 0;
                model: Bypass.adapters;
                current-index: max(0, item.adapter);
                selected(_) => { Bypass.set-adapter(item.name, self.current-index); }
            }
        }
        SettingRow {
            label: Bypass.text.memory;
            desc: Bypass.text.memory-desc;
            AppComboBox {
                width: 150px;
                enabled: !Bypass.working && item.in-use == 0;
                model: Bypass.memories;
                current-index: item.memory;
                selected(_) => { Bypass.set-memory(item.name, self.current-index); }
            }
        }
        SettingTile {
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: Bypass.text.ip;
                        font-size: 16px * Type.scale;
                        color: M3.on-surface;
                        wrap: word-wrap;
                    }
                    Text {
                        text: Bypass.text.ip-desc;
                        font-size: 13px * Type.scale;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    mode := AppComboBox {
                        width: 150px;
                        enabled: !Bypass.working && item.in-use == 0;
                        model: Bypass.ip-modes;
                        current-index: item.static-ip ? 1 : 0;
                        selected(_) => {
                            if self.current-index == 0 {
                                Bypass.set-ip(item.name, false, item.address, item.gateway, item.dns);
                            }
                        }
                    }
                }
            }
            if mode.current-index == 1: VerticalLayout {
                spacing: 8px;
                addr := AppLineEdit {
                    text: item.address;
                    placeholder-text: Bypass.text.address + "  (192.168.0.50/24)";
                }
                gw := AppLineEdit {
                    text: item.gateway;
                    placeholder-text: Bypass.text.gateway + "  (192.168.0.1)";
                }
                dns := AppLineEdit {
                    text: item.dns;
                    placeholder-text: Bypass.text.dns + "  (1.1.1.1, 8.8.8.8)";
                }
                HorizontalLayout {
                    alignment: end;
                    AppButton {
                        text: Bypass.text.save-ip;
                        enabled: !Bypass.working && item.in-use == 0;
                        clicked => { Bypass.set-ip(item.name, true, addr.text, gw.text, dns.text); }
                    }
                }
            }
        }
        SettingTile {
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                AppButton {
                    text: Bypass.text.remove;
                    icon: @image-url("icons/delete.svg");
                    enabled: !Bypass.working && item.in-use == 0;
                    clicked => { Bypass.remove(item.name); }
                }
                AppButton {
                    text: item.ready ? Bypass.text.reprepare : Bypass.text.prepare;
                    primary: !item.ready;
                    enabled: Bypass.available && !Bypass.working && item.in-use == 0 && item.adapter >= 0;
                    clicked => { Bypass.prepare(item.name); }
                }
            }
        }
    }
}

// The home page (proxydock-ui.rs fills it from the cards and the statistics)
export struct HomeText {
    title-on: string, title-off: string, sub-on: string, sub-off: string, status: string, running: string,
    errors: string, cards: string, used-by: string, traffic: string, down: string, up: string, vms: string, vms-none: string,
    vms-open: string, vm-running: string, vm-idle: string, vm-off: string, vm-not-ready: string,
}
export global Home {
    in property <HomeText> text;
    // any card running
    in property <bool> on;
    in property <int> running;
    in property <int> errors;
    in property <int> total;
    // under the count: the errors, or "running"
    in property <string> status-sub;
    in property <string> down-rate;
    in property <string> up-rate;
    in property <string> down-total;
    in property <string> up-total;
    callback power(bool);
}

// the big switch of the home page (AdGuard-like): a wide track and a round knob with a mark
component PowerSwitch inherits Rectangle {
    in property <bool> on;
    callback toggled(bool);
    width: 128px;
    height: 64px;
    Rectangle {
        y: 12px;
        height: 40px;
        border-radius: 20px;
        background: root.on ? M3.primary : M3.surface-container-highest;
        animate background { duration: 200ms; }
    }
    Rectangle {
        x: root.on ? root.width - self.width : 0px;
        width: 64px;
        height: 64px;
        border-radius: 32px;
        background: root.on ? #ffffff : M3.surface-container-high;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000040;
        animate x { duration: 220ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        Image {
            width: 28px;
            height: 28px;
            source: root.on ? @image-url("icons/check.svg") : @image-url("icons/power_settings_new.svg");
            colorize: root.on ? M3.primary : M3.on-surface-variant;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
    accessible-role: switch;
    accessible-checked: root.on;
}

component HomeCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> sub;
    in property <bool> link;
    callback clicked();
    border-radius: 20px;
    background: ta.has-hover && root.link ? M3.surface-container : M3.surface-container-low;
    min-height: 92px;
    preferred-width: 100px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 16px;
        padding-left: 20px;
        spacing: 2px;
        alignment: center;
        Text { text: root.title; font-size: 12px * Type.scale; color: M3.on-surface-variant; overflow: elide; }
        Text { text: root.value; font-size: 22px * Type.scale; font-weight: 700; color: M3.on-surface; overflow: elide; }
        if root.sub != "": Text { text: root.sub; font-size: 12px * Type.scale; color: M3.on-surface-variant; overflow: elide; }
    }
    ta := TouchArea {
        enabled: root.link;
        mouse-cursor: root.link ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component HomePage inherits VerticalLayout {
    callback open-page(int);
    callback open-vms();
    spacing: 16px;
    alignment: start;
    Rectangle { height: 24px; }
    VerticalLayout {
        spacing: 10px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            PowerSwitch {
                on: Home.on;
                toggled(v) => { Home.power(v); }
            }
        }
        Text {
            text: Home.on ? Home.text.title-on : Home.text.title-off;
            font-size: 32px * Type.scale;
            font-weight: 700;
            color: M3.on-surface;
            horizontal-alignment: center;
        }
        Text {
            text: Home.on ? Home.text.sub-on : Home.text.sub-off;
            font-size: 14px * Type.scale;
            color: M3.on-surface-variant;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    Rectangle { height: 8px; }
    HorizontalLayout {
        spacing: 12px;
        HomeCard {
            title: Home.text.status;
            value: Home.running + " / " + Home.total;
            sub: Home.status-sub;
            link: true;
            clicked => { root.open-page(1); }
        }
        HomeCard {
            title: Home.text.down;
            value: Home.down-rate;
            sub: Home.down-total;
            link: true;
            clicked => { root.open-page(5); }
        }
        HomeCard {
            title: Home.text.up;
            value: Home.up-rate;
            sub: Home.up-total;
            link: true;
            clicked => { root.open-page(5); }
        }
    }
    SettingsSection {
        title: Home.text.vms;
        if Bypass.items.length == 0: SettingRow {
            label: Home.text.vms-none;
            AppButton {
                text: Home.text.vms-open;
                clicked => { root.open-vms(); }
            }
        }
        for item in Bypass.items: SettingRow {
            label: item.label;
            desc: !item.ready ? Home.text.vm-not-ready : !item.enabled ? Home.text.vm-off
                : item.running ? Home.text.vm-running + (item.in-use > 0 ? " · " + Home.text.used-by + " " + item.in-use : "")
                : Home.text.vm-idle;
            AppSwitch {
                enabled: item.ready && Bypass.available && !Bypass.working;
                checked: item.enabled && item.ready;
                toggled => { Bypass.set-enabled(item.name, self.checked); }
            }
        }
    }
}

component SettingsDisplay inherits SettingsSection {
    title: Settings.text.display;
    SettingRow {
        label: Settings.text.language;
        desc: Settings.text.language-desc;
        AppComboBox {
            width: 170px;
            model: Settings.languages;
            fonts: Settings.language-fonts;
            current-index <=> Settings.language;
        }
    }
    // the theme: cards with a preview of each (the M3 way), not a menu
    SettingTile {
        Text {
            text: Settings.text.theme;
            font-size: 16px * Type.scale;
            color: M3.on-surface;
            wrap: word-wrap;
        }
        Text {
            text: Settings.text.theme-desc;
            font-size: 14px * Type.scale;
            color: M3.on-surface-variant;
            wrap: word-wrap;
        }
        HorizontalLayout {
            padding-top: 4px;
            spacing: 12px;
            for name[i] in Settings.themes: ThemeCard {
                label: name;
                kind: i;
                selected: Settings.theme == i;
                clicked => { Settings.theme = i; }
            }
        }
        // the colour the theme is made from: Windows' accent, one of the app's, or any colour
        Text {
            text: Settings.t-theme-color;
            font-size: 14px * Type.scale;
            font-weight: 500;
            color: M3.on-surface;
        }
        // (a narrow window: the dots go on to the next line, not out of the tile)
        FlexboxLayout {
            spacing: 0px;
            ThemeDot {
                fill: Settings.system-accent;
                chosen: Settings.theme-color == "system";
                icon: @image-url("icons/settings.svg");
                label: Settings.t-system;
                clicked => {
                    Settings.theme-color = "system";
                    Settings.preview-theme-color(Settings.theme-color);
                }
            }
            Rectangle { width: 1px; height: 44px; Rectangle { y: 4px; height: 36px; background: M3.outline-variant; } }
            for c[i] in Settings.presets: ThemeDot {
                fill: c;
                chosen: i == 0 ? Settings.theme-color == "" : Settings.theme-color == Settings.preset-values[i];
                clicked => {
                    Settings.theme-color = i == 0 ? "" : Settings.preset-values[i];
                    Settings.preview-theme-color(Settings.theme-color);
                }
            }
            Rectangle { width: 1px; height: 44px; Rectangle { y: 4px; height: 36px; background: M3.outline-variant; } }
            ThemeDot {
                property <bool> custom: Settings.theme-color-custom;
                fill: self.custom ? Settings.custom-color : M3.surface-container-highest;
                chosen: self.custom;
                icon: @image-url("icons/palette.svg");
                label: Settings.t-custom;
                clicked => { Settings.pick-theme-color(); }
            }
        }
    }
    SettingRow {
        label: Settings.text.text-size;
        desc: Settings.text.text-size-desc;
        AppComboBox {
            width: 170px;
            model: Settings.sizes;
            current-index <=> Settings.text-size;
        }
    }
    SettingRow {
        label: Settings.text.scale;
        desc: Settings.text.scale-desc;
        AppComboBox {
            width: 170px;
            model: Settings.scales;
            current-index <=> Settings.scale;
        }
    }
    SettingRow {
        label: Settings.text.logsize;
        desc: Settings.text.logsize-desc;
        AppSpinBox {
            width: 150px;
            minimum: 8;
            maximum: 20;
            value <=> Settings.logsize;
        }
    }
    SettingRow {
        label: Settings.text.close;
        desc: Settings.text.close-desc;
        AppSwitch { checked <=> Settings.close; }
    }
}

component SettingsFonts inherits SettingsSection {
    title: Settings.text.fonts;
    SettingRow {
        label: Settings.text.ui-font;
        desc: Settings.text.ui-font-desc;
        AppComboBox {
            width: 240px;
            model: Settings.ui-fonts;
            current-index <=> Settings.ui-font;
        }
    }
    SettingRow {
        label: Settings.text.mono-font;
        desc: Settings.text.mono-font-desc;
        AppComboBox {
            width: 240px;
            model: Settings.mono-fonts;
            current-index <=> Settings.mono-font;
        }
    }
}

component SettingsEngine inherits SettingsSection {
    title: Settings.text.engine;
    SettingTile {
        Text {
            text: Settings.engine;
            font-size: 13px * Type.scale;
            font-family: Type.mono;
            color: M3.on-surface-variant;
            wrap: char-wrap;
        }
    }
    SettingRow {
        label: Settings.text.latest;
        badge: Settings.text.latest-badge;
        desc: Settings.text.latest-desc;
        AppSwitch { checked <=> Settings.latest; }
    }
}

component SettingsLogs inherits SettingsSection {
    title: Settings.text.logs;
    SettingRow {
        label: Settings.text.logfile;
        desc: Settings.log-dir;
        desc-path: true;
        AppButton {
            text: Settings.text.open-folder;
            icon: @image-url("icons/folder_open.svg");
            colorize-icon: true;
            clicked => { Settings.open-log-dir(); }
        }
        AppSwitch { checked <=> Settings.logfile; }
    }
}

// --- statistics page (Python ui/stats.py) ---

export struct StatTileData { title: string, value: string, sub: string }
// one graph line: its colour, the SVG path in a 0..59 x 0..1000 box (y down), and the filled area ("" = none)
export struct ChartLine { name: string, color: color, commands: string, area: string }

export global Stats {
    in property <string> title;
    in property <[string]> choices;
    in-out property <int> choice;
    in property <[string]> modes;
    in-out property <int> mode;
    in property <[StatTileData]> tiles;
    in property <string> chart-title;
    in property <string> max-text;
    in property <[ChartLine]> lines;
    in property <string> empty;
    // the graph's size in px (the paths are drawn in it: a Path keeps its view box's aspect ratio)
    in-out property <float> chart-w: 600;
    in-out property <float> chart-h: 240;
    callback changed();
}

component StatTile inherits Rectangle {
    in property <StatTileData> data;
    border-radius: 20px;
    background: M3.surface-container-low;
    min-height: 92px;
    // equal shares of the row (not by the length of their text)
    preferred-width: 100px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 16px;
        padding-left: 20px;
        spacing: 2px;
        alignment: center;
        Text {
            text: root.data.title;
            font-size: 12px * Type.scale;
            color: M3.on-surface-variant;
            overflow: elide;
        }
        Text {
            text: root.data.value;
            font-size: 22px * Type.scale;
            font-weight: 700;
            color: M3.on-surface;
            overflow: elide;
        }
        Text {
            text: root.data.sub;
            font-size: 12px * Type.scale;
            color: M3.on-surface-variant;
            overflow: elide;
        }
    }
}

// a pill segmented button row (M3 segmented buttons)
component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current;
    callback picked();
    height: 36px;
    width: seg-row.preferred-width;
    border-radius: 18px;
    border-width: 1px;
    border-color: M3.outline-variant;
    clip: true;
    seg-row := HorizontalLayout {
        for item[i] in root.items: Rectangle {
            width: seg-label.preferred-width + 28px;
            background: i == root.current ? M3.secondary-container : seg-ta.has-hover ? M3.on-surface.with-alpha(0.06) : transparent;
            seg-label := Text {
                text: item;
                font-size: 13px * Type.scale;
                font-weight: i == root.current ? 700 : 500;
                color: i == root.current ? M3.on-secondary-container : M3.on-surface;
            }
            seg-ta := TouchArea {
                clicked => {
                    root.current = i;
                    root.picked();
                }
            }
        }
    }
}

component StatsPage inherits VerticalLayout {
    spacing: 14px;
    // tiles: three a row when there is room, two otherwise
    property <bool> wide: self.width >= 640px;
    if root.wide: VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            StatTile { data: Stats.tiles[0]; }
            StatTile { data: Stats.tiles[1]; }
            StatTile { data: Stats.tiles[2]; }
        }
        HorizontalLayout {
            spacing: 12px;
            StatTile { data: Stats.tiles[3]; }
            StatTile { data: Stats.tiles[4]; }
            StatTile { data: Stats.tiles[5]; }
        }
    }
    if !root.wide: VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            StatTile { data: Stats.tiles[0]; }
            StatTile { data: Stats.tiles[1]; }
        }
        HorizontalLayout {
            spacing: 12px;
            StatTile { data: Stats.tiles[2]; }
            StatTile { data: Stats.tiles[5]; }
        }
        HorizontalLayout {
            spacing: 12px;
            StatTile { data: Stats.tiles[3]; }
            StatTile { data: Stats.tiles[4]; }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        min-height: 220px;
        border-radius: 20px;
        background: M3.surface-container-low;
        VerticalLayout {
            padding: 16px;
            padding-left: 20px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: Stats.chart-title;
                    font-size: 13px * Type.scale;
                    font-weight: 600;
                    color: M3.on-surface;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Segmented {
                    items: Stats.modes;
                    current <=> Stats.mode;
                    picked => { Stats.changed(); }
                }
            }
            // legend, then the graph
            HorizontalLayout {
                spacing: 14px;
                Text {
                    text: Stats.max-text;
                    font-size: 12px * Type.scale;
                    color: M3.on-surface-variant;
                    horizontal-stretch: 1;
                }
                for l in Stats.lines: HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 6px;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: l.color;
                    }
                    Text {
                        text: l.name;
                        font-size: 12px * Type.scale;
                        color: M3.on-surface-variant;
                        max-width: 160px;
                        overflow: elide;
                    }
                }
            }
            chart := Rectangle {
                vertical-stretch: 1;
                init => {
                    Stats.chart-w = self.width / 1px;
                    Stats.chart-h = self.height / 1px;
                }
                changed width => {
                    Stats.chart-w = self.width / 1px;
                    Stats.changed();
                }
                changed height => {
                    Stats.chart-h = self.height / 1px;
                    Stats.changed();
                }
                for i in 5: Rectangle {
                    y: chart.height * i / 4;
                    height: 1px;
                    background: M3.on-surface.with-alpha(0.10);
                }
                for l in Stats.lines: Path {
                    width: chart.width;
                    height: chart.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: Stats.chart-w;
                    viewbox-height: Stats.chart-h;
                    commands: l.area;
                    fill: l.color.with-alpha(0.20);
                    visible: l.area != "";
                }
                for l in Stats.lines: Path {
                    width: chart.width;
                    height: chart.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: Stats.chart-w;
                    viewbox-height: Stats.chart-h;
                    commands: l.commands;
                    stroke: l.color;
                    stroke-width: 2px;
                }
                if Stats.empty != "": Text {
                    text: Stats.empty;
                    color: M3.on-surface-variant;
                    font-size: 14px * Type.scale;
                }
            }
        }
    }
}

// --- connection test page (Python ui/conntest.py) ---

export struct ConnRow {
    // the site's place in the list (from 1: the default order)
    index: int,
    region: string, name: string, host: string, added: bool,
    result: string, conn: string, total: string,
    // 0 not tested / waiting, 1 answered, 2 failed
    tone: int,
    // to sort by (ms; -1 unknown)
    conn-ms: float, total-ms: float,
    // the waterfall (ms; -1 not reached): the site's start from the test's start, then the end of each phase
    // from the site's start: the local proxy, the tunnel to the site, TLS, the first byte, the end
    w-start: float, w-tcp: float, w-connect: float, w-tls: float, w-first: float, w-total: float,
}

export global Conn {
    in property <string> title;
    in property <[string]> proxies;
    in-out property <int> proxy;
    in property <string> button;
    in property <bool> button-enabled;
    in property <string> summary;
    in property <string> placeholder;
    in property <string> add-text;
    in-out property <string> site;
    in property <bool> editable: true;
    in property <[string]> columns;
    in property <[ConnRow]> rows;
    in property <string> t-waterfall;
    // the waterfall's phases: proxy, connect, TLS, waiting, response
    in property <[string]> phases;
    // the sorting (0 = the sites' order) and the waterfall's scale (the latest end, ms)
    in property <int> sort-col;
    in property <bool> sort-desc;
    in property <float> w-max: 1;
    callback sort(int);
    callback start();
    callback add();
    callback remove(string);
    callback proxy-changed();
}

// the waterfall's colours (as in browsers' developer tools): proxy, connect, TLS, waiting, response
global WaterfallColors {
    out property <[color]> phase: [#9aa0a6, #f29900, #a142f4, #34a853, #4285f4];
}

// a header cell: click to sort by it (again: the other way); an arrow shows the column sorted by
component ConnHead inherits Rectangle {
    in property <string> text;
    in property <int> column;
    in property <bool> right;
    in property <length> pad;
    property <bool> on: Conn.sort-col == root.column && root.column != 0;
    background: ta.has-hover ? M3.on-surface.with-alpha(0.06) : transparent;
    HorizontalLayout {
        padding-left: root.pad;
        alignment: root.right ? end : start;
        spacing: 4px;
        Text {
            text: root.text;
            font-size: 12px * Type.scale;
            font-weight: 700;
            color: root.on ? M3.primary : M3.on-surface-variant;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.on: Image {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            source: Conn.sort-desc ? @image-url("icons/arrow_drop_down.svg") : @image-url("icons/arrow_drop_up.svg");
            colorize: M3.primary;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Conn.sort(root.column); }
    }
}

// one site's bar in the waterfall: each phase in its colour, from the site's start (all on the test's time scale)
component WaterfallBar inherits Rectangle {
    in property <ConnRow> r;
    // px per ms
    in property <float> k;
    property <[float]> ends: [root.r.w-tcp, root.r.w-connect, root.r.w-tls, root.r.w-first, root.r.w-total];
    // (10 px in from the column's start, clear of the time before it)
    property <length> x0: 10px + max(0, root.r.w-start) * root.k * 1px;
    for i in 5: Rectangle {
        property <float> from: i == 0 ? 0 : root.ends[i - 1];
        property <float> to: root.ends[i];
        visible: root.r.w-start >= 0 && self.from >= 0 && self.to > self.from;
        x: root.x0 + self.from * root.k * 1px;
        y: (parent.height - self.height) / 2;
        width: max(1px, (self.to - self.from) * root.k * 1px);
        height: 10px;
        background: WaterfallColors.phase[i];
    }
    // a failed site: from where it got to until it gave up
    property <float> reached: max(0, max(root.r.w-tcp, max(root.r.w-connect, max(root.r.w-tls, root.r.w-first))));
    if root.r.tone == 2 && root.r.w-start >= 0 && root.r.w-total > root.reached: Rectangle {
        x: root.x0 + root.reached * root.k * 1px;
        y: (parent.height - self.height) / 2;
        width: max(1px, (root.r.w-total - root.reached) * root.k * 1px);
        height: 10px;
        background: M3.error.with-alpha(0.55);
    }
}

component ConnPage inherits VerticalLayout {
    spacing: 10px;
    // the columns' widths; the result's takes what is left (a narrow window scrolls the table sideways)
    property <length> w-index: 40px;
    property <length> w-region: 72px;
    property <length> w-name: 112px;
    property <length> w-host: 150px;
    property <length> w-ms: 70px;
    property <length> w-fall: 244px;
    property <length> w-remove: 28px;
    property <length> fixed-w: root.w-index + root.w-region + root.w-name + root.w-host + 2 * root.w-ms + root.w-fall + root.w-remove
        + 8 * 12px + 28px;
    property <length> w-result: max(120px, conn-scroll.visible-width - root.fixed-w);
    property <length> table-w: root.fixed-w + root.w-result;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: Conn.summary;
            font-size: 12px * Type.scale;
            color: M3.on-surface-variant;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        AppLineEdit {
            width: 260px;
            y: (parent.height - self.height) / 2;
            text <=> Conn.site;
            placeholder-text: Conn.placeholder;
            enabled: Conn.editable;
            accepted => { Conn.add(); }
        }
        AppButton {
            text: Conn.add-text;
            icon: @image-url("icons/add.svg");
            colorize-icon: true;
            enabled: Conn.editable;
            clicked => { Conn.add(); }
        }
    }
    // the waterfall's legend
    HorizontalLayout {
        alignment: end;
        spacing: 14px;
        for name[i] in Conn.phases: HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 12px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                background: WaterfallColors.phase[i];
            }
            Text {
                text: name;
                font-size: 12px * Type.scale;
                color: M3.on-surface-variant;
                vertical-alignment: center;
            }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        border-radius: 16px;
        background: M3.surface-container-low;
        clip: true;
        VerticalLayout {
            // the header: stays at the top, follows the table sideways
            Rectangle {
                height: 40px;
                background: M3.surface-container-high;
                clip: true;
                HorizontalLayout {
                    x: conn-scroll.content-x;
                    width: root.table-w;
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    ConnHead { width: root.w-index; text: "#"; column: 0; right: true; }
                    ConnHead { width: root.w-region; text: Conn.columns[0]; column: 1; }
                    ConnHead { width: root.w-name; text: Conn.columns[1]; column: 2; }
                    ConnHead { width: root.w-host; text: Conn.columns[2]; column: 3; }
                    ConnHead { width: root.w-result; text: Conn.columns[3]; column: 4; }
                    ConnHead { width: root.w-ms; text: Conn.columns[4]; column: 5; right: true; }
                    ConnHead { width: root.w-ms; text: Conn.columns[5]; column: 6; right: true; }
                    ConnHead { width: root.w-fall; text: Conn.t-waterfall; column: 7; pad: 10px; }
                    Rectangle { width: root.w-remove; }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                // up and down, and sideways when the window is narrow
                conn-scroll := ScrollView {
                    content-width: root.table-w;
                    content-height: rows-lay.preferred-height;
                    rows-lay := VerticalLayout {
                        width: root.table-w;
                        for r[i] in Conn.rows: Rectangle {
                            height: 36px;
                            background: mod(i, 2) == 1 ? M3.on-surface.with-alpha(0.03) : transparent;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 12px;
                                spacing: 12px;
                                Text { width: root.w-index; text: r.index; font-size: 12px * Type.scale; font-family: Type.mono; color: M3.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; }
                                Text { width: root.w-region; text: r.region; font-size: 13px * Type.scale; color: M3.on-surface-variant; vertical-alignment: center; overflow: elide; }
                                Text { width: root.w-name; text: r.name; font-size: 13px * Type.scale; font-weight: 600; color: M3.on-surface; vertical-alignment: center; overflow: elide; }
                                Text { width: root.w-host; text: r.host; font-size: 12px * Type.scale; font-family: Type.mono; color: M3.on-surface-variant; vertical-alignment: center; overflow: elide; }
                                Text {
                                    width: root.w-result;
                                    text: r.result;
                                    font-size: 13px * Type.scale;
                                    color: r.tone == 1 ? #2e9d4a : r.tone == 2 ? M3.error : M3.on-surface-variant;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text { width: root.w-ms; text: r.conn; font-size: 12px * Type.scale; font-family: Type.mono; color: M3.on-surface; vertical-alignment: center; horizontal-alignment: right; }
                                Text { width: root.w-ms; text: r.total; font-size: 12px * Type.scale; font-family: Type.mono; color: M3.on-surface; vertical-alignment: center; horizontal-alignment: right; }
                                WaterfallBar {
                                    width: root.w-fall;
                                    r: r;
                                    k: (root.w-fall / 1px - 14) / Conn.w-max;
                                }
                                // a site the user added can be taken out again
                                Rectangle {
                                    width: root.w-remove;
                                    if r.added: Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: rm-ta.has-hover && Conn.editable ? M3.on-surface.with-alpha(0.10) : transparent;
                                        opacity: Conn.editable ? 1 : 0.38;
                                        Image {
                                            width: 16px;
                                            height: 16px;
                                            source: @image-url("icons/close.svg");
                                            colorize: M3.on-surface-variant;
                                        }
                                        rm-ta := TouchArea {
                                            enabled: Conn.editable;
                                            clicked => { Conn.remove(r.host); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                EdgeFade {
                    // (not over the scroll bar)
                    x: 0;
                    width: parent.width - 14px;
                    offset: conn-scroll.content-y;
                    content: conn-scroll.content-height;
                    view: conn-scroll.visible-height;
                    fade-color: M3.surface-container-low;
                }
            }
        }
    }
}

// --- how to use, about, licenses (Python ui/help.py, about.py, license.py) ---

// a piece of the how-to: 0 a heading (text), 1 a paragraph or list (styled), 2 a table row (a, b; header = first row)
export struct HelpBlock { kind: int, title: string, text: styled-text, a: styled-text, b: styled-text, header: bool }
export struct EngineRow { name: string, text: string }

export global Info {
    // how to use
    in property <string> help-title;
    in property <[HelpBlock]> help;
    // about
    in property <string> about-title;
    in property <string> app-name: "ProxyDock";
    in property <string> version-text;
    in property <string> desc;
    in property <string> s-version;
    in property <string> s-engines;
    in property <string> s-folder;
    in property <string> folder-label;
    in property <string> app-dir;
    in property <string> open-folder;
    in property <string> s-links;
    in property <string> repo-label;
    in property <string> repo-url;
    in property <string> releases-label;
    in property <string> releases-url;
    in property <string> open;
    in property <string> licenses;
    in property <string> licenses-desc;
    in property <string> app-version;
    in property <[EngineRow]> engines;
    callback open-url(string);
    callback open-dir(string);
    callback show-licenses();
    // licenses
    in property <string> lic-desc;
    in property <[string]> lic-names;
    in-out property <int> lic-index;
    in property <string> lic-text;
    callback lic-picked();
    callback lic-open-folder();
}

component HelpBlockView inherits VerticalLayout {
    in property <HelpBlock> block;
    if root.block.kind == 0: Text {
        text: root.block.title;
        font-size: 18px * Type.scale;
        font-weight: 700;
        color: M3.primary;
        wrap: word-wrap;
    }
    if root.block.kind == 1: StyledText {
        text: root.block.text;
        default-color: M3.on-surface;
        default-font-size: 14px * Type.scale;
        link-color: M3.primary;
        selectable: true;
        link-clicked(link) => { Info.open-url(link); }
    }
    if root.block.kind == 2: Rectangle {
        height: row.preferred-height;
        background: root.block.header ? M3.surface-container-high : transparent;
        border-radius: root.block.header ? 8px : 0px;
        row := HorizontalLayout {
            padding: 8px;
            padding-left: 12px;
            spacing: 24px;
            StyledText {
                width: 240px;
                text: root.block.a;
                default-color: root.block.header ? M3.on-surface-variant : M3.on-surface;
                default-font-size: 13px * Type.scale;
            }
            StyledText {
                horizontal-stretch: 1;
                text: root.block.b;
                default-color: root.block.header ? M3.on-surface-variant : M3.on-surface;
                default-font-size: 13px * Type.scale;
            }
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: M3.outline-variant.with-alpha(0.6);
            visible: !root.block.header;
        }
    }
}

component HelpPage inherits VerticalLayout {
    spacing: 12px;
    Rectangle {
        vertical-stretch: 1;
        help-scroll := ScrollView {
            VerticalLayout {
                width: help-scroll.visible-width - 16px;
                padding-right: 16px;
                padding-bottom: 24px;
                spacing: 8px;
                alignment: start;
                for b in Info.help: HelpBlockView {
                    block: b;
                    padding-top: b.kind == 0 ? 14px : 0px;
                }
            }
        }
        EdgeFade {
            x: 0;
            width: parent.width - 14px;
            offset: help-scroll.content-y;
            content: help-scroll.content-height;
            view: help-scroll.visible-height;
            fade-color: M3.surface;
        }
    }
}

component AboutPage inherits VerticalLayout {
    spacing: 16px;
    Rectangle {
        vertical-stretch: 1;
        about-scroll := ScrollView {
            VerticalLayout {
                width: about-scroll.visible-width - 16px;
                padding-right: 16px;
                padding-bottom: 24px;
                spacing: 16px;
                alignment: start;
                // the app
                HorizontalLayout {
                    spacing: 16px;
                    Image {
                        width: 64px;
                        height: 64px;
                        source: @image-url("icons/app.svg");
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: Info.app-name; font-size: 26px * Type.scale; font-weight: 700; color: M3.on-surface; }
                        Text { text: Info.version-text; font-size: 14px * Type.scale; color: M3.on-surface; }
                        Text { text: Info.desc; font-size: 12px * Type.scale; color: M3.on-surface-variant; wrap: word-wrap; }
                    }
                }
                SettingsSection {
                    title: Info.s-version;
                    icon: @image-url("icons/info.svg");
                    SettingRow {
                        label: "ProxyDock " + Info.app-version;
                        desc: Upd.status;
                        if Upd.has-release: AppButton {
                            text: Upd.t-details;
                            clicked => { Upd.dialog = true; }
                        }
                        AppButton {
                            text: Upd.t-check;
                            enabled: !Upd.busy;
                            clicked => { Upd.check(); }
                        }
                    }
                }
                SettingsSection {
                    title: Info.s-engines;
                    icon: @image-url("icons/memory.svg");
                    for e in Info.engines: SettingRow {
                        label: e.name;
                        desc: e.text;
                    }
                }
                SettingsSection {
                    title: Info.s-folder;
                    icon: @image-url("icons/folder_open.svg");
                    SettingRow {
                        label: Info.folder-label;
                        desc: Info.app-dir;
                        desc-path: true;
                        AppButton {
                            text: Info.open-folder;
                            icon: @image-url("icons/folder_open.svg");
                            colorize-icon: true;
                            clicked => { Info.open-dir(Info.app-dir); }
                        }
                    }
                }
                SettingsSection {
                    title: Info.s-links;
                    icon: @image-url("icons/open_in_new.svg");
                    SettingRow {
                        label: Info.repo-label;
                        desc: Info.repo-url;
                        AppButton {
                            text: Info.open;
                            icon: @image-url("icons/open_in_new.svg");
                            colorize-icon: true;
                            clicked => { Info.open-url(Info.repo-url); }
                        }
                    }
                    SettingRow {
                        label: Info.releases-label;
                        desc: Info.releases-url;
                        AppButton {
                            text: Info.open;
                            icon: @image-url("icons/open_in_new.svg");
                            colorize-icon: true;
                            clicked => { Info.open-url(Info.releases-url); }
                        }
                    }
                    SettingRow {
                        label: Info.licenses;
                        desc: Info.licenses-desc;
                        AppButton {
                            text: Info.licenses;
                            icon: @image-url("icons/description.svg");
                            colorize-icon: true;
                            clicked => { Info.show-licenses(); }
                        }
                    }
                }
            }
        }
        EdgeFade {
            x: 0;
            width: parent.width - 14px;
            offset: about-scroll.content-y;
            content: about-scroll.content-height;
            view: about-scroll.visible-height;
            fade-color: M3.surface;
        }
    }
}

component LicensePage inherits VerticalLayout {
    // another licence: from its top
    property <string> shown: Info.lic-text;
    changed shown => { lic-scroll.content-y = 0; }
    spacing: 10px;
    HorizontalLayout {
        spacing: 8px;
        AppComboBox {
            horizontal-stretch: 1;
            max-width: 360px;
            y: (parent.height - self.height) / 2;
            model: Info.lic-names;
            current-index <=> Info.lic-index;
            selected => { Info.lic-picked(); }
        }
        AppButton {
            text: Info.open-folder;
            icon: @image-url("icons/folder_open.svg");
            colorize-icon: true;
            clicked => { Info.lic-open-folder(); }
        }
    }
    Text {
        text: Info.lic-desc;
        font-size: 12px * Type.scale;
        color: M3.on-surface-variant;
        wrap: word-wrap;
    }
    Rectangle {
        vertical-stretch: 1;
        border-radius: 16px;
        background: M3.surface-container-low;
        clip: true;
        // (in a layout, so the scroll view knows the text's height)
        lic-scroll := ScrollView {
            VerticalLayout {
                width: lic-scroll.visible-width;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                Text {
                    text: Info.lic-text;
                    font-family: Type.mono;
                    font-size: 12px * Type.scale;
                    color: M3.on-surface;
                    wrap: word-wrap;
                }
            }
        }
        EdgeFade {
            x: 0;
            width: parent.width - 14px;
            offset: lic-scroll.content-y;
            content: lic-scroll.content-height;
            view: lic-scroll.visible-height;
            fade-color: M3.surface-container-low;
        }
    }
}

// --- updates (Python ui/updater.py) ---

export global Upd {
    in property <string> status;
    in property <bool> busy;
    in property <bool> has-release;
    in property <string> title;
    in property <string> installed;
    in property <styled-text> notes;
    // "Download and install (12.3 MB)" or "Open the release page"
    in property <string> action;
    in-out property <bool> dialog;
    in-out property <bool> downloading;
    in property <float> progress;
    in property <string> progress-text;
    in property <string> file;
    in-out property <bool> ask-install;
    // texts
    in property <string> t-check;
    in property <string> t-details;
    in property <string> t-later;
    in property <string> t-downloading;
    in property <string> t-cancel;
    in property <string> t-install-title;
    in property <string> t-install-text;
    in property <string> t-install;
    callback check();
    callback act();
    callback cancel();
    callback install();
}

// a dialog over the window: a scrim and a rounded card
component Dialog inherits Rectangle {
    in property <length> card-width: 560px;
    background: #00000070;
    TouchArea { }
    Rectangle {
        width: min(parent.width - 64px, root.card-width);
        height: min(parent.height - 64px, dlg-lay.preferred-height);
        border-radius: 28px;
        background: M3.surface-container-high;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000060;
        dlg-lay := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            @children
        }
    }
}

// the colour picker (ColorPickerDialog): a hue ring around a square for the other two values of the chosen space
// (RGB: saturation x value, HSL: saturation x lightness, OKLCH: chroma x lightness), three sliders, and the
// colour as text in every form. The window process keeps the colour (colorpick.rs) and fills this in.
export global Pick {
    in-out property <bool> open;
    in property <string> title;
    in property <image> ring;
    in property <image> square;
    in property <float> hue;
    in property <float> square-x;
    in property <float> square-y;
    in property <int> space;
    in property <[string]> spaces: ["RGB", "HSL", "OKLCH"];
    in property <[float]> sliders: [0, 0, 0];
    in property <[string]> slider-labels: ["R", "G", "B"];
    in property <[string]> slider-values: ["", "", ""];
    in property <[image]> slider-images;
    in property <[string]> field-labels: ["HEX", "RGB", "HSL", "OKLCH", "Display P3"];
    in property <[string]> fields: ["", "", "", "", ""];
    in property <color> new-color;
    in property <color> old-color;
    in property <bool> wide;
    in property <bool> unseen;
    in property <string> t-wide: "Beyond sRGB: saved as an OKLCH colour (Display P3)";
    in property <string> t-unseen: "This monitor cannot show this colour exactly; it is drawn as the nearest one";
    in property <string> t-monitor;
    in property <string> t-cancel: "Cancel";
    in property <string> t-ok: "OK";
    callback ring-drag(float);
    callback square-drag(float, float);
    callback slider-drag(int, float);
    callback text(int, string);
    callback space-picked(int);
    callback ok();
    callback cancel();
}

component PickThumb inherits Rectangle {
    in property <color> fill: transparent;
    width: 20px;
    height: 20px;
    border-radius: self.width / 2;
    background: root.fill;
    border-width: 3px;
    border-color: white;
    drop-shadow-blur: 3px;
    drop-shadow-color: #00000080;
}

component ColorPickerDialog inherits Rectangle {
    // the wheel: the ring 22 wide, the square inside it
    property <length> wheel: 264px;
    property <length> thick: 22px;
    property <length> sq: (root.wheel / 2 - root.thick - 6px) * 1.414;
    if Pick.open: Dialog {
        card-width: 760px;
        Text { text: Pick.title; font-size: 22px * Type.scale; font-weight: 400; color: M3.on-surface; }
        HorizontalLayout {
            spacing: 28px;
            // left: the wheel, the space, its sliders
            VerticalLayout {
                width: root.wheel + 48px;
                spacing: 16px;
                HorizontalLayout {
                    alignment: center;
                    wheel-box := Rectangle {
                        width: root.wheel;
                        height: root.wheel;
                        // 1 = dragging on the ring, 2 = in the square
                        property <int> mode;
                        function drag(x: length, y: length) {
                            if self.mode == 1 {
                                Pick.ring-drag(atan2((y - self.height / 2) / 1px, (x - self.width / 2) / 1px) / 1deg);
                            } else if self.mode == 2 {
                                Pick.square-drag(
                                    (x - (self.width - root.sq) / 2) / root.sq, (y - (self.height - root.sq) / 2) / root.sq);
                            }
                        }
                        Image { width: 100%; height: 100%; source: Pick.ring; image-fit: fill; }
                        Rectangle {
                            x: (parent.width - root.sq) / 2;
                            y: (parent.height - root.sq) / 2;
                            width: root.sq;
                            height: root.sq;
                            border-radius: 8px;
                            clip: true;
                            Image { width: 100%; height: 100%; source: Pick.square; image-fit: fill; }
                        }
                        // the hue on the ring
                        PickThumb {
                            x: parent.width / 2 + (root.wheel / 2 - root.thick / 2) * cos(Pick.hue * 1deg) - self.width / 2;
                            y: parent.height / 2 + (root.wheel / 2 - root.thick / 2) * sin(Pick.hue * 1deg) - self.height / 2;
                        }
                        // the colour in the square
                        PickThumb {
                            width: 16px;
                            height: 16px;
                            fill: Pick.new-color;
                            x: (parent.width - root.sq) / 2 + Pick.square-x * root.sq - self.width / 2;
                            y: (parent.height - root.sq) / 2 + Pick.square-y * root.sq - self.height / 2;
                        }
                        TouchArea {
                            mouse-cursor: crosshair;
                            pointer-event(e) => {
                                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                    let dx = (self.mouse-x - parent.width / 2) / 1px;
                                    let dy = (self.mouse-y - parent.height / 2) / 1px;
                                    let r = sqrt(dx * dx + dy * dy) * 1px;
                                    parent.mode = r >= root.wheel / 2 - root.thick - 4px && r <= root.wheel / 2 + 2px ? 1
                                        : abs(dx * 1px) <= root.sq / 2 + 4px && abs(dy * 1px) <= root.sq / 2 + 4px ? 2 : 0;
                                    parent.drag(self.mouse-x, self.mouse-y);
                                } else if e.kind == PointerEventKind.up {
                                    parent.mode = 0;
                                }
                            }
                            moved => { parent.drag(self.mouse-x, self.mouse-y); }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Segmented {
                        items: Pick.spaces;
                        current: Pick.space;
                        picked => { Pick.space-picked(self.current); }
                    }
                }
                for value[i] in Pick.sliders: HorizontalLayout {
                    spacing: 12px;
                    height: 28px;
                    Text {
                        width: 16px;
                        text: Pick.slider-labels[i];
                        font-size: 13px * Type.scale;
                        font-weight: 700;
                        color: M3.on-surface-variant;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 14px;
                            border-radius: 7px;
                            clip: true;
                            border-width: 1px;
                            border-color: M3.outline-variant;
                            Image { width: 100%; height: 100%; source: Pick.slider-images[i]; image-fit: fill; }
                        }
                        PickThumb {
                            x: value * parent.width - self.width / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        TouchArea {
                            pointer-event(e) => {
                                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                    Pick.slider-drag(i, self.mouse-x / self.width);
                                }
                            }
                            moved => { Pick.slider-drag(i, self.mouse-x / self.width); }
                        }
                    }
                    Text {
                        width: 56px;
                        text: Pick.slider-values[i];
                        font-size: 13px * Type.scale;
                        font-family: Type.mono;
                        color: M3.on-surface;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
            // right: before / after, the colour as text, notes
            VerticalLayout {
                spacing: 12px;
                alignment: start;
                Rectangle {
                    height: 72px;
                    border-radius: 16px;
                    clip: true;
                    border-width: 1px;
                    border-color: M3.outline-variant;
                    HorizontalLayout {
                        Rectangle { background: Pick.old-color; }
                        Rectangle { background: Pick.new-color; }
                    }
                }
                for label[i] in Pick.field-labels: HorizontalLayout {
                    spacing: 12px;
                    Text {
                        width: 84px;
                        text: label;
                        font-size: 13px * Type.scale;
                        font-weight: 500;
                        color: M3.on-surface-variant;
                        vertical-alignment: center;
                    }
                    AppLineEdit {
                        horizontal-stretch: 1;
                        text: Pick.fields[i];
                        font-family: Type.mono;
                        accepted(t) => { Pick.text(i, t); }
                    }
                }
                if Pick.wide: Text {
                    text: Pick.t-wide;
                    font-size: 12px * Type.scale;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
                if Pick.unseen: Rectangle {
                    border-radius: 12px;
                    background: M3.amber-container;
                    height: unseen-text.preferred-height + 20px;
                    unseen-text := Text {
                        x: 12px;
                        width: parent.width - 24px;
                        text: Pick.t-unseen;
                        font-size: 12px * Type.scale;
                        color: M3.on-amber-container;
                        wrap: word-wrap;
                    }
                }
                Text {
                    text: Pick.t-monitor;
                    font-size: 12px * Type.scale;
                    color: M3.on-surface-variant;
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            AppButton { text: Pick.t-cancel; clicked => { Pick.cancel(); } }
            AppButton { text: Pick.t-ok; primary: true; clicked => { Pick.ok(); } }
        }
    }
}

component UpdateDialogs inherits Rectangle {
    if Upd.dialog: Dialog {
        card-width: 620px;
        Text { text: Upd.title; font-size: 20px * Type.scale; font-weight: 700; color: M3.on-surface; wrap: word-wrap; }
        Text { text: Upd.installed; font-size: 12px * Type.scale; color: M3.on-surface-variant; }
        Rectangle {
            // the notes' own height, at most 320 px (then they scroll)
            height: min(notes-text.preferred-height + 24px, 320px);
            border-radius: 16px;
            background: M3.surface-container-low;
            clip: true;
            notes-scroll-box := ScrollView {
                notes-text := StyledText {
                    x: 16px;
                    y: 12px;
                    width: notes-scroll-box.visible-width - 32px;
                    text: Upd.notes;
                    default-color: M3.on-surface;
                    default-font-size: 13px * Type.scale;
                    link-color: M3.primary;
                    link-clicked(link) => { Info.open-url(link); }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            AppButton { text: Upd.t-later; clicked => { Upd.dialog = false; } }
            AppButton {
                text: Upd.action;
                primary: true;
                clicked => {
                    Upd.dialog = false;
                    Upd.act();
                }
            }
        }
    }
    if Upd.downloading: Dialog {
        card-width: 480px;
        Text { text: Upd.t-downloading; font-size: 20px * Type.scale; font-weight: 700; color: M3.on-surface; }
        Text { text: Upd.file; font-size: 12px * Type.scale; color: M3.on-surface-variant; overflow: elide; }
        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: M3.surface-container-highest;
            Rectangle {
                x: 0;
                width: parent.width * max(0, min(1, Upd.progress));
                border-radius: 4px;
                background: M3.primary;
            }
        }
        Text { text: Upd.progress-text; font-size: 13px * Type.scale; color: M3.on-surface; }
        HorizontalLayout {
            alignment: end;
            AppButton { text: Upd.t-cancel; clicked => { Upd.cancel(); } }
        }
    }
    if Upd.ask-install: Dialog {
        card-width: 480px;
        Text { text: Upd.t-install-title; font-size: 20px * Type.scale; font-weight: 700; color: M3.on-surface; }
        Text { text: Upd.t-install-text; font-size: 14px * Type.scale; color: M3.on-surface; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            AppButton { text: Upd.t-later; clicked => { Upd.ask-install = false; } }
            AppButton {
                text: Upd.t-install;
                primary: true;
                clicked => {
                    Upd.ask-install = false;
                    Upd.install();
                }
            }
        }
    }
}

export component App inherits Window {
    // (a menu or drop-down list is never taller than the window: longer ones scroll)
    changed height => { Palette.window-height = self.height; }
    // canvas group sheets in M3 terms: a 36px title band, 24px corners, the theme's colours
    init => {
        Palette.window-height = self.height;
        GroupStyleDefaults.header-height = 36px;
        GroupStyleDefaults.border-radius = 24px;
        GroupStyleDefaults.title-font-size = 14px;
        GroupStyleDefaults.body-opacity = 0.14;
        GroupStyleDefaults.header-opacity = 0.55;
        GroupStyleDefaults.border-width-selected = 3px;
        GroupStyleDefaults.sheet-color = M3.primary;
        GroupStyleDefaults.border-color-selected = M3.primary;
        GroupStyleDefaults.title-color = M3.on-surface;
        // collapsed: only the stand-in block shows (it has the expand button), no band above it
        GroupStyleDefaults.collapsed-hidden = true;
        GroupStyleDefaults.collapse-icon = @image-url("icons/unfold_less.svg");
    }
    // canvas
    in property <[NodeData]> nodes;
    in property <[LinkData]> links <=> editor.links;
    // dots moving along the links that carry traffic (proxydock-ui.rs `flow_dots_tick`)
    in property <[FlowDot]> flow-dots;
    // a selected wireless pair (Python): its two halves (node ids, 0 = none), the others dimmed, a dotted arc
    in property <int> focus-a;
    in property <int> focus-b;
    in property <[FlowDot]> pair-dots;
    // links that carry a mix of colours: drawn dotted (Python: dashed)
    in property <[FlowDot]> mix-dots;
    // a block dragged over a group's box: the box it would become (world units), shown while it fits
    in property <bool> drop-show;
    in property <float> drop-x;
    in property <float> drop-y;
    in property <float> drop-w;
    in property <float> drop-h;
    // the colour palette (Python's swatch menu): open, where, what for, the colours and their names
    in-out property <bool> palette-open;
    in-out property <length> palette-x;
    in-out property <length> palette-y;
    in property <string> palette-title;
    in property <[color]> palette-colors;
    in property <[string]> palette-names;
    in property <int> palette-current: -1;
    in property <bool> palette-auto-current;
    in property <string> t-palette-auto: "Automatic (follow the incoming links)";
    in property <string> t-palette-custom: "Custom colour…";
    callback open-palette(int, string, length, length);
    // a colour picked: its index in the palette, -1 = automatic, -2 = a custom one
    callback palette-pick(int);
    in-out property <string> grid-commands <=> editor.grid-commands;
    out property <float> width_: editor.width / 1px;
    out property <float> height_: editor.height / 1px;
    in property <string> t-canvas: "Canvas";
    in property <string> t-add-inbound: "Inbound";
    in property <string> t-add-router: "Router";
    in property <string> t-add-relay: "Pass-through";
    in property <string> t-add-outbound: "Outbound";
    in property <string> t-delete: "Delete";
    in property <string> t-undo: "Undo";
    in property <string> t-redo: "Redo";
    in property <string> t-rename: "Rename";
    in property <string> t-duplicate: "Duplicate";
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <string> t-latency: "Test latency";
    // "Testing… 2/5" while a latency test runs
    in property <string> latency-progress;
    callback test-latency();
    // the saved theme: 0 the system's, 1 light, 2 dark
    in property <int> theme;
    changed theme => {
        Palette.color-scheme = self.theme == 1 ? ColorScheme.light : self.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    // the log's font size (px)
    in property <float> log-px: 12;
    // the title box of "Rename" (F2): open, and the text typed
    in-out property <bool> rename-open;
    // the box's title when it is not a rename ("Pair number"); "" = "Rename"
    in-out property <string> rename-title;
    in-out property <string> rename-text;
    callback undo();
    callback redo();
    callback rename-selected();
    callback rename-apply(string);
    callback duplicate-selected();
    changed rename-open => {
        if self.rename-open {
            rename-input.focus();
            rename-input.select-all();
        } else {
            editor.focus();
        }
    }
    // a refused edit's reason, shown for a few seconds
    in property <string> toast;
    // a button on the toast ("Restart now"), and what it does
    in property <string> toast-action;
    callback toast-clicked();
    // the page shown changed (the back / forward history follows it)
    callback page-changed(int);
    changed page => { root.page-changed(self.page); }
    // the toast is a plain message (a settings change), not a refusal
    in property <bool> toast-info;
    // a message in the editor (a button's result): text and whether it went well
    // world coordinates of the visible canvas centre (new blocks go there)
    out property <float> view-center-x: (editor.width / 2 - editor.pan-x) / editor.zoom / 1px;
    out property <float> view-center-y: (editor.height / 2 - editor.pan-y) / editor.zoom / 1px;
    callback add-block(int);
    // the canvas menus: add a block where the menu was opened (what, type, world x, y), a block's entry chosen,
    // fit everything into view
    callback canvas-add-at(string, string, float, float);
    callback node-action(int, string);
    callback canvas-fit();
    // where the empty-canvas menu was opened (world coordinates)
    function canvas-add(what: string, t: string) {
        root.canvas-add-at(what, t, (editor.pointer-x - editor.pan-x) / editor.zoom / 1px, (editor.pointer-y - editor.pan-y) / editor.zoom / 1px);
    }
    // the canvas view (fit sets them)
    in-out property <float> canvas-zoom <=> editor.zoom;
    in-out property <length> canvas-pan-x <=> editor.pan-x;
    in-out property <length> canvas-pan-y <=> editor.pan-y;
    // a question before something that cannot be taken back (delete): its text, and the answer yes
    in-out property <string> confirm-text;
    // the program picker (a router rule's "Choose..."): the running programs, a search, a program file
    in-out property <bool> picker-open;
    in property <[PickItem]> picker-items;
    in-out property <string> picker-search;
    in property <string> t-pick-title: "Choose programs";
    in property <string> t-pick-search: "Search running programs";
    in property <string> t-pick-file: "Choose a program file...";
    in property <string> t-pick-note: "Rules match the program's file name, so it does not need to be running now.";
    in property <string> t-add: "Add";
    callback picker-filter();
    callback picker-toggle(string);
    callback picker-browse();
    callback picker-done();
    in property <string> t-yes: "Delete";
    callback confirm-yes();
    // block editor (page 3)
    in property <[FieldRow]> form-fields;
    in property <string> form-title;
    in property <[string]> form-errors;
    in property <string> t-save: "Save";
    in property <string> t-cancel: "Cancel";
    callback edit-block(int);
    callback edit-card(string);
    callback copy-card(string);
    // the list page: outbound blocks and routers, an entry of a block's ⋯ menu, an IF's switch
    in property <[BlockRow]> out-rows;
    in property <[BlockRow]> router-rows;
    callback block-action(string, string);
    // the list page's add buttons (what, type or template number)
    callback list-add(string, string);
    callback set-switch(string, bool);
    // an arrow key on the canvas: "left" / "right" / "up" / "down"
    callback canvas-nav(string);
    // a wireless pair's number to change (the rename box)
    callback edit-number(int);
    // a card's "At start" / "Auto-restart" (its block's chips)
    callback set-flag(string, string, bool);
    // a canvas block's key by its node id
    pure callback node-key(int) -> string;
    in property <string> t-sec-inbound: "Inbound";
    in property <string> t-sec-outbound: "Outbound";
    in property <string> t-sec-routers: "Routers";
    in property <string> t-no-outbound: "No outbound blocks.";
    in property <string> t-new-proxy: "New proxy";
    in property <string> t-new-outbound: "New outbound";
    in property <string> t-copy: "Copy";
    callback field-changed(string, string);
    callback form-save();
    // the page title bar dragged / double-clicked (proxydock-ui.rs: winit moves the window)
    callback drag-window();
    callback toggle-maximized();
    callback form-pressed(string, int);
    // text to read or copy (a WireGuard device's config)
    in property <string> t-close: "Close";
    callback form-cancel();
    callback delete-selected();
    in property <string> t-no-graph: "";
    callback link-requested <=> editor.link-requested;
    callback link-dropped <=> editor.link-dropped;
    callback link-cancelled <=> editor.link-cancelled;
    callback node-selected <=> editor.node-selected;
    callback select-link <=> editor.select-link;
    callback selection-cleared <=> editor.selection-cleared;
    callback group-selected <=> editor.group-selected;
    // canvas groups (proxydock-ui.rs keeps them): the rows, the one selected, how many blocks are selected
    in property <[GroupData]> groups;
    // the list page's PC bar (Python `PcBar`): off | waiting | applied | error | unsupported, and its text
    in property <string> pc-state: "off";
    in property <string> pc-text;
    in property <string> t-pc: "PC (system proxy)";
    in property <string> t-pc-restore: "Restore previous";
    in property <string> t-pc-off: "Off (default)";
    callback pc-action(string);
    in property <int> group-sel: 0;
    in property <bool> group-sel-collapsed;
    in property <int> sel-count: 0;
    in property <string> t-group: "Group blocks";
    in property <string> t-ungroup: "Ungroup";
    in property <string> t-collapse: "Collapse";
    in property <string> t-expand: "Expand";
    in property <string> t-colour: "Colour";
    callback group-make();
    callback group-rename();
    callback group-color(length, length);
    callback group-collapse();
    callback ungroup();
    callback box-selection-committed <=> editor.box-selection-committed;
    callback compute-link-at <=> editor.compute-link-at;
    public function focus-editor() { editor.focus(); }

    in property <[CardRow]> cards;
    in property <[LogRow]> logs;
    in-out property <int> page: 0;
    in property <string> t-proxy: "Proxy";
    in property <string> t-logs: "Logs";
    in property <string> t-stats: "Statistics";
    in property <string> t-home: "Home";
    in property <string> t-help: "How to use";
    in property <string> t-about: "About";
    in property <string> t-conn: "Connection test";
    in property <string> t-stop-all: "Stop all proxies";
    in property <string> t-empty: "No proxies yet.";
    out property <bool> dark: M3.dark;
    out property <color> caption-color: M3.surface-container;
    out property <color> caption-text: M3.on-surface;
    callback toggle(string);
    callback stop-all();
    // a connection's log line clicked (card id, message): its way is shown on the canvas
    callback log-route(string, string);
    // light / dark switched: the title bar colours follow
    callback theme-changed();
    changed dark => {
        root.theme-changed();
        GroupStyleDefaults.sheet-color = M3.primary;
        GroupStyleDefaults.border-color-selected = M3.primary;
        GroupStyleDefaults.title-color = M3.on-surface;
    }
    // the log follows new lines (scroll position kept while reading back is for later)
    in property <int> log-count;
    // new lines are followed only while the log is at its end (reading back stays where it is)
    property <bool> log-follow: true;
    changed log-count => {
        if root.log-follow {
            log-view.content-y = min(0px, log-view.visible-height - log-view.content-height);
        }
    }
    // the log's filters (proxydock-ui.rs applies them): the card ("" = all), the level group, the words
    in property <[string]> log-sources;
    in-out property <int> log-source;
    in property <[string]> log-levels;
    in-out property <int> log-level;
    in-out property <string> log-search;
    in property <string> t-search: "Search";
    in property <string> t-copy-log: "Copy";
    in property <string> t-clear-log: "Clear";
    callback log-filter();
    callback log-copy();
    callback log-clear();

    // settings and the app's help, about and licences: one page, a category list on the left
    property <bool> in-settings: root.page == 4 || (root.page >= 7 && root.page <= 9);
    in-out property <int> settings-cat: 0;
    property <[SettingsCat]> cats: [
        { label: Settings.text.title, header: true, show: true },
        { label: Settings.text.cat-defaults, icon: @image-url("icons/tune.svg"), page: 4, cat: 0, show: true },
        { label: Settings.text.cat-startup, icon: @image-url("icons/power_settings_new.svg"), page: 4, cat: 1, show: Settings.startup-supported },
        { label: Settings.text.firewall, icon: @image-url("icons/shield.svg"), page: 4, cat: 2, show: Settings.windows },
        { label: Settings.text.updates, icon: @image-url("icons/sync.svg"), page: 4, cat: 3, show: true },
        { label: Settings.text.display, icon: @image-url("icons/palette.svg"), page: 4, cat: 4, show: true },
        { label: Settings.text.fonts, icon: @image-url("icons/text_fields.svg"), page: 4, cat: 5, show: true },
        { label: Settings.text.engine, icon: @image-url("icons/memory.svg"), page: 4, cat: 6, show: true },
        { label: Settings.text.logs, icon: @image-url("icons/receipt_long.svg"), page: 4, cat: 7, show: true },
        { label: Bypass.text.title, icon: @image-url("icons/alt_route.svg"), page: 4, cat: 8, show: true },
        { label: "ProxyDock", header: true, show: true },
        { label: root.t-help, icon: @image-url("icons/help.svg"), page: 7, show: true },
        { label: root.t-about, icon: @image-url("icons/info.svg"), page: 8, show: true },
        { label: Info.licenses, icon: @image-url("icons/description.svg"), page: 9, show: true },
    ];
    property <string> page-title: root.page == 0 ? root.t-canvas : root.page == 1 ? root.t-proxy : root.page == 2 ? root.t-logs
        : root.page == 3 ? root.form-title : root.page == 4 ? root.cats[root.settings-cat + 1].label
        : root.page == 5 ? Stats.title : root.page == 6 ? Conn.title : root.page == 10 ? root.t-home
        : root.page == 7 ? root.cats[11].label : root.page == 8 ? root.cats[12].label : root.page == 9 ? root.cats[13].label : "";
    // the title bar (M3 small top app bar): 64 high, the page's title (Title Large), its actions on the right
    out property <length> bar-h: max(64px, 22px * Type.scale * 2.4);
    // the page title bar's empty part, from the rail to the page's actions (Windows 11: a caption, see `caption`)
    out property <length> drag-left: root.rail-w + 24px;
    out property <length> drag-right: root.merged-bar
        ? root.width - root.own-buttons-w - 12px - title-acts.preferred-width
        : root.rail-w + 24px + title-acts.width - title-acts.preferred-width - 12px;
    // the navigation rail's width (M3 Expressive collapsed rail)
    out property <length> rail-w: 96px;
    // every page's content (not the title bar, not the canvas) is at most this wide, in the middle of the room
    property <length> content-max: 1040px;

    title: "ProxyDock";
    icon: @image-url("icons/app.svg");
    preferred-width: 980px;
    preferred-height: 680px;
    // the smallest window: 854 x 480 on the screen as a game's default window (16:9), whatever the
    // "App scale" (`app-zoom`, proxydock-ui.rs); a large app scale keeps what the rail and the pages need
    in property <float> app-zoom: 1;
    min-width: max(854px / root.app-zoom, 560px);
    min-height: max(480px / root.app-zoom, 476px);
    background: M3.surface-container;
    // the language's usual UI font ("" = the system's; proxydock-ui.rs `lang_font`)
    in property <string> ui-font;
    default-font-family: root.ui-font;

    // the window's own title bar (proxydock-ui.rs `caption`, Windows 11): its height (0 = Windows draws its
    // own), the button under the mouse / pressed (1 minimise, 2 maximise, 3 close), the window's state
    in property <length> caption-h: 0px;
    // one bar for the app and the page (Windows 11's own bar, macOS' transparent one): the page's title and
    // its icon buttons in it, no page title bar below. own-buttons: minimise / maximise / close drawn here
    // (Windows 11); caption-inset: room on the left (macOS' window buttons)
    in property <bool> merged-bar;
    in property <bool> own-buttons: true;
    in property <length> caption-inset: 0px;
    property <length> page-bar-h: root.merged-bar ? 0px : root.bar-h;
    // merged bar: a wide window has the list, log, statistics and connection test buttons over the page (with
    // their text); a narrow one keeps them in the bar as icons, and a very narrow one drops the page's title there
    property <bool> acts-in-content: root.merged-bar && root.width >= 900px
        && (root.page == 1 || root.page == 2 || root.page == 5 || root.page == 6);
    property <bool> bar-title: root.width >= 560px;
    property <length> own-buttons-w: root.own-buttons ? 3 * 46px : 0px;
    in property <int> caption-hover;
    in property <int> caption-pressed;
    in property <bool> win-maximized;
    in property <bool> window-active: true;

    // (placed: the window's minimum size is set above, not taken from the pages)
    HorizontalLayout {
        x: 0;
        y: root.caption-h;
        width: root.width;
        height: root.height - root.caption-h;
        // navigation rail
        VerticalLayout {
            width: root.rail-w;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 4px;
            RailItem {
                icon: @image-url("icons/home.svg");
                label: root.t-home;
                active: root.page == 10;
                clicked => { root.page = 10; }
            }
            RailItem {
                icon: @image-url("icons/account_tree.svg");
                label: root.t-canvas;
                active: root.page == 0;
                clicked => { root.page = 0; }
            }
            RailItem {
                icon: @image-url("icons/dns.svg");
                label: root.t-proxy;
                active: root.page == 1;
                clicked => { root.page = 1; }
            }
            RailItem {
                icon: @image-url("icons/monitoring.svg");
                label: root.t-stats;
                active: root.page == 5;
                clicked => { root.page = 5; }
            }
            RailItem {
                icon: @image-url("icons/network_check.svg");
                label: root.t-conn;
                active: root.page == 6;
                clicked => { root.page = 6; }
            }
            RailItem {
                icon: @image-url("icons/receipt_long.svg");
                label: root.t-logs;
                active: root.page == 2;
                clicked => { root.page = 2; }
            }
            Rectangle { vertical-stretch: 1; }
            RailItem {
                icon: @image-url("icons/settings.svg");
                label: Settings.text.title;
                active: root.in-settings;
                clicked => { root.page = 4; }
            }
        }
        VerticalLayout {
        // the title bar above the page (its title and actions are drawn over it, below)
        Rectangle {
            height: root.page-bar-h;
        }
        // page container
        Rectangle {
            border-radius: 28px;
            background: M3.surface;
            clip: true;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                // the page's buttons over it (a wide window with the merged bar)
                // (as wide as the page under them: a wide window centres the page at its widest)
                if root.acts-in-content: Rectangle {
                    height: 40px;
                    min-width: 0px;
                    PageActions {
                        width: min(parent.width, root.content-max);
                        x: (parent.width - self.width) / 2;
                        height: 40px;
                        page: root.page;
                        has-cards: root.cards.length > 0;
                        t-stop-all: root.t-stop-all;
                        t-cancel: root.t-cancel;
                        t-save: root.t-save;
                        stop-all => { root.stop-all(); }
                        cancel => { root.form-cancel(); }
                        save => { root.form-save(); }
                        t-new-proxy: root.t-new-proxy;
                        t-new-outbound: root.t-new-outbound;
                        add(what, t) => { root.list-add(what, t); }
                        t-copy-log: root.t-copy-log;
                        t-clear-log: root.t-clear-log;
                        log-copy => { root.log-copy(); }
                        log-clear => { root.log-clear(); }
                    }
                }
                // both pages stay (the log keeps its scroll position); the hidden one is not drawn
                // (hidden pages still count in a layout: no minimum here, so the widest page cannot make every
                // page wider than the window)
                Rectangle {
                    min-width: 0px;
                    min-height: 0px;
                    // canvas: edge to edge in the page container
                    Rectangle {
                        x: -24px;
                        y: -24px;
                        width: parent.width + 48px;
                        height: parent.height + 48px;
                        visible: root.page == 0;
                        FocusScope {
                            width: 100%;
                            height: 100%;
                            // Python canvas shortcuts: Delete, F2, Ctrl+D, Ctrl+Z, Ctrl+Y / Ctrl+Shift+Z
                            key-pressed(event) => {
                                if event.text == Key.Delete {
                                    root.delete-selected();
                                    return accept;
                                }
                                // arrows follow the links (Python `nav_key`)
                                if event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == Key.DownArrow {
                                    root.canvas-nav(event.text == Key.LeftArrow ? "left" : event.text == Key.RightArrow ? "right" : event.text == Key.UpArrow ? "up" : "down");
                                    return accept;
                                }
                                if event.text == Key.F2 {
                                    root.rename-selected();
                                    return accept;
                                }
                                if event.modifiers.control && !event.modifiers.alt {
                                    if event.text == "d" || event.text == "D" {
                                        root.duplicate-selected();
                                        return accept;
                                    }
                                    if event.text == "g" || event.text == "G" {
                                        root.group-make();
                                        return accept;
                                    }
                                    if ((event.text == "z" || event.text == "Z") && event.modifiers.shift) || event.text == "y" || event.text == "Y" {
                                        root.redo();
                                        return accept;
                                    }
                                    if event.text == "z" || event.text == "Z" {
                                        root.undo();
                                        return accept;
                                    }
                                }
                                reject
                            }
                        // the empty canvas's right-click menu: add blocks where it was clicked, fit, test, undo
                        canvas-menu := ContextMenuArea {
                            width: 100%;
                            height: 100%;
                            Menu {
                                Menu {
                                    title: CanvasText.add-inbound;
                                    for t in CanvasText.inbounds: MenuItem {
                                        title: t.title;
                                        activated => { root.canvas-add("inbound", t.action); }
                                    }
                                }
                                Menu {
                                    title: CanvasText.add-outbound;
                                    MenuItem {
                                        title: CanvasText.from-link;
                                        activated => { root.canvas-add("link", ""); }
                                    }
                                    MenuSeparator {}
                                    for t in CanvasText.outbounds: MenuItem {
                                        title: t.title;
                                        activated => { root.canvas-add("outbound", t.action); }
                                    }
                                }
                                Menu {
                                    title: CanvasText.add-router;
                                    MenuItem {
                                        title: CanvasText.router;
                                        activated => { root.canvas-add("router", ""); }
                                    }
                                    MenuItem {
                                        title: CanvasText.if-block;
                                        activated => { root.canvas-add("if", ""); }
                                    }
                                    MenuItem {
                                        title: CanvasText.relay;
                                        activated => { root.canvas-add("relay", ""); }
                                    }
                                    MenuItem {
                                        title: CanvasText.wireless;
                                        activated => { root.canvas-add("wireless", ""); }
                                    }
                                }
                                MenuSeparator {}
                                MenuItem {
                                    title: CanvasText.fit;
                                    activated => { root.canvas-fit(); }
                                }
                                MenuItem {
                                    title: CanvasText.latency;
                                    activated => { root.test-latency(); }
                                }
                                MenuSeparator {}
                                MenuItem {
                                    title: CanvasText.undo;
                                    enabled: root.can-undo;
                                    activated => { root.undo(); }
                                }
                                MenuItem {
                                    title: CanvasText.redo;
                                    enabled: root.can-redo;
                                    activated => { root.redo(); }
                                }
                            }
                        editor := NodeEditor {
                            width: 100%;
                            height: 100%;
                            has-link-selection: true;
                            groups: root.groups;
                            // the software renderer keeps rectangle sizes in i16: a smaller world than the default
                            world-content-size: 8000px;
                            max-zoom: 2.0;
                            // over the links, under the blocks
                            for d in root.flow-dots: Rectangle {
                                x: (d.x - d.size / 2) * 1px;
                                y: (d.y - d.size / 2) * 1px;
                                width: d.size * 1px;
                                height: d.size * 1px;
                                border-radius: d.size / 2 * 1px;
                                background: d.color;
                            }
                            // (animated: it grows to take the block in, and back when the drag goes elsewhere)
                            Rectangle {
                                x: root.drop-x * 1px;
                                y: root.drop-y * 1px;
                                width: root.drop-w * 1px;
                                height: root.drop-h * 1px;
                                opacity: root.drop-show ? 1 : 0;
                                border-radius: 24px;
                                border-width: 3px;
                                border-color: M3.primary;
                                background: M3.primary.with-alpha(0.10);
                                animate x, y, width, height { duration: 220ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                animate opacity { duration: 150ms; }
                            }
                            for d in root.mix-dots: Rectangle {
                                x: (d.x - d.size / 2) * 1px;
                                y: (d.y - d.size / 2) * 1px;
                                width: d.size * 1px;
                                height: d.size * 1px;
                                border-radius: d.size / 2 * 1px;
                                background: d.color;
                            }
                            for d in root.pair-dots: Rectangle {
                                x: (d.x - d.size / 2) * 1px;
                                y: (d.y - d.size / 2) * 1px;
                                width: d.size * 1px;
                                height: d.size * 1px;
                                border-radius: d.size / 2 * 1px;
                                background: d.color;
                            }
                            for node in root.nodes: ProxyNode {
                                opacity: root.focus-a != 0 && node.id != root.focus-a && node.id != root.focus-b ? 0.35 : 1;
                                node-id: node.id;
                                title: node.title;
                                detail: node.detail;
                                kind: node.kind;
                                ins: node.ins;
                                outs: node.outs;
                                in-labels: node.in-labels;
                                out-labels: node.out-labels;
                                lines: node.lines;
                                state-text: node.state-text;
                                autostart: node.autostart;
                                auto-restart: node.auto-restart;
                                has-switch: node.has-switch;
                                switch-on: node.switch-on;
                                set-flag(k, on) => { root.set-flag(node.card, k, on); }
                                swatch: node.swatch;
                                own-color: node.own-color;
                                group-id: node.group-id;
                                fill: node.fill;
                                out-colors: node.out-colors;
                                pick-color(out, x, y) => { root.open-palette(node.id, out, x, y); }
                                edit-number => { root.edit-number(node.id); }
                                set-switch(on) => { root.set-switch(root.node-key(node.id), on); }
                                wires: node.wires;
                                routed: node.routed;
                                open: node.open;
                                state: node.state;
                                rate: node.rate;
                                badge: node.badge;
                                badge-tone: node.badge-tone;
                                toggle => { root.toggle(node.card); }
                                edit => { root.edit-block(node.id); }
                                menu: node.menu;
                                menu-sub-title: node.menu-sub-title;
                                menu-sub: node.menu-sub;
                                menu-cut: node.menu-cut;
                                menu-tail: node.menu-tail;
                                menu-action(a) => { root.node-action(node.id, a); }
                                world-x: node.x * 1px;
                                world-y: node.y * 1px;
                                selected: node.selected;
                            }
                        }
                        }
                        }
                        if root.nodes.length == 0: Text {
                            text: root.t-no-graph;
                            color: M3.on-surface-variant;
                            font-size: 15px * Type.scale;
                        }
                        // M3 Expressive floating toolbar
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: parent.height - self.height - 24px;
                            width: bar.preferred-width;
                            height: 64px;
                            border-radius: 32px;
                            background: M3.surface-container-high;
                            drop-shadow-blur: 10px;
                            drop-shadow-offset-y: 3px;
                            drop-shadow-color: #00000040;
                            bar := HorizontalLayout {
                                padding: 8px;
                                spacing: 4px;
                                if !tool-row.only-more: ToolbarButton { text: root.t-add-inbound; icon: @image-url("icons/login.svg"); compact: tool-row.add-compact; clicked => { root.add-block(0); } }
                                if !tool-row.only-more: ToolbarButton { text: root.t-add-router; icon: @image-url("icons/alt_route.svg"); compact: tool-row.add-compact; clicked => { root.add-block(1); } }
                                if !tool-row.only-more: ToolbarButton { text: root.t-add-relay; icon: @image-url("icons/swap_horiz.svg"); compact: tool-row.add-compact; clicked => { root.add-block(3); } }
                                if !tool-row.only-more: ToolbarButton { text: root.t-add-outbound; icon: @image-url("icons/logout.svg"); compact: tool-row.add-compact; clicked => { root.add-block(2); } }
                                if !tool-row.only-more: Rectangle { width: 1px; background: M3.outline-variant; }
                                if !tool-row.overflow: ToolbarButton { text: root.t-undo; icon: @image-url("icons/undo.svg"); compact: tool-row.all-compact; enabled: root.can-undo; clicked => { root.undo(); } }
                                if !tool-row.overflow: ToolbarButton { text: root.t-redo; icon: @image-url("icons/redo.svg"); compact: tool-row.all-compact; enabled: root.can-redo; clicked => { root.redo(); } }
                                if !tool-row.overflow: ToolbarButton { text: root.t-rename; icon: @image-url("icons/edit.svg"); compact: tool-row.all-compact; clicked => { root.rename-selected(); } }
                                if !tool-row.overflow: ToolbarButton { text: root.t-duplicate; icon: @image-url("icons/content_copy.svg"); compact: tool-row.all-compact; clicked => { root.duplicate-selected(); } }
                                if !tool-row.overflow: ToolbarButton { text: root.t-group; icon: @image-url("icons/account_tree.svg"); compact: tool-row.all-compact; enabled: root.sel-count >= 2; clicked => { root.group-make(); } }
                                if !tool-row.overflow: ToolbarButton {
                                    text: root.latency-progress != "" ? root.latency-progress : root.t-latency;
                                    icon: @image-url("icons/speed.svg");
                                    compact: tool-row.all-compact && root.latency-progress == "";
                                    enabled: root.latency-progress == "";
                                    clicked => { root.test-latency(); }
                                }
                                if !tool-row.overflow: ToolbarButton { text: root.t-delete; icon: @image-url("icons/delete.svg"); compact: tool-row.all-compact; filled: true; clicked => { root.delete-selected(); } }
                                // no room: the rest in a menu (and with even less, everything)
                                if tool-row.overflow: ToolbarButton {
                                    icon: @image-url("icons/more_vert.svg");
                                    compact: true;
                                    clicked => {
                                        more-menu.show({
                                            x: self.absolute-position.x - more-menu.absolute-position.x,
                                            y: self.absolute-position.y - more-menu.absolute-position.y - 8px,
                                        });
                                    }
                                }
                            }
                            more-menu := ContextMenuArea {
                                x: 0;
                                y: 0;
                                width: 0;
                                height: 0;
                                Menu {
                                    if tool-row.only-more: MenuItem { title: root.t-add-inbound; activated => { root.add-block(0); } }
                                    if tool-row.only-more: MenuItem { title: root.t-add-router; activated => { root.add-block(1); } }
                                    if tool-row.only-more: MenuItem { title: root.t-add-relay; activated => { root.add-block(3); } }
                                    if tool-row.only-more: MenuItem { title: root.t-add-outbound; activated => { root.add-block(2); } }
                                    if tool-row.only-more: MenuSeparator {}
                                    MenuItem { title: root.t-undo; enabled: root.can-undo; activated => { root.undo(); } }
                                    MenuItem { title: root.t-redo; enabled: root.can-redo; activated => { root.redo(); } }
                                    MenuItem { title: root.t-rename; activated => { root.rename-selected(); } }
                                    MenuItem { title: root.t-duplicate; activated => { root.duplicate-selected(); } }
                                    MenuItem { title: root.t-group; enabled: root.sel-count >= 2; activated => { root.group-make(); } }
                                    MenuItem {
                                        title: root.latency-progress != "" ? root.latency-progress : root.t-latency;
                                        enabled: root.latency-progress == "";
                                        activated => { root.test-latency(); }
                                    }
                                    MenuSeparator {}
                                    MenuItem { title: root.t-delete; activated => { root.delete-selected(); } }
                                }
                            }
                        }
                        // the toolbar's widths with and without text: the buttons drop their text when it does not fit
                        tool-row := Rectangle {
                            visible: false;
                            property <length> room: parent.width - 48px;
                            out property <bool> add-compact: full.preferred-width > self.room;
                            out property <bool> all-compact: mid.preferred-width > self.room;
                            // all icons do not fit: the actions go to a menu; the adds and that menu neither: all
                            out property <bool> overflow: icons.preferred-width > self.room;
                            out property <bool> only-more: adds-more.preferred-width > self.room;
                            icons := HorizontalLayout {
                                padding: 8px;
                                spacing: 4px;
                                for i in 4: ToolbarButton { compact: true; }
                                Rectangle { width: 1px; }
                                for i in 7: ToolbarButton { compact: true; }
                            }
                            adds-more := HorizontalLayout {
                                padding: 8px;
                                spacing: 4px;
                                for i in 4: ToolbarButton { compact: true; }
                                Rectangle { width: 1px; }
                                ToolbarButton { compact: true; }
                            }
                            full := HorizontalLayout {
                                padding: 8px;
                                spacing: 4px;
                                ToolbarButton { text: root.t-add-inbound; }
                                ToolbarButton { text: root.t-add-router; }
                                ToolbarButton { text: root.t-add-relay; }
                                ToolbarButton { text: root.t-add-outbound; }
                                Rectangle { width: 1px; }
                                ToolbarButton { text: root.t-undo; }
                                ToolbarButton { text: root.t-redo; }
                                ToolbarButton { text: root.t-rename; }
                                ToolbarButton { text: root.t-duplicate; }
                                ToolbarButton { text: root.t-group; }
                                ToolbarButton { text: root.t-latency; }
                                ToolbarButton { text: root.t-delete; }
                            }
                            mid := HorizontalLayout {
                                padding: 8px;
                                spacing: 4px;
                                for i in 4: ToolbarButton { compact: true; }
                                Rectangle { width: 1px; }
                                ToolbarButton { text: root.t-undo; }
                                ToolbarButton { text: root.t-redo; }
                                ToolbarButton { text: root.t-rename; }
                                ToolbarButton { text: root.t-duplicate; }
                                ToolbarButton { text: root.t-group; }
                                ToolbarButton { text: root.t-latency; }
                                ToolbarButton { text: root.t-delete; }
                            }
                        }
                        // a selected group: its own floating bar above the toolbar (rename, colour, collapse, ungroup)
                        if root.group-sel != 0: Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: parent.height - 64px - 24px - self.height - 12px;
                            width: gbar.preferred-width;
                            height: 64px;
                            border-radius: 32px;
                            background: M3.secondary-container;
                            drop-shadow-blur: 10px;
                            drop-shadow-offset-y: 3px;
                            drop-shadow-color: #00000040;
                            gbar := HorizontalLayout {
                                padding: 8px;
                                spacing: 4px;
                                ToolbarButton { text: root.t-rename; icon: @image-url("icons/edit.svg"); clicked => { root.group-rename(); } }
                                ToolbarButton {
                                    text: root.t-colour;
                                    icon: @image-url("icons/palette.svg");
                                    clicked => { root.group-color(self.absolute-position.x, self.absolute-position.y - 220px); }
                                }
                                ToolbarButton {
                                    text: root.group-sel-collapsed ? root.t-expand : root.t-collapse;
                                    icon: @image-url("icons/expand_more.svg");
                                    clicked => { root.group-collapse(); }
                                }
                                ToolbarButton { text: root.t-ungroup; icon: @image-url("icons/remove.svg"); clicked => { root.ungroup(); } }
                            }
                        }
                    }
                    VerticalLayout {
                        visible: root.page == 1;
                        width: min(parent.width, root.content-max);
                        x: (parent.width - self.width) / 2;
                        spacing: 12px;
                        Rectangle {
                            vertical-stretch: 1;
                            card-list := ScrollView {
                                VerticalLayout {
                                    width: card-list.visible-width - 16px;
                                    padding-right: 16px;
                                    padding-bottom: 24px;
                                    alignment: start;
                                    spacing: 8px;
                                    // inbound blocks (the cards)
                                    // PC (system proxy): its state, "Restore previous", "Off (default)"
                                    Rectangle {
                                        height: max(72px, pc-lay.preferred-height);
                                        border-radius: 16px;
                                        background: M3.surface-container;
                                        pc-lay := HorizontalLayout {
                                            padding-left: 20px;
                                            padding-right: 16px;
                                            padding-top: 12px;
                                            padding-bottom: 12px;
                                            spacing: 16px;
                                            Rectangle {
                                                width: 12px;
                                                height: 12px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 6px;
                                                background: root.pc-state == "applied" ? #2e9e4f : root.pc-state == "waiting" ? #c99a06
                                                    : root.pc-state == "error" ? #c42b1c : #8a8a8a;
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: root.t-pc;
                                                    font-size: 16px * Type.scale;
                                                    color: M3.on-surface;
                                                }
                                                Text {
                                                    text: root.pc-text;
                                                    font-size: 14px * Type.scale;
                                                    color: M3.on-surface-variant;
                                                    wrap: word-wrap;
                                                }
                                            }
                                            AppButton {
                                                y: (parent.height - self.height) / 2;
                                                icon-only: card-list.visible-width < 560px;
                                                text: root.t-pc-restore;
                                                icon: @image-url("icons/undo.svg");
                                                enabled: root.pc-state != "unsupported";
                                                clicked => { root.pc-action("restore"); }
                                            }
                                            AppButton {
                                                y: (parent.height - self.height) / 2;
                                                icon-only: card-list.visible-width < 560px;
                                                text: root.t-pc-off;
                                                icon: @image-url("icons/power_settings_new.svg");
                                                enabled: root.pc-state != "unsupported";
                                                clicked => { root.pc-action("off"); }
                                            }
                                        }
                                    }
                                    ListTitle { text: root.t-sec-inbound; }
                                    if root.cards.length == 0: Text {
                                        text: root.t-empty;
                                        color: M3.on-surface-variant;
                                        font-size: 14px * Type.scale;
                                        wrap: word-wrap;
                                    }
                                    for c in root.cards: Card {
                                        card: c;
                                        narrow: card-list.visible-width < 560px;
                                        toggle(id) => { root.toggle(id); }
                                        edit(id) => { root.edit-card(id); }
                                        copy(id) => { root.copy-card(id); }
                                        menu-action(key, a) => { root.block-action(key, a); }
                                        t-copy: root.t-copy;
                                    }
                                    // outbound blocks
                                    ListTitle { text: root.t-sec-outbound; }
                                    if root.out-rows.length == 0: Text {
                                        text: root.t-no-outbound;
                                        color: M3.on-surface-variant;
                                        font-size: 14px * Type.scale;
                                    }
                                    for b in root.out-rows: BlockCard {
                                        block: b;
                                        open(key) => { root.edit-card(key); }
                                        menu-action(key, a) => { root.block-action(key, a); }
                                    }
                                    // routers and IFs
                                    if root.router-rows.length > 0: ListTitle { text: root.t-sec-routers; }
                                    for b in root.router-rows: BlockCard {
                                        block: b;
                                        open(key) => { root.edit-card(key); }
                                        switched(key, on) => { root.set-switch(key, on); }
                                        menu-action(key, a) => { root.block-action(key, a); }
                                    }
                                }
                            }
                            EdgeFade {
                                // (not over the scroll bar)
                                x: 0;
                                width: parent.width - 14px;
                                offset: card-list.content-y;
                                content: card-list.content-height;
                                view: card-list.visible-height;
                                fade-color: M3.surface;
                            }
                        }
                    }
                    form-page := VerticalLayout {
                        visible: root.page == 3;
                        width: min(parent.width, root.content-max);
                        x: (parent.width - self.width) / 2;
                        spacing: 12px;
                        if root.form-errors.length > 0: Rectangle {
                            border-radius: 12px;
                            background: M3.error-container;
                            height: errs.preferred-height + 28px;
                            errs := VerticalLayout {
                                x: 16px;
                                y: 14px;
                                spacing: 4px;
                                width: parent.width - 32px;
                                for e in root.form-errors: Text {
                                    font-size: 14px * Type.scale;
                                    text: "• " + e;
                                    color: M3.on-error-container;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            form-scroll := ScrollView {
                                VerticalLayout {
                                    padding-right: 16px;
                                    padding-bottom: 24px;
                                    for f in root.form-fields: FormRow {
                                        f: f;
                                        visible: f.visible;
                                        height: f.visible ? self.preferred-height : 0px;
                                        changed(k, v) => { root.field-changed(k, v); }
                                        pressed(k, i) => { root.form-pressed(k, i); }
                                    }
                                }
                            }
                            EdgeFade {
                                // (not over the scroll bar)
                                x: 0;
                                width: parent.width - 14px;
                                offset: form-scroll.content-y;
                                content: form-scroll.content-height;
                                view: form-scroll.visible-height;
                                fade-color: M3.surface;
                            }
                        }
                    }
                    home-scroll := ScrollView {
                        visible: root.page == 10;
                        width: min(parent.width, root.content-max);
                        x: (parent.width - self.width) / 2;
                        HomePage {
                            width: home-scroll.visible-width - 16px;
                            open-page(p) => { root.page = p; }
                            open-vms => {
                                root.page = 4;
                                root.settings-cat = 8;
                            }
                        }
                    }
                    stats-page := StatsPage {
                        visible: root.page == 5;
                        width: min(parent.width, root.content-max);
                        x: (parent.width - self.width) / 2;
                        y: 0;
                    }
                    conn-page := ConnPage {
                        visible: root.page == 6;
                        width: min(parent.width, root.content-max);
                        x: (parent.width - self.width) / 2;
                        y: 0;
                    }
                    // settings: the categories (and the app's help, about, licences) on the left, the chosen one on the right
                    settings-shell := Rectangle {
                        visible: root.in-settings;
                        width: min(parent.width, root.content-max);
                        x: (parent.width - self.width) / 2;
                        // only the icons when narrow
                        property <bool> narrow: self.width < 720px;
                        out property <length> cat-w: self.narrow ? 56px : 232px;
                        cat-scroll := ScrollView {
                            x: 0;
                            y: 0;
                            width: parent.cat-w;
                            height: parent.height;
                            VerticalLayout {
                                width: cat-scroll.visible-width;
                                alignment: start;
                                spacing: 2px;
                                padding-bottom: 12px;
                                for c in root.cats: CatItem {
                                    item: c;
                                    compact: settings-shell.narrow;
                                    active: !c.header && root.page == c.page && (c.page != 4 || root.settings-cat == c.cat);
                                    clicked => {
                                        root.page = c.page;
                                        if c.page == 4 {
                                            root.settings-cat = c.cat;
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: parent.cat-w + 24px;
                            width: parent.width - self.x;
                            // the chosen settings
                            Rectangle {
                                visible: root.page == 4;
                                settings-scroll := ScrollView {
                                    // (a readable width)
                                    out property <length> used-w: min(self.visible-width - 16px, 760px);
                                    VerticalLayout {
                                        width: settings-scroll.used-w + 16px;
                                        padding-right: 16px;
                                        // room for the apply bar
                                        padding-bottom: 96px;
                                        alignment: start;
                                        if root.settings-cat == 0: SettingsDefaults {}
                                        if root.settings-cat == 1: SettingsStartup {}
                                        if root.settings-cat == 2: SettingsFirewall {}
                                        if root.settings-cat == 3: SettingsUpdates {}
                                        if root.settings-cat == 4: SettingsDisplay {}
                                        if root.settings-cat == 5: SettingsFonts {}
                                        if root.settings-cat == 6: SettingsEngine {}
                                        if root.settings-cat == 7: SettingsLogs {}
                                        if root.settings-cat == 8: SettingsBypass {}
                                    }
                                }
                                EdgeFade {
                                    // (not over the scroll bar)
                                    x: 0;
                                    width: parent.width - 14px;
                                    offset: settings-scroll.content-y;
                                    content: settings-scroll.content-height;
                                    view: settings-scroll.visible-height;
                                    fade-color: M3.surface;
                                }
                            }
                            // (as tall as the room: they scroll inside)
                            help-page := HelpPage {
                                visible: root.page == 7;
                                x: 0;
                                width: min(parent.width, 776px);
                                height: parent.height;
                            }
                            about-page := AboutPage {
                                visible: root.page == 8;
                                x: 0;
                                width: min(parent.width, 776px);
                                height: parent.height;
                            }
                            lic-page := LicensePage {
                                visible: root.page == 9;
                                x: 0;
                                width: min(parent.width, 776px);
                                height: parent.height;
                            }
                        }
                    }
                    // the apply bar: only while a setting differs from the saved one
                    if root.page == 4 && Settings.dirty: Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 4px;
                        width: min(parent.width - 16px, apply-row.preferred-width);
                        height: 64px;
                        border-radius: 32px;
                        background: M3.surface-container-high;
                        drop-shadow-blur: 12px;
                        drop-shadow-offset-y: 3px;
                        drop-shadow-color: #00000048;
                        apply-row := HorizontalLayout {
                            padding: 8px;
                            padding-left: 24px;
                            spacing: 8px;
                            Text {
                                text: Settings.text.changed;
                                font-size: 14px * Type.scale;
                                font-weight: 600;
                                color: M3.on-surface;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Rectangle { width: 8px; }
                            ToolbarButton {
                                text: Settings.text.revert;
                                icon: @image-url("icons/undo.svg");
                                clicked => { Settings.revert(); }
                            }
                            ToolbarButton {
                                text: Settings.text.apply;
                                icon: @image-url("icons/save.svg");
                                filled: true;
                                clicked => { Settings.apply(); }
                            }
                        }
                    }
                    VerticalLayout {
                        visible: root.page == 2;
                        width: min(parent.width, root.content-max);
                        x: (parent.width - self.width) / 2;
                        spacing: 16px;
                        // which lines: a card (or all), a level group, words (Python's log filters)
                        // (a narrow window: all three narrower, none cut off)
                        HorizontalLayout {
                            spacing: 12px;
                            AppComboBox {
                                horizontal-stretch: 2;
                                max-width: 260px;
                                model: root.log-sources;
                                current-index <=> root.log-source;
                                selected => { root.log-filter(); }
                            }
                            AppComboBox {
                                horizontal-stretch: 1;
                                max-width: 220px;
                                min-width: 90px;
                                model: root.log-levels;
                                current-index <=> root.log-level;
                                selected => { root.log-filter(); }
                            }
                            AppLineEdit {
                                horizontal-stretch: 3;
                                min-width: 100px;
                                text <=> root.log-search;
                                placeholder-text: root.t-search;
                                edited => { root.log-filter(); }
                            }
                        }
                        Rectangle {
                            border-radius: 16px;
                            background: M3.surface-container-low;
                            clip: true;
                            log-view := ListView {
                                changed content-y => {
                                    root.log-follow = self.content-y <= self.visible-height - self.content-height + 4px;
                                }
                                for line in root.logs: Rectangle {
                                    height: max(20px, root.log-px * 1.65px);
                                    // a connection's line: click to see its way on the canvas
                                    background: line.routable && row-ta.has-hover ? M3.on-surface.with-alpha(0.06) : transparent;
                                    Text {
                                        x: 12px;
                                        text: line.text;
                                        font-family: Type.mono;
                                        font-size: root.log-px * 1px;
                                        color: LogColors.of(line.level);
                                        vertical-alignment: center;
                                    }
                                    row-ta := TouchArea {
                                        enabled: line.routable;
                                        mouse-cursor: line.routable ? pointer : default;
                                        clicked => { root.log-route(line.card, line.message); }
                                    }
                                }
                            }
                            EdgeFade {
                                // (not over the scroll bar)
                                x: 0;
                                width: parent.width - 14px;
                                offset: log-view.content-y;
                                content: log-view.content-height;
                                view: log-view.visible-height;
                                fade-color: M3.surface-container-low;
                            }
                        }
                    }
                }
            }
        }
        }
    }
    // the window's title bar: the app, then minimise / maximise / close (Windows does what they do; it tells
    // which one the mouse is on). Windows 11's snap layouts show over the maximise button.
    if root.caption-h > 0: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.caption-h;
        background: M3.surface-container;
        // (macOS: the bar is the window's content, so a press here moves the window; on Windows 11 the system
        // takes these presses itself)
        TouchArea {
            pointer-event(e) => {
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                    root.drag-window();
                }
            }
        }
        HorizontalLayout {
            // (merged: up to the page's buttons)
            x: 0;
            width: root.width - root.own-buttons-w - (root.merged-bar ? title-acts.preferred-width + 24px : 0px);
            padding-left: 18px + root.caption-inset;
            spacing: 10px;
            alignment: start;
            Image {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                source: @image-url("icons/app.svg");
            }
            Text {
                text: "ProxyDock";
                font-size: 14px;
                color: root.window-active ? M3.on-surface : M3.on-surface-variant;
                vertical-alignment: center;
            }
            if root.merged-bar && root.bar-title: Text {
                text: "·";
                font-size: 14px;
                color: M3.on-surface-variant;
                vertical-alignment: center;
            }
            if root.merged-bar && root.bar-title: Text {
                horizontal-stretch: 1;
                text: root.page-title;
                font-size: 20px * Type.scale;
                font-weight: 400;
                color: root.window-active ? M3.on-surface : M3.on-surface-variant;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        for i in root.own-buttons ? 3 : 0: cap-btn := Rectangle {
            property <bool> hover: root.caption-hover == i + 1;
            property <bool> down: root.caption-pressed == i + 1;
            out property <color> fg: i == 2 && (self.hover || self.down) ? #ffffff
                : root.window-active ? M3.on-surface : M3.on-surface-variant;
            x: parent.width - (3 - i) * 46px;
            width: 46px;
            height: parent.height;
            background: i == 2
                ? (self.down ? #b22a1c : self.hover ? #c42b1c : transparent)
                : (self.down ? M3.on-surface.with-alpha(0.12) : self.hover ? M3.on-surface.with-alpha(0.08) : transparent);
            animate background { duration: 80ms; }
            if i == 0: Rectangle {
                width: 10px;
                height: 1px;
                background: cap-btn.fg;
            }
            if i == 1 && !root.win-maximized: Rectangle {
                width: 10px;
                height: 10px;
                border-width: 1px;
                border-radius: 2px;
                border-color: cap-btn.fg;
            }
            // restore: two windows, one behind the other
            if i == 1 && root.win-maximized: Rectangle {
                width: 10px;
                height: 10px;
                Rectangle {
                    x: 2px;
                    y: 0;
                    width: 8px;
                    height: 8px;
                    border-width: 1px;
                    border-radius: 2px;
                    border-color: cap-btn.fg;
                }
                Rectangle {
                    x: 0;
                    y: 2px;
                    width: 8px;
                    height: 8px;
                    border-width: 1px;
                    border-radius: 2px;
                    border-color: cap-btn.fg;
                    background: M3.surface-container;
                }
            }
            if i == 2: Path {
                width: 10px;
                height: 10px;
                viewbox-width: 10;
                viewbox-height: 10;
                commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                stroke: cap-btn.fg;
                stroke-width: 1px;
            }
        }
    }
    // the title bar's title and the page's actions (merged: only the actions, at the right of the window's bar)
    Rectangle {
        x: root.merged-bar ? root.width - root.own-buttons-w - 12px - title-acts.preferred-width : root.rail-w + 24px;
        y: root.merged-bar ? 0px : root.caption-h;
        width: root.merged-bar ? title-acts.preferred-width : root.width - root.rail-w - 48px;
        height: root.merged-bar ? root.caption-h : root.bar-h;
        // its empty part moves the window like a title bar (a double click maximises / restores)
        TouchArea {
            pointer-event(e) => {
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                    root.drag-window();
                }
            }
        }
        title-acts := PageActions {
            x: 0;
            y: (parent.height - 40px) / 2;
            width: parent.width;
            height: 40px;
            icon-only: root.merged-bar;
            // (none: they are over the page)
            page: root.acts-in-content ? -1 : root.page;
            has-cards: root.cards.length > 0;
            t-stop-all: root.t-stop-all;
            t-cancel: root.t-cancel;
            t-save: root.t-save;
            stop-all => { root.stop-all(); }
            cancel => { root.form-cancel(); }
            save => { root.form-save(); }
            t-new-proxy: root.t-new-proxy;
            t-new-outbound: root.t-new-outbound;
            add(what, t) => { root.list-add(what, t); }
            t-copy-log: root.t-copy-log;
            t-clear-log: root.t-clear-log;
            log-copy => { root.log-copy(); }
            log-clear => { root.log-clear(); }
        }
        if !root.merged-bar: Text {
            x: 0;
            height: parent.height;
            width: max(0px, title-acts.width - title-acts.preferred-width - 12px - self.x);
            text: root.page-title;
            font-size: 22px * Type.scale;
            font-weight: 400;
            color: M3.on-surface;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    UpdateDialogs { }
    ColorPickerDialog { }
    if root.toast != "": Rectangle {
        // above the canvas toolbar on the canvas, at the bottom elsewhere
        x: root.rail-w + (root.width - root.rail-w - self.width) / 2;
        y: root.height - (root.page == 0 ? 24px + 64px + 12px : 28px) - self.height;
        property <length> action-w: root.toast-action != "" ? toast-btn.preferred-width + 12px : 0px;
        // (an M3 snackbar: at most 560 wide, text from the left)
        width: min(root.width - root.rail-w - 40px, 560px, toast-text.preferred-width + 40px + self.action-w);
        height: max(toast-text.preferred-height + 24px, root.toast-action != "" ? 56px : 0px);
        border-radius: 12px;
        background: root.toast-info ? M3.secondary-container : M3.error-container;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000030;
        toast-text := Text {
            x: 20px;
            width: parent.width - 40px - parent.action-w;
            font-size: 14px * Type.scale;
            text: root.toast;
            wrap: word-wrap;
            vertical-alignment: center;
            color: root.toast-info ? M3.on-secondary-container : M3.on-error-container;
            horizontal-alignment: left;
        }
        toast-btn := AppButton {
            visible: root.toast-action != "";
            width: self.preferred-width;
            x: parent.width - self.width - 8px;
            y: (parent.height - self.height) / 2;
            text: root.toast-action;
            clicked => { root.toast-clicked(); }
        }
    }
    // the colour palette next to the swatch that was clicked (an M3 menu: surface container, 4px corners... 16px here)
    if root.palette-open: Rectangle {
        TouchArea {
            clicked => { root.palette-open = false; }
        }
        Rectangle {
            x: max(8px, min(root.palette-x, root.width - self.width - 8px));
            y: max(8px, min(root.palette-y + 8px, root.height - self.height - 8px));
            width: 296px;
            height: pal-lay.preferred-height;
            border-radius: 16px;
            background: M3.surface-container;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000050;
            TouchArea { }
            pal-lay := VerticalLayout {
                padding-top: 12px;
                padding-bottom: 8px;
                spacing: 4px;
                if root.palette-title != "": Text {
                    x: 16px;
                    width: parent.width - 32px;
                    text: root.palette-title;
                    font-size: 14px * Type.scale;
                    font-weight: 500;
                    color: M3.on-surface-variant;
                    overflow: elide;
                }
                // 5 x 2 colours, 40px touch targets
                Rectangle {
                    height: 96px;
                    for c[i] in root.palette-colors: Rectangle {
                        x: 38px + mod(i, 5) * 44px;
                        y: 4px + floor(i / 5) * 44px;
                        width: 44px; height: 44px; border-radius: 22px;
                        background: pal-ta.has-hover ? M3.on-surface.with-alpha(0.08) : transparent;
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 14px;
                            background: c;
                            border-width: i == root.palette-current ? 3px : 0px;
                            border-color: M3.on-surface;
                            if i == root.palette-current: Image {
                                width: 18px; height: 18px;
                                source: @image-url("icons/check.svg");
                                colorize: #ffffff;
                            }
                        }
                        pal-ta := TouchArea {
                            clicked => {
                                root.palette-open = false;
                                root.palette-pick(i);
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: M3.outline-variant; }
                PaletteRow {
                    text: root.t-palette-auto;
                    checked: root.palette-auto-current;
                    clicked => {
                        root.palette-open = false;
                        root.palette-pick(-1);
                    }
                }
                PaletteRow {
                    text: root.t-palette-custom;
                    icon: @image-url("icons/palette.svg");
                    clicked => {
                        root.palette-open = false;
                        root.palette-pick(-2);
                    }
                }
            }
        }
    }
    if root.picker-open: Rectangle {
        background: #00000060;
        TouchArea {
            clicked => { root.picker-open = false; }
        }
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.picker-open = false;
                    return accept;
                }
                reject
            }
            Rectangle {
                width: min(parent.width - 80px, 520px);
                height: min(parent.height - 80px, 640px);
                border-radius: 28px;
                background: M3.surface-container-high;
                TouchArea { }
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    Text {
                        text: root.t-pick-title;
                        font-size: 24px * Type.scale;
                        color: M3.on-surface;
                    }
                    AppLineEdit {
                        text <=> root.picker-search;
                        placeholder-text: root.t-pick-search;
                        edited => { root.picker-filter(); }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 16px;
                        background: M3.surface-container;
                        clip: true;
                        ListView {
                            for item in root.picker-items: Rectangle {
                                height: 56px;
                                background: pick-touch.has-hover ? M3.on-surface.with-alpha(0.08) : transparent;
                                pick-touch := TouchArea {
                                    clicked => { root.picker-toggle(item.name); }
                                }
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 16px;
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 2px;
                                        border-width: item.checked ? 0px : 2px;
                                        border-color: M3.on-surface-variant;
                                        background: item.checked ? M3.primary : transparent;
                                        Image {
                                            visible: item.checked;
                                            width: 16px;
                                            height: 16px;
                                            source: @image-url("icons/check.svg");
                                            colorize: M3.on-primary;
                                        }
                                    }
                                    Text {
                                        text: item.name;
                                        vertical-alignment: center;
                                        font-size: 16px * Type.scale;
                                        color: M3.on-surface;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.t-pick-note;
                        font-size: 14px * Type.scale;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        AppButton {
                            text: root.t-pick-file;
                            icon: @image-url("icons/folder_open.svg");
                            clicked => { root.picker-browse(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        AppButton {
                            text: root.t-cancel;
                            clicked => { root.picker-open = false; }
                        }
                        AppButton {
                            text: root.t-add;
                            primary: true;
                            clicked => {
                                root.picker-open = false;
                                root.picker-done();
                            }
                        }
                    }
                }
            }
        }
    }
    // VPN bypass: the warning before a VM is made (the user ticks the box, then "Create")
    if Bypass.consent-open: Rectangle {
        background: #00000060;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 80px, 560px);
            height: min(parent.height - 48px, consent-lay.preferred-height);
            border-radius: 28px;
            background: M3.surface-container-high;
            clip: true;
            consent-scroll := ScrollView {
                consent-lay := VerticalLayout {
                    width: consent-scroll.visible-width;
                    padding: 24px;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 12px;
                        Image {
                            width: 24px;
                            height: 24px;
                            source: @image-url("icons/shield.svg");
                            colorize: M3.error;
                        }
                        Text {
                            text: Bypass.text.consent-title;
                            font-size: 22px * Type.scale;
                            color: M3.on-surface;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                    Text {
                        text: Bypass.consent-body;
                        font-size: 14px * Type.scale;
                        color: M3.on-surface-variant;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: Bypass.consent-agreed ? M3.primary : M3.on-surface-variant;
                            background: Bypass.consent-agreed ? M3.primary : transparent;
                            if Bypass.consent-agreed: Image {
                                width: 16px;
                                height: 16px;
                                source: @image-url("icons/check.svg");
                                colorize: M3.on-primary;
                            }
                            TouchArea {
                                clicked => { Bypass.consent-agreed = !Bypass.consent-agreed; }
                            }
                        }
                        Text {
                            text: Bypass.text.consent-check;
                            font-size: 14px * Type.scale;
                            font-weight: 600;
                            color: M3.on-surface;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            TouchArea {
                                clicked => { Bypass.consent-agreed = !Bypass.consent-agreed; }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        AppButton {
                            text: root.t-cancel;
                            clicked => {
                                Bypass.consent-open = false;
                                Bypass.consent-agreed = false;
                            }
                        }
                        AppButton {
                            text: Bypass.text.consent-create;
                            primary: true;
                            enabled: Bypass.consent-agreed;
                            clicked => {
                                Bypass.consent-open = false;
                                Bypass.consent-agreed = false;
                                Bypass.consent-yes(Bypass.consent-name);
                            }
                        }
                    }
                }
            }
        }
    }
    if root.confirm-text != "": Rectangle {
        background: #00000060;
        TouchArea {
            clicked => { root.confirm-text = ""; }
        }
        Rectangle {
            width: min(parent.width - 80px, 440px);
            height: confirm-lay.preferred-height;
            border-radius: 28px;
            background: M3.surface-container-high;
            TouchArea { }
            confirm-lay := VerticalLayout {
                padding: 24px;
                spacing: 24px;
                Text {
                    text: root.confirm-text;
                    font-size: 16px * Type.scale;
                    color: M3.on-surface;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    AppButton {
                        text: root.t-cancel;
                        clicked => { root.confirm-text = ""; }
                    }
                    AppButton {
                        text: root.t-yes;
                        primary: true;
                        clicked => {
                            root.confirm-text = "";
                            root.confirm-yes();
                        }
                    }
                }
            }
        }
    }
    Rectangle {
        visible: root.rename-open;
        background: #00000060;
        TouchArea {
            enabled: root.rename-open;
            clicked => { root.rename-open = false; }
        }
        FocusScope {
            enabled: root.rename-open;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.rename-open = false;
                    return accept;
                }
                reject
            }
            Rectangle {
                width: min(parent.width - 80px, 420px);
                height: rename-lay.preferred-height;
                border-radius: 28px;
                background: M3.surface-container-high;
                TouchArea { }
                rename-lay := VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    Text {
                        text: root.rename-title != "" ? root.rename-title : root.t-rename;
                        font-size: 20px * Type.scale;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    rename-input := AppLineEdit {
                        enabled: root.rename-open;
                        text <=> root.rename-text;
                        accepted(text) => {
                            root.rename-open = false;
                            root.rename-apply(text);
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        AppButton {
                            text: root.t-cancel;
                            clicked => { root.rename-open = false; }
                        }
                        AppButton {
                            text: root.t-save;
                            primary: true;
                            clicked => {
                                root.rename-open = false;
                                root.rename-apply(root.rename-text);
                            }
                        }
                    }
                }
            }
        }
    }
}
