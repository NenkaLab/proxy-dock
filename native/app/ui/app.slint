}

component SettingsLogs inherits SettingsSection {
    title: Settings.text.logs;
    icon: @image-url("icons/description.svg");
    SettingRow {
        label: Settings.text.logfile;
        Button {
            text: Settings.text.open-folder;
            icon: @image-url("icons/folder_open.svg");
            colorize-icon: true;
            clicked => { Settings.open-log-dir(); }
        }
        Switch { checked <=> Settings.logfile; }
    }
    // a path has no spaces to wrap at
    Text {
        text: Settings.log-dir;
        font-size: 12px;
        font-family: "JetBrains Mono";
        color: M3.on-surface-variant;
        wrap: char-wrap;
    }
}

// --- statistics page (Python ui/stats.py) ---

export struct StatTileData { title: string, value: string, sub: string }
// one graph line: its colour, the SVG path in a 0..59 x 0..1000 box (y down), and the filled area ("" = none)
export struct ChartLine { name: string, color: color, commands: string, area: string }

export global Stats {
    in property <string> title;
    in property <[string]> choices;
    in-out property <int> choice;
    in property <[string]> modes;
    in-out property <int> mode;
    in property <[StatTileData]> tiles;
    in property <string> chart-title;
    in property <string> max-text;
    in property <[ChartLine]> lines;
    in property <string> empty;
    // the graph's size in px (the paths are drawn in it: a Path keeps its view box's aspect ratio)
    in-out property <float> chart-w: 600;
    in-out property <float> chart-h: 240;
    callback changed();
}

component StatTile inherits Rectangle {
    in property <StatTileData> data;
    border-radius: 20px;
    background: M3.surface-container-low;
    min-height: 92px;
    // equal shares of the row (not by the length of their text)
    preferred-width: 100px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 16px;
        padding-left: 20px;
        spacing: 2px;
        alignment: center;
        Text {
            text: root.data.title;
            font-size: 12px;
            color: M3.on-surface-variant;
            overflow: elide;
        }
        Text {
            text: root.data.value;
            font-size: 22px;
            font-weight: 700;
            color: M3.on-surface;
            overflow: elide;
        }
        Text {
            text: root.data.sub;
            font-size: 12px;
            color: M3.on-surface-variant;
            overflow: elide;
        }
    }
}

// a pill segmented button row (M3 segmented buttons)
component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current;
    callback picked();
    height: 36px;
    width: seg-row.preferred-width;
    border-radius: 18px;
    border-width: 1px;
    border-color: M3.outline-variant;
    clip: true;
    seg-row := HorizontalLayout {
        for item[i] in root.items: Rectangle {
            width: seg-label.preferred-width + 28px;
            background: i == root.current ? M3.secondary-container : seg-ta.has-hover ? M3.on-surface.with-alpha(0.06) : transparent;
            seg-label := Text {
                text: item;
                font-size: 13px;
                font-weight: i == root.current ? 700 : 500;
                color: i == root.current ? M3.on-secondary-container : M3.on-surface;
            }
            seg-ta := TouchArea {
                clicked => {
                    root.current = i;
                    root.picked();
                }
            }
        }
    }
}

component StatsPage inherits VerticalLayout {
    spacing: 14px;
    HorizontalLayout {
        spacing: 12px;
        Text {
            text: Stats.title;
            font-size: 26px;
            font-weight: 700;
            color: M3.on-surface;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        ComboBox {
            width: 240px;
            model: Stats.choices;
            current-index <=> Stats.choice;
            selected => { Stats.changed(); }
        }
    }
    // tiles: three a row when there is room, two otherwise
    property <bool> wide: self.width >= 640px;
    if root.wide: VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            StatTile { data: Stats.tiles[0]; }
            StatTile { data: Stats.tiles[1]; }
            StatTile { data: Stats.tiles[2]; }
        }
        HorizontalLayout {
            spacing: 12px;
            StatTile { data: Stats.tiles[3]; }
            StatTile { data: Stats.tiles[4]; }
            StatTile { data: Stats.tiles[5]; }
        }
    }
    if !root.wide: VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            StatTile { data: Stats.tiles[0]; }
            StatTile { data: Stats.tiles[1]; }
        }
        HorizontalLayout {
            spacing: 12px;
            StatTile { data: Stats.tiles[2]; }
            StatTile { data: Stats.tiles[5]; }
        }
        HorizontalLayout {
            spacing: 12px;
            StatTile { data: Stats.tiles[3]; }
            StatTile { data: Stats.tiles[4]; }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        min-height: 220px;
        border-radius: 20px;
        background: M3.surface-container-low;
        VerticalLayout {
            padding: 16px;
            padding-left: 20px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: Stats.chart-title;
                    font-size: 13px;
                    font-weight: 600;
                    color: M3.on-surface;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Segmented {
                    items: Stats.modes;
                    current <=> Stats.mode;
                    picked => { Stats.changed(); }
                }
            }
            // legend, then the graph
            HorizontalLayout {
                spacing: 14px;
                Text {
                    text: Stats.max-text;
                    font-size: 12px;
                    color: M3.on-surface-variant;
                    horizontal-stretch: 1;
                }
                for l in Stats.lines: HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 6px;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: l.color;
                    }
                    Text {
                        text: l.name;
                        font-size: 12px;
                        color: M3.on-surface-variant;
                        max-width: 160px;
                        overflow: elide;
                    }
                }
            }
            chart := Rectangle {
                vertical-stretch: 1;
                init => {
                    Stats.chart-w = self.width / 1px;
                    Stats.chart-h = self.height / 1px;
                }
                changed width => {
                    Stats.chart-w = self.width / 1px;
                    Stats.changed();
                }
                changed height => {
                    Stats.chart-h = self.height / 1px;
                    Stats.changed();
                }
                for i in 5: Rectangle {
                    y: chart.height * i / 4;
                    height: 1px;
                    background: M3.on-surface.with-alpha(0.10);
                }
                for l in Stats.lines: Path {
                    width: chart.width;
                    height: chart.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: Stats.chart-w;
                    viewbox-height: Stats.chart-h;
                    commands: l.area;
                    fill: l.color.with-alpha(0.20);
                    visible: l.area != "";
                }
                for l in Stats.lines: Path {
                    width: chart.width;
                    height: chart.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: Stats.chart-w;
                    viewbox-height: Stats.chart-h;
                    commands: l.commands;
                    stroke: l.color;
                    stroke-width: 2px;
                }
                if Stats.empty != "": Text {
                    text: Stats.empty;
                    color: M3.on-surface-variant;
                    font-size: 14px;
                }
            }
        }
    }
}

// --- connection test page (Python ui/conntest.py) ---

export struct ConnRow {
    region: string, name: string, host: string, added: bool,
    result: string, conn: string, total: string,
    // 0 not tested / waiting, 1 answered, 2 failed
    tone: int,
}

export global Conn {
    in property <string> title;
    in property <[string]> proxies;
    in-out property <int> proxy;
    in property <string> button;
    in property <bool> button-enabled;
    in property <string> summary;
    in property <string> placeholder;
    in property <string> add-text;
    in-out property <string> site;
    in property <bool> editable: true;
    in property <[string]> columns;
    in property <[ConnRow]> rows;
    callback start();
    callback add();
    callback remove(string);
    callback proxy-changed();
}

component ConnPage inherits VerticalLayout {
    spacing: 10px;
    // the region and address columns go when it gets narrow
    property <bool> wide: self.width >= 760px;
    HorizontalLayout {
        spacing: 12px;
        Text {
            text: Conn.title;
            font-size: 26px;
            font-weight: 700;
            color: M3.on-surface;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        ComboBox {
            width: 220px;
            model: Conn.proxies;
            current-index <=> Conn.proxy;
            enabled: Conn.proxies.length > 0;
            selected => { Conn.proxy-changed(); }
        }
        Button {
            min-width: 190px;
            text: Conn.button;
            icon: @image-url("icons/network_check.svg");
            colorize-icon: true;
            primary: true;
            enabled: Conn.button-enabled;
            clicked => { Conn.start(); }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: Conn.summary;
            font-size: 12px;
            color: M3.on-surface-variant;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        LineEdit {
            width: 260px;
            text <=> Conn.site;
            placeholder-text: Conn.placeholder;
            enabled: Conn.editable;
            accepted => { Conn.add(); }
        }
        Button {
            text: Conn.add-text;
            icon: @image-url("icons/add.svg");
            colorize-icon: true;
            enabled: Conn.editable;
            clicked => { Conn.add(); }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        border-radius: 16px;
        background: M3.surface-container-low;
        clip: true;
        VerticalLayout {
            // header
            Rectangle {
                height: 40px;
                background: M3.surface-container-high;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    if root.wide: Text { width: 90px; text: Conn.columns[0]; font-size: 12px; font-weight: 700; color: M3.on-surface-variant; vertical-alignment: center; }
                    Text { width: 120px; text: Conn.columns[1]; font-size: 12px; font-weight: 700; color: M3.on-surface-variant; vertical-alignment: center; }
                    if root.wide: Text { width: 170px; text: Conn.columns[2]; font-size: 12px; font-weight: 700; color: M3.on-surface-variant; vertical-alignment: center; }
                    Text { horizontal-stretch: 1; text: Conn.columns[3]; font-size: 12px; font-weight: 700; color: M3.on-surface-variant; vertical-alignment: center; }
                    Text { width: 70px; text: Conn.columns[4]; font-size: 12px; font-weight: 700; color: M3.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; }
                    Text { width: 70px; text: Conn.columns[5]; font-size: 12px; font-weight: 700; color: M3.on-surface-variant; vertical-alignment: center; horizontal-alignment: right; }
                    Rectangle { width: 28px; }
                }
            }
            ListView {
                for r[i] in Conn.rows: Rectangle {
                    height: 36px;
                    background: mod(i, 2) == 1 ? M3.on-surface.with-alpha(0.03) : transparent;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 12px;
                        if root.wide: Text { width: 90px; text: r.region; font-size: 13px; color: M3.on-surface-variant; vertical-alignment: center; overflow: elide; }
                        Text { width: 120px; text: r.name; font-size: 13px; font-weight: 600; color: M3.on-surface; vertical-alignment: center; overflow: elide; }
                        if root.wide: Text { width: 170px; text: r.host; font-size: 12px; font-family: "JetBrains Mono"; color: M3.on-surface-variant; vertical-alignment: center; overflow: elide; }
                        Text {
                            horizontal-stretch: 1;
                            text: r.result;
                            font-size: 13px;
                            color: r.tone == 1 ? #2e9d4a : r.tone == 2 ? M3.error : M3.on-surface-variant;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text { width: 70px; text: r.conn; font-size: 12px; font-family: "JetBrains Mono"; color: M3.on-surface; vertical-alignment: center; horizontal-alignment: right; }
                        Text { width: 70px; text: r.total; font-size: 12px; font-family: "JetBrains Mono"; color: M3.on-surface; vertical-alignment: center; horizontal-alignment: right; }
                        // a site the user added can be taken out again
                        Rectangle {
                            width: 28px;
                            if r.added: Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: rm-ta.has-hover && Conn.editable ? M3.on-surface.with-alpha(0.10) : transparent;
                                opacity: Conn.editable ? 1 : 0.38;
                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: @image-url("icons/close.svg");
                                    colorize: M3.on-surface-variant;
                                }
                                rm-ta := TouchArea {
                                    enabled: Conn.editable;
                                    clicked => { Conn.remove(r.host); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component App inherits Window {
    // canvas
    in property <[NodeData]> nodes;
    in property <[LinkData]> links <=> editor.links;
    in-out property <string> grid-commands <=> editor.grid-commands;
    out property <float> width_: editor.width / 1px;
    out property <float> height_: editor.height / 1px;
    in property <string> t-canvas: "Canvas";
    in property <string> t-add-inbound: "Inbound";
    in property <string> t-add-router: "Router";
    in property <string> t-add-relay: "Pass-through";
    in property <string> t-add-outbound: "Outbound";
    in property <string> t-delete: "Delete";
    in property <string> t-undo: "Undo";
    in property <string> t-redo: "Redo";
    in property <string> t-rename: "Rename";
    in property <string> t-duplicate: "Duplicate";
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <string> t-latency: "Test latency";
    // "Testing… 2/5" while a latency test runs
    in property <string> latency-progress;
    callback test-latency();
    // the saved theme: 0 the system's, 1 light, 2 dark
    in property <int> theme;
    changed theme => {
        Palette.color-scheme = self.theme == 1 ? ColorScheme.light : self.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    // the log's font size (px)
    in property <float> log-px: 12;
    // the title box of "Rename" (F2): open, and the text typed
    in-out property <bool> rename-open;
    in-out property <string> rename-text;
    callback undo();
    callback redo();
    callback rename-selected();
    callback rename-apply(string);
    callback duplicate-selected();
    changed rename-open => {
        if self.rename-open {
            rename-input.focus();
            rename-input.select-all();
        } else {
            editor.focus();
        }
    }
    // a refused edit's reason, shown for a few seconds
    in property <string> toast;
    // the toast is a plain message (a settings change), not a refusal
    in property <bool> toast-info;
    // a message in the editor (a button's result): text and whether it went well
    in property <string> form-notice;
    in property <bool> form-notice-ok;
    // world coordinates of the visible canvas centre (new blocks go there)
    out property <float> view-center-x: (editor.width / 2 - editor.pan-x) / editor.zoom / 1px;
    out property <float> view-center-y: (editor.height / 2 - editor.pan-y) / editor.zoom / 1px;
    callback add-block(int);
    // block editor (page 3)
    in property <[FieldRow]> form-fields;
    in property <string> form-title;
    in property <[string]> form-errors;
    in property <string> t-save: "Save";
    in property <string> t-cancel: "Cancel";
    callback edit-block(int);
    callback edit-card(string);
    callback field-changed(string, string);
    callback form-save();
    callback form-pressed(string, int);
    // text to read or copy (a WireGuard device's config)
    in-out property <string> popup-title;
    in-out property <string> popup-text;
    in property <string> t-close: "Close";
    callback form-cancel();
    callback delete-selected();
    in property <string> t-no-graph: "";
    callback link-requested <=> editor.link-requested;
    callback node-selected <=> editor.node-selected;
    callback select-link <=> editor.select-link;
    callback selection-cleared <=> editor.selection-cleared;
    callback box-selection-committed <=> editor.box-selection-committed;
    callback compute-link-at <=> editor.compute-link-at;
    public function focus-editor() { editor.focus(); }

    in property <[CardRow]> cards;
    in property <[LogRow]> logs;
    in-out property <int> page: 0;
    in property <string> t-proxy: "Proxy";
    in property <string> t-logs: "Logs";
    in property <string> t-stats: "Statistics";
    in property <string> t-conn: "Connection test";
    in property <string> t-stop-all: "Stop all proxies";
    in property <string> t-empty: "No proxies yet.";
    in property <bool> connected: true;
    in property <string> t-disconnected: "";
    out property <bool> dark: M3.dark;
    out property <color> caption-color: M3.surface-container;
    out property <color> caption-text: M3.on-surface;
    callback toggle(string);
    callback stop-all();
    // light / dark switched: the title bar colours follow
    callback theme-changed();
    changed dark => { root.theme-changed(); }
    // the log follows new lines (scroll position kept while reading back is for later)
    in property <int> log-count;
    changed log-count => {
        log-view.content-y = min(0px, log-view.visible-height - log-view.content-height);
    }

    title: "ProxyDock";
    preferred-width: 980px;
    preferred-height: 680px;
    min-width: 560px;
    min-height: 400px;
    background: M3.surface-container;
    default-font-family: "Pretendard Variable";

    HorizontalLayout {
        // navigation rail
        VerticalLayout {
            width: 88px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 4px;
            RailItem {
                icon: @image-url("icons/account_tree.svg");
                label: root.t-canvas;
                active: root.page == 0;
                clicked => { root.page = 0; }
            }
            RailItem {
                icon: @image-url("icons/dns.svg");
                label: root.t-proxy;
                active: root.page == 1;
                clicked => { root.page = 1; }
            }
            RailItem {
                icon: @image-url("icons/monitoring.svg");
                label: root.t-stats;
                active: root.page == 5;
                clicked => { root.page = 5; }
            }
            RailItem {
                icon: @image-url("icons/network_check.svg");
                label: root.t-conn;
                active: root.page == 6;
                clicked => { root.page = 6; }
            }
            RailItem {
                icon: @image-url("icons/receipt_long.svg");
                label: root.t-logs;
                active: root.page == 2;
                clicked => { root.page = 2; }
            }
            Rectangle { vertical-stretch: 1; }
            RailItem {
                icon: @image-url("icons/settings.svg");
                label: Settings.text.title;
                active: root.page == 4;
                clicked => { root.page = 4; }
            }
        }
        // page container
        Rectangle {
            border-radius: 28px;
            background: M3.surface;
            clip: true;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                if !root.connected: Rectangle {
                    height: 40px;
                    border-radius: 12px;
                    background: M3.error-container;
                    Text {
                        text: root.t-disconnected;
                        color: M3.on-error-container;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
                // both pages stay (the log keeps its scroll position); the hidden one is not drawn
                Rectangle {
                    // canvas: edge to edge in the page container
                    Rectangle {
                        x: -20px;
                        y: -20px;
                        width: parent.width + 40px;
                        height: parent.height + 40px;
                        visible: root.page == 0;
                        FocusScope {
                            width: 100%;
                            height: 100%;
                            // Python canvas shortcuts: Delete, F2, Ctrl+D, Ctrl+Z, Ctrl+Y / Ctrl+Shift+Z
                            key-pressed(event) => {
                                if event.text == Key.Delete {
                                    root.delete-selected();
                                    return accept;
                                }
                                if event.text == Key.F2 {
                                    root.rename-selected();
                                    return accept;
                                }
                                if event.modifiers.control && !event.modifiers.alt {
                                    if event.text == "d" || event.text == "D" {
                                        root.duplicate-selected();
                                        return accept;
                                    }
                                    if ((event.text == "z" || event.text == "Z") && event.modifiers.shift) || event.text == "y" || event.text == "Y" {
                                        root.redo();
                                        return accept;
                                    }
                                    if event.text == "z" || event.text == "Z" {
                                        root.undo();
                                        return accept;
                                    }
                                }
                                reject
                            }
                        editor := NodeEditor {
                            width: 100%;
                            height: 100%;
                            has-link-selection: true;
                            // the software renderer keeps rectangle sizes in i16: a smaller world than the default
                            world-content-size: 8000px;
                            max-zoom: 2.0;
                            for node in root.nodes: ProxyNode {
                                node-id: node.id;
                                title: node.title;
                                detail: node.detail;
                                kind: node.kind;
                                ins: node.ins;
                                outs: node.outs;
                                in-labels: node.in-labels;
                                out-labels: node.out-labels;
                                wires: node.wires;
                                state: node.state;
                                rate: node.rate;
                                badge: node.badge;
                                badge-tone: node.badge-tone;
                                toggle => { root.toggle(node.card); }
                                edit => { root.edit-block(node.id); }
                                world-x: node.x * 1px;
                                world-y: node.y * 1px;
                                selected: node.selected;
                            }
                        }
                        }
                        if root.nodes.length == 0: Text {
                            text: root.t-no-graph;
                            color: M3.on-surface-variant;
                            font-size: 15px;
                        }
                        // M3 Expressive floating toolbar
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: parent.height - self.height - 24px;
                            width: bar.preferred-width;
                            height: 60px;
                            border-radius: 30px;
                            background: M3.surface-container-high;
                            drop-shadow-blur: 10px;
                            drop-shadow-offset-y: 3px;
                            drop-shadow-color: #00000040;
                            bar := HorizontalLayout {
                                padding: 8px;
                                spacing: 4px;
                                ToolbarButton { text: root.t-add-inbound; icon: @image-url("icons/login.svg"); compact: tool-row.add-compact; clicked => { root.add-block(0); } }
                                ToolbarButton { text: root.t-add-router; icon: @image-url("icons/alt_route.svg"); compact: tool-row.add-compact; clicked => { root.add-block(1); } }
                                ToolbarButton { text: root.t-add-relay; icon: @image-url("icons/swap_horiz.svg"); compact: tool-row.add-compact; clicked => { root.add-block(3); } }
                                ToolbarButton { text: root.t-add-outbound; icon: @image-url("icons/logout.svg"); compact: tool-row.add-compact; clicked => { root.add-block(2); } }
                                Rectangle { width: 1px; background: M3.outline-variant; }
                                ToolbarButton { text: root.t-undo; icon: @image-url("icons/undo.svg"); compact: tool-row.all-compact; enabled: root.can-undo; clicked => { root.undo(); } }
                                ToolbarButton { text: root.t-redo; icon: @image-url("icons/redo.svg"); compact: tool-row.all-compact; enabled: root.can-redo; clicked => { root.redo(); } }
                                ToolbarButton { text: root.t-rename; icon: @image-url("icons/edit.svg"); compact: tool-row.all-compact; clicked => { root.rename-selected(); } }
                                ToolbarButton { text: root.t-duplicate; icon: @image-url("icons/content_copy.svg"); compact: tool-row.all-compact; clicked => { root.duplicate-selected(); } }
                                ToolbarButton {
                                    text: root.latency-progress != "" ? root.latency-progress : root.t-latency;
                                    icon: @image-url("icons/speed.svg");
                                    compact: tool-row.all-compact && root.latency-progress == "";
                                    enabled: root.latency-progress == "";
                                    clicked => { root.test-latency(); }
                                }
                                ToolbarButton { text: root.t-delete; icon: @image-url("icons/delete.svg"); compact: tool-row.all-compact; filled: true; clicked => { root.delete-selected(); } }
                            }
                        }
                        // the toolbar's widths with and without text: the buttons drop their text when it does not fit
                        tool-row := Rectangle {
                            visible: false;
                            property <length> room: parent.width - 48px;
                            out property <bool> add-compact: full.preferred-width > self.room;
                            out property <bool> all-compact: mid.preferred-width > self.room;
                            full := HorizontalLayout {
                                padding: 8px;
                                spacing: 4px;
                                ToolbarButton { text: root.t-add-inbound; }
                                ToolbarButton { text: root.t-add-router; }
                                ToolbarButton { text: root.t-add-relay; }
                                ToolbarButton { text: root.t-add-outbound; }
                                Rectangle { width: 1px; }
                                ToolbarButton { text: root.t-undo; }
                                ToolbarButton { text: root.t-redo; }
                                ToolbarButton { text: root.t-rename; }
                                ToolbarButton { text: root.t-duplicate; }
                                ToolbarButton { text: root.t-latency; }
                                ToolbarButton { text: root.t-delete; }
                            }
                            mid := HorizontalLayout {
                                padding: 8px;
                                spacing: 4px;
                                for i in 4: ToolbarButton { compact: true; }
                                Rectangle { width: 1px; }
                                ToolbarButton { text: root.t-undo; }
                                ToolbarButton { text: root.t-redo; }
                                ToolbarButton { text: root.t-rename; }
                                ToolbarButton { text: root.t-duplicate; }
                                ToolbarButton { text: root.t-latency; }
                                ToolbarButton { text: root.t-delete; }
                            }
                        }
                    }
                    VerticalLayout {
                        visible: root.page == 1;
                        spacing: 12px;
                        HorizontalLayout {
                            Text {
                                text: root.t-proxy;
                                font-size: 26px;
                                font-weight: 700;
                                color: M3.on-surface;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            if root.cards.length > 0: Button {
                                text: root.t-stop-all;
                                clicked => { root.stop-all(); }
                            }
                        }
                        if root.cards.length == 0: Text {
                            text: root.t-empty;
                            color: M3.on-surface-variant;
                            font-size: 15px;
                        }
                        ListView {
                            for c in root.cards: VerticalLayout {
                                padding-bottom: 10px;
                                Card {
                                    card: c;
                                    toggle(id) => { root.toggle(id); }
                                    edit(id) => { root.edit-card(id); }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        visible: root.page == 3;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.form-title;
                                font-size: 26px;
                                font-weight: 700;
                                color: M3.on-surface;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Button { text: root.t-cancel; clicked => { root.form-cancel(); } }
                            Button { text: root.t-save; primary: true; clicked => { root.form-save(); } }
                        }
                        if root.form-notice != "": Rectangle {
                            border-radius: 12px;
                            background: root.form-notice-ok ? M3.secondary-container : M3.error-container;
                            height: notice-text.preferred-height + 20px;
                            notice-text := Text {
                                x: 16px;
                                width: parent.width - 32px;
                                text: root.form-notice;
                                color: root.form-notice-ok ? M3.on-secondary-container : M3.on-error-container;
                                wrap: word-wrap;
                            }
                        }
                        if root.form-errors.length > 0: Rectangle {
                            border-radius: 12px;
                            background: M3.error-container;
                            height: errs.preferred-height + 20px;
                            errs := VerticalLayout {
                                x: 16px;
                                y: 10px;
                                width: parent.width - 32px;
                                for e in root.form-errors: Text {
                                    text: "• " + e;
                                    color: M3.on-error-container;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        ScrollView {
                            VerticalLayout {
                                padding-right: 16px;
                                padding-bottom: 24px;
                                for f in root.form-fields: FormRow {
                                    f: f;
                                    visible: f.visible;
                                    height: f.visible ? self.preferred-height : 0px;
                                    changed(k, v) => { root.field-changed(k, v); }
                                    pressed(k, i) => { root.form-pressed(k, i); }
                                }
                            }
                        }
                    }
                    StatsPage { visible: root.page == 5; }
                    ConnPage { visible: root.page == 6; }
                    settings-page := VerticalLayout {
                        visible: root.page == 4;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: Settings.text.title;
                                font-size: 26px;
                                font-weight: 700;
                                color: M3.on-surface;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }
                        settings-scroll := ScrollView {
                            // two columns of sections when there is room, one otherwise; never wider than reads well
                            out property <bool> wide: self.visible-width >= 720px;
                            out property <length> content-w: min(self.visible-width - 16px, 1360px);
                            VerticalLayout {
                                padding-right: 16px;
                                // room for the apply bar
                                padding-bottom: 96px;
                                alignment: start;
                                if settings-scroll.wide: HorizontalLayout {
                                    width: settings-scroll.content-w;
                                    spacing: 16px;
                                    VerticalLayout {
                                        // equal halves (long texts would otherwise widen one column)
                                        width: (settings-scroll.content-w - 16px) / 2;
                                        spacing: 16px;
                                        alignment: start;
                                        SettingsDefaults {}
                                    }
                                    VerticalLayout {
                                        // equal halves (long texts would otherwise widen one column)
                                        width: (settings-scroll.content-w - 16px) / 2;
                                        spacing: 16px;
                                        alignment: start;
                                        SettingsDisplay {}
                                        SettingsEngine {}
                                        SettingsLogs {}
                                    }
                                }
                                if !settings-scroll.wide: VerticalLayout {
                                    width: min(settings-scroll.content-w, 720px);
                                    spacing: 16px;
                                    SettingsDefaults {}
                                    SettingsDisplay {}
                                    SettingsEngine {}
                                    SettingsLogs {}
                                }
                            }
                        }
                    }
                    // the apply bar: only while a setting differs from the saved one
                    if root.page == 4 && Settings.dirty: Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 4px;
                        width: min(parent.width - 16px, apply-row.preferred-width);
                        height: 60px;
                        border-radius: 30px;
                        background: M3.surface-container-high;
                        drop-shadow-blur: 12px;
                        drop-shadow-offset-y: 3px;
                        drop-shadow-color: #00000048;
                        apply-row := HorizontalLayout {
                            padding: 8px;
                            padding-left: 24px;
                            spacing: 8px;
                            Text {
                                text: Settings.text.changed;
                                font-size: 14px;
                                font-weight: 600;
                                color: M3.on-surface;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Rectangle { width: 8px; }
                            ToolbarButton {
                                text: Settings.text.revert;
                                icon: @image-url("icons/undo.svg");
                                clicked => { Settings.revert(); }
                            }
                            ToolbarButton {
                                text: Settings.text.apply;
                                icon: @image-url("icons/save.svg");
                                filled: true;
                                clicked => { Settings.apply(); }
                            }
                        }
                    }
                    VerticalLayout {
                        visible: root.page == 2;
                        spacing: 12px;
                        Text {
                            text: root.t-logs;
                            font-size: 26px;
                            font-weight: 700;
                            color: M3.on-surface;
                        }
                        Rectangle {
                            border-radius: 16px;
                            background: M3.surface-container-low;
                            clip: true;
                            log-view := ListView {
                                for line in root.logs: Text {
                                    text: line.text;
                                    font-family: "JetBrains Mono";
                                    font-size: root.log-px * 1px;
                                    height: max(20px, root.log-px * 1.65px);
                                    x: 12px;
                                    color: line.tone == 2 ? M3.error : line.tone == 1 ? #b26a00 : line.tone == 3 ? M3.on-surface-variant : M3.on-surface;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.toast != "": Rectangle {
        // above the canvas toolbar on the canvas, at the bottom elsewhere
        x: 88px + (root.width - 88px - self.width) / 2;
        y: root.height - (root.page == 0 ? 24px + 60px + 12px : 28px) - self.height;
        width: min(root.width - 88px - 40px, toast-text.preferred-width + 40px);
        height: toast-text.preferred-height + 24px;
        border-radius: 12px;
        background: root.toast-info ? M3.secondary-container : M3.error-container;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000030;
        toast-text := Text {
            width: parent.width - 40px;
            text: root.toast;
            wrap: word-wrap;
            color: root.toast-info ? M3.on-secondary-container : M3.on-error-container;
            horizontal-alignment: center;
        }
    }
    Rectangle {
        visible: root.rename-open;
        background: #00000060;
        TouchArea {
            enabled: root.rename-open;
            clicked => { root.rename-open = false; }
        }
        FocusScope {
            enabled: root.rename-open;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.rename-open = false;
                    return accept;
                }
                reject
            }
            Rectangle {
                width: min(parent.width - 80px, 420px);
                height: rename-lay.preferred-height;
                border-radius: 28px;
                background: M3.surface-container-high;
                TouchArea { }
                rename-lay := VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    Text {
                        text: root.t-rename;
                        font-size: 20px;
                        font-weight: 700;
                        color: M3.on-surface;
                    }
                    rename-input := LineEdit {
                        enabled: root.rename-open;
                        text <=> root.rename-text;
                        accepted(text) => {
                            root.rename-open = false;
                            root.rename-apply(text);
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: root.t-cancel;
                            clicked => { root.rename-open = false; }
                        }
                        Button {
                            text: root.t-save;
                            primary: true;
                            clicked => {
                                root.rename-open = false;
                                root.rename-apply(root.rename-text);
                            }
                        }
                    }
                }
            }
        }
    }
    if root.popup-text != "": Rectangle {
        background: #00000080;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 80px, 640px);
            height: min(parent.height - 80px, 480px);
            border-radius: 28px;
            background: M3.surface-container-high;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: root.popup-title;
                    font-size: 20px;
                    font-weight: 700;
                    color: M3.on-surface;
                }
                TextEdit {
                    text: root.popup-text;
                    read-only: true;
                    font-size: 13px;
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: root.t-close;
                        clicked => { root.popup-text = ""; }
                    }
                }
            }
        }
    }
}
