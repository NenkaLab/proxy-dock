// Material 3 Expressive look on Slint's "material" style (build.rs): tonal surfaces from a blue seed,
// pill navigation rail, large rounded containers, floating toolbar, spring-like motion.
import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, TextEdit } from "std-widgets.slint";
import {
    NodeEditor, BaseNode, Pin, PinTypes, NodeEditorEvents, NodeEditorInternalCallbacks, NodeEditorComputations, LinkData,
} from "@nodeeditor";
// the same fonts ProxyDock ships
import "../../../fonts/PretendardVariable.ttf";
import "../../../fonts/JetBrainsMono.ttf";

export { PinTypes, NodeEditorEvents, NodeEditorInternalCallbacks, NodeEditorComputations }

// M3 color roles for seed #0061A4 (baseline tonal palette), light / dark
global M3 {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> primary: dark ? #9ecaff : #0061a4;
    out property <color> on-primary: dark ? #003258 : #ffffff;
    out property <color> primary-container: dark ? #00497d : #d1e4ff;
    out property <color> on-primary-container: dark ? #d1e4ff : #001d36;
    out property <color> secondary-container: dark ? #3b4858 : #d7e3f7;
    out property <color> on-secondary-container: dark ? #d7e3f7 : #101c2b;
    out property <color> tertiary-container: dark ? #523f5f : #f2daff;
    out property <color> on-tertiary-container: dark ? #f2daff : #251431;
    out property <color> green-container: dark ? #1f5129 : #b7f1bc;
    out property <color> on-green-container: dark ? #b7f1bc : #002107;
    out property <color> surface: dark ? #111418 : #f8f9ff;
    out property <color> surface-container-low: dark ? #191c20 : #f2f3f9;
    out property <color> surface-container: dark ? #1d2024 : #eceef4;
    out property <color> surface-container-high: dark ? #272a2f : #e6e8ee;
    out property <color> surface-container-highest: dark ? #32353a : #e0e2e8;
    out property <color> on-surface: dark ? #e1e2e8 : #191c20;
    out property <color> on-surface-variant: dark ? #c3c7cf : #43474e;
    out property <color> outline-variant: dark ? #43474e : #c3c7cf;
}

// M3 Expressive motion, as cubic-bezier approximations of its springs
global Motion {
    out property <duration> fast-spatial: 350ms;
    out property <duration> default-spatial: 500ms;
    out property <duration> fast-effects: 150ms;
    out property <duration> default-effects: 200ms;
}

export struct Wire { i: int, o: int }

export struct NodeData {
    id: int,
    title: string,
    detail: string,
    kind: int,          // 0 inbound, 1 router, 2 outbound, 3 relay (pass-through with lanes)
    x: float,
    y: float,
    selected: bool,
    ins: int,           // input lanes (pins on the left)
    outs: int,          // output lanes (pins on the right)
    in-labels: [string],
    out-labels: [string],
    wires: [Wire],      // relay: input lane -> output lane, drawn inside the block
    in-wired: [bool],   // relay: per input lane, whether it is wired (unwired lanes are drawn amber)
}

// Pin ids: input lane i = node * 64 + i * 2, output lane o = node * 64 + o * 2 + 1 (src/main.rs pin_in / pin_out)
component ProxyNode inherits BaseNode {
    in property <string> title;
    in property <string> detail;
    in property <int> kind;
    in property <int> ins;
    in property <int> outs;
    in property <[string]> in-labels;
    in property <[string]> out-labels;
    in property <[Wire]> wires;
    in property <[bool]> in-wired;
    // relay: drag between inner dots to wire a lane (input -> output). in-lane, out-lane (-1: unwire the input)
    callback wire-requested(int, int);
    // relay: add a lane (true = input side), remove lane n of a side
    callback lane-add(bool);
    callback lane-remove(bool, int);

    property <length> header: 54px;
    property <length> lane-h: 26px;
    property <length> inset: 78px;    // relay: inner lane dots, past the lane labels
    property <int> rows: max(1, max(ins, outs));
    node-width: kind == 1 ? 250px : kind == 3 ? 280px : 210px;
    property <length> footer: kind == 3 ? 40px : 0px;
    node-height: kind == 1 || kind == 3 ? header + rows * lane-h + 10px + footer : 68px;

    property <color> container: kind == 0 ? M3.green-container : kind == 1 ? M3.tertiary-container
        : kind == 3 ? M3.secondary-container : M3.primary-container;
    property <color> on-container: kind == 0 ? M3.on-green-container : kind == 1 ? M3.on-tertiary-container
        : kind == 3 ? M3.on-secondary-container : M3.on-primary-container;
    property <bool> lanes: kind == 1 || kind == 3;

    // y of the centre of lane n (multi-lane blocks), or the middle of a simple block
    pure function lane-y(n: int) -> length {
        return root.lanes ? root.header + n * root.lane-h + root.lane-h / 2 : root.node-height / 2;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.container;
        // selected nodes morph to a rounder shape (expressive shape change)
        border-radius: root.selected ? 28px : 18px;
        border-width: root.selected ? 3px : 0px;
        border-color: M3.primary;
        drop-shadow-blur: root.selected ? 12px : 3px;
        drop-shadow-offset-y: root.selected ? 4px : 1px;
        drop-shadow-color: #00000038;
        animate border-radius, drop-shadow-blur, drop-shadow-offset-y {
            duration: Motion.fast-spatial; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90);
        }
        animate border-width { duration: Motion.fast-effects; easing: cubic-bezier(0.31, 0.94, 0.34, 1.0); }

        Text {
            x: 20px; y: 12px;
            text: root.title;
            font-size: 15px;
            font-weight: 700;
            color: root.on-container;
        }
        Text {
            x: 20px; y: 34px;
            text: root.detail;
            font-size: 12px;
            color: root.on-container.with-alpha(0.72);
        }
        if root.lanes: Rectangle {
            x: 12px;
            y: root.header - 4px;
            width: parent.width - 24px;
            height: 1px;
            background: root.on-container.with-alpha(0.15);
        }
    }

    // relay: wiring inside the block, input lane dot -> output lane dot
    for w in root.wires: Path {
        x: 0; y: 0;
        width: root.node-width;
        height: root.node-height;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: root.node-width / 1px;
        viewbox-height: root.node-height / 1px;
        stroke: M3.primary;
        stroke-width: 2px;
        MoveTo { x: root.inset / 1px; y: root.lane-y(w.i) / 1px; }
        CubicTo {
            control-1-x: root.node-width / 2px; control-1-y: root.lane-y(w.i) / 1px;
            control-2-x: root.node-width / 2px; control-2-y: root.lane-y(w.o) / 1px;
            x: (root.node-width - root.inset) / 1px; y: root.lane-y(w.o) / 1px;
        }
    }
    // --- relay: editing the inner wiring by dragging between the dots ---
    property <int> drag-side: 0;        // 0 none, 1 from an input dot, 2 from an output dot
    property <int> drag-lane: -1;
    property <bool> drag-moved;
    property <length> drag-px;
    property <length> drag-py;
    property <int> drop-lane: floor((drag-py - header) / lane-h);
    property <bool> drop-ok: drag-moved && (
        drag-side == 1 ? abs(drag-px - (root.node-width - inset)) < 26px && drop-lane >= 0 && drop-lane < outs
        : drag-side == 2 ? abs(drag-px - inset) < 26px && drop-lane >= 0 && drop-lane < ins : false);

    function drag-start(side: int, lane: int, px: length, py: length) {
        root.drag-side = side;
        root.drag-lane = lane;
        root.drag-moved = false;
        root.drag-px = px;
        root.drag-py = py;
    }
    function drag-move(px: length, py: length) {
        if (abs(px - root.drag-px) + abs(py - root.drag-py) > 3px) { root.drag-moved = true; }
        root.drag-px = px;
        root.drag-py = py;
    }
    function drag-end() {
        if (root.drag-moved) {
            if (root.drag-side == 1) {
                // dropped on an output dot: wire it; dropped anywhere else: unwire this input
                root.wire-requested(root.drag-lane, root.drop-ok ? root.drop-lane : -1);
            } else if (root.drag-side == 2 && root.drop-ok) {
                root.wire-requested(root.drop-lane, root.drag-lane);
            }
        }
        root.drag-side = 0;
        root.drag-moved = false;
    }

    // the wire being dragged
    if root.drag-side != 0 && root.drag-moved: Path {
        x: 0; y: 0;
        width: root.node-width;
        height: root.node-height;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: root.node-width / 1px;
        viewbox-height: root.node-height / 1px;
        stroke: root.drop-ok ? M3.primary : M3.on-surface-variant;
        stroke-width: 2px;
        MoveTo {
            x: (root.drag-side == 1 ? root.inset : root.node-width - root.inset) / 1px;
            y: root.lane-y(root.drag-lane) / 1px;
        }
        LineTo { x: root.drag-px / 1px; y: root.drag-py / 1px; }
    }
    // the dot it would land on
    if root.drop-ok: Rectangle {
        x: (root.drag-side == 1 ? root.node-width - root.inset : root.inset) - 9px;
        y: root.lane-y(root.drop-lane) - 9px;
        width: 18px; height: 18px; border-radius: 9px;
        border-width: 2px;
        border-color: M3.primary;
        background: M3.primary.with-alpha(0.2);
    }

    for i in (root.kind == 3 ? root.ins : 0): Rectangle {
        x: root.inset - 10px; y: root.lane-y(i) - 10px;
        width: 20px; height: 20px;
        property <bool> wired: root.in-wired[i];
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: in-ta.has-hover ? 12px : 8px; height: self.width; border-radius: self.width / 2;
            background: parent.wired ? M3.primary : #e8b339;
            animate width { duration: Motion.fast-spatial; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
        }
        in-ta := TouchArea {
            mouse-cursor: crosshair;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                    root.drag-start(1, i, parent.x + self.mouse-x, parent.y + self.mouse-y);
                } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                    root.drag-end();
                }
            }
            moved => { root.drag-move(parent.x + self.mouse-x, parent.y + self.mouse-y); }
        }
    }
    for o in (root.kind == 3 ? root.outs : 0): Rectangle {
        x: root.node-width - root.inset - 10px; y: root.lane-y(o) - 10px;
        width: 20px; height: 20px;
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: out-ta.has-hover ? 12px : 8px; height: self.width; border-radius: self.width / 2;
            background: M3.primary;
            animate width { duration: Motion.fast-spatial; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
        }
        out-ta := TouchArea {
            mouse-cursor: crosshair;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                    root.drag-start(2, o, parent.x + self.mouse-x, parent.y + self.mouse-y);
                } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                    root.drag-end();
                }
            }
            moved => { root.drag-move(parent.x + self.mouse-x, parent.y + self.mouse-y); }
        }
    }

    // lane labels
    for label[i] in root.in-labels: Text {
        x: 14px;
        y: root.lane-y(i) - self.height / 2;
        text: label;
        font-size: 12px;
        color: root.on-container.with-alpha(0.8);
    }
    for label[o] in root.out-labels: Text {
        x: root.node-width - self.width - 14px;
        y: root.lane-y(o) - self.height / 2;
        text: label;
        font-size: 12px;
        color: root.on-container.with-alpha(0.8);
    }

    // relay: right-click a lane to remove it (or add one on that side)
    for i in (root.kind == 3 ? root.ins : 0): ContextMenuArea {
        x: 0; y: root.lane-y(i) - root.lane-h / 2;
        width: root.inset - 12px; height: root.lane-h;
        Menu {
            MenuItem { title: "입력 레인 \{i + 1} 삭제"; enabled: root.ins > 1; activated => { root.lane-remove(true, i); } }
            MenuItem { title: "입력 레인 추가"; activated => { root.lane-add(true); } }
        }
    }
    for o in (root.kind == 3 ? root.outs : 0): ContextMenuArea {
        x: root.node-width - root.inset + 12px; y: root.lane-y(o) - root.lane-h / 2;
        width: root.inset - 12px; height: root.lane-h;
        Menu {
            MenuItem { title: "출력 레인 \{o + 1} 삭제"; enabled: root.outs > 1; activated => { root.lane-remove(false, o); } }
            MenuItem { title: "출력 레인 추가"; activated => { root.lane-add(false); } }
        }
    }
    // relay footer: one more lane on either side
    if root.kind == 3: HorizontalLayout {
        x: 12px;
        y: root.node-height - root.footer;
        width: root.node-width - 24px;
        height: root.footer - 8px;
        spacing: 8px;
        for side in [true, false]: Rectangle {
            border-radius: self.height / 2;
            background: add-ta.pressed ? root.on-container.with-alpha(0.16)
                : add-ta.has-hover ? root.on-container.with-alpha(0.10) : root.on-container.with-alpha(0.05);
            animate background { duration: Motion.fast-effects; }
            Text {
                text: side ? "+ 입력 레인" : "+ 출력 레인";
                font-size: 12px;
                font-weight: 600;
                color: root.on-container;
            }
            add-ta := TouchArea { clicked => { root.lane-add(side); } }
        }
    }

    for i in root.ins: Pin {
        x: -self.width / 2;
        y: root.lane-y(i) - self.height / 2;
        pin-id: root.node-id * 64 + i * 2;
        node-id: root.node-id;
        pin-type: PinTypes.input;
        node-screen-x: root.screen-x;
        node-screen-y: root.screen-y;
    }
    for o in root.outs: Pin {
        x: root.node-width - self.width / 2;
        y: root.lane-y(o) - self.height / 2;
        pin-id: root.node-id * 64 + o * 2 + 1;
        node-id: root.node-id;
        pin-type: PinTypes.output;
        node-screen-x: root.screen-x;
        node-screen-y: root.screen-y;
    }
}

// navigation rail item: glyph in a pill indicator that springs open, label below
component RailItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    width: 80px;
    height: 64px;

    indicator := Rectangle {
        y: 4px;
        x: (parent.width - self.width) / 2;
        width: root.active ? 56px : ta.has-hover ? 40px : 32px;
        height: 32px;
        border-radius: 16px;
        background: root.active ? M3.secondary-container : ta.has-hover ? M3.on-surface.with-alpha(0.08) : transparent;
        animate width { duration: Motion.fast-spatial; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
        animate background { duration: Motion.default-effects; }
        Text {
            text: root.glyph;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: root.active ? M3.on-secondary-container : M3.on-surface-variant;
        }
    }
    Text {
        y: 40px;
        width: parent.width;
        horizontal-alignment: center;
        text: root.label;
        font-size: 12px;
        font-weight: root.active ? 700 : 500;
        color: root.active ? M3.on-surface : M3.on-surface-variant;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// pages slide and fade in on their own layer (default spatial spring)
component Page inherits Rectangle {
    in property <bool> shown;
    opacity: shown ? 1 : 0;
    visible: self.opacity > 0.01;
    y: shown ? 0px : 28px;
    animate opacity { duration: Motion.default-effects; easing: cubic-bezier(0.31, 0.94, 0.34, 1.0); }
    animate y { duration: Motion.default-spatial; easing: cubic-bezier(0.38, 1.21, 0.22, 1.0); }
}

component ToolbarButton inherits Rectangle {
    in property <string> text;
    in property <bool> filled;
    callback clicked();
    height: 44px;
    width: label.preferred-width + 36px;
    border-radius: ta.pressed ? 12px : 22px;     // pressed buttons square off, then spring back
    background: filled ? M3.primary : ta.has-hover ? M3.on-surface.with-alpha(0.08) : transparent;
    animate border-radius { duration: Motion.fast-spatial; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
    label := Text {
        text: root.text;
        font-size: 14px;
        font-weight: 600;
        color: root.filled ? M3.on-primary : M3.on-surface;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component App inherits Window {
    title: "ProxyDock UI prototype (Slint · Material 3 Expressive)";
    preferred-width: 1200px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 400px;
    default-font-family: "Pretendard Variable";
    default-font-size: 14px;
    background: M3.surface-container;

    // the title bar takes the same colours (Windows 11: src/main.rs apply_title_bar)
    out property <bool> dark: M3.dark;
    out property <color> caption-color: M3.surface-container;
    out property <color> caption-text: M3.on-surface;
    callback theme-changed();
    changed dark => { root.theme-changed(); }

    public function focus-editor() { editor.focus(); }

    in-out property <int> page: 0;

    // canvas
    in property <[NodeData]> nodes;
    in property <[LinkData]> links <=> editor.links;
    in-out property <string> grid-commands <=> editor.grid-commands;
    out property <float> width_: editor.width / 1px;
    out property <float> height_: editor.height / 1px;
    callback add-node-requested(int);
    callback add-many-requested(int);
    callback delete-selected-requested();
    callback relay-wire-requested(int, int, int);   // node id, input lane, output lane (-1: unwire)
    callback relay-lane-add(int, bool);             // node id, input side?
    callback relay-lane-remove(int, bool, int);     // node id, input side?, lane
    callback link-requested <=> editor.link-requested;
    callback node-selected <=> editor.node-selected;
    callback select-link <=> editor.select-link;
    callback selection-cleared <=> editor.selection-cleared;
    callback box-selection-committed <=> editor.box-selection-committed;
    callback compute-link-at <=> editor.compute-link-at;

    // logs
    in property <[string]> log-lines;
    in property <int> log-total;
    in-out property <bool> follow: true;
    in-out property <int> rate-index: 2;
    callback rate-changed(int);
    callback clear-logs();
    public function scroll-to-end() {
        if (root.follow) {
            log-view.content-y = min(0px, log-view.visible-height - log-view.content-height);
        }
    }

    // status line
    in property <string> stats;

    HorizontalLayout {
        // navigation rail
        VerticalLayout {
            width: 96px;
            padding-top: 20px;
            padding-bottom: 12px;
            spacing: 12px;
            alignment: start;
            Rectangle {
                height: 56px;
                // app mark: the tray icon's shape as a tonal FAB
                Rectangle {
                    width: 56px; height: 56px;
                    border-radius: 16px;
                    background: M3.primary-container;
                    Text { text: "PD"; font-size: 18px; font-weight: 800; color: M3.on-primary-container; }
                }
            }
            Rectangle { height: 8px; }
            HorizontalLayout { alignment: center; RailItem { glyph: "◇"; label: "캔버스"; active: root.page == 0; clicked => { root.page = 0; } } }
            HorizontalLayout { alignment: center; RailItem { glyph: "≡"; label: "로그"; active: root.page == 1; clicked => { root.page = 1; } } }
            HorizontalLayout { alignment: center; RailItem { glyph: "가"; label: "입력"; active: root.page == 2; clicked => { root.page = 2; } } }
        }

        VerticalLayout {
            padding-right: 12px;
            padding-top: 12px;
            spacing: 6px;
            // content in one large rounded surface
            Rectangle {
                vertical-stretch: 1;
                background: M3.surface;
                border-radius: 28px;
                clip: true;

                Page {
                    shown: root.page == 0;
                    editor := NodeEditor {
                        width: 100%;
                        height: 100%;
                        has-link-selection: true;
                        // The software renderer stores rectangle sizes as i16 (max 32767 physical px); the default
                        // 100000px world container overflows it. 8000px x zoom 2 x 200% DPI stays inside.
                        world-content-size: 8000px;
                        max-zoom: 2.0;
                        for node in root.nodes: ProxyNode {
                            node-id: node.id;
                            title: node.title;
                            detail: node.detail;
                            kind: node.kind;
                            ins: node.ins;
                            outs: node.outs;
                            in-labels: node.in-labels;
                            out-labels: node.out-labels;
                            wires: node.wires;
                            in-wired: node.in-wired;
                            wire-requested(i, o) => { root.relay-wire-requested(node.id, i, o); }
                            lane-add(is-in) => { root.relay-lane-add(node.id, is-in); }
                            lane-remove(is-in, lane) => { root.relay-lane-remove(node.id, is-in, lane); }
                            world-x: node.x * 1px;
                            world-y: node.y * 1px;
                            selected: node.selected;
                        }
                    }
                    // M3 Expressive floating toolbar
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 20px;
                        width: bar.preferred-width + 16px;
                        height: 60px;
                        border-radius: 30px;
                        background: M3.surface-container-high;
                        drop-shadow-blur: 10px;
                        drop-shadow-offset-y: 3px;
                        drop-shadow-color: #00000040;
                        bar := HorizontalLayout {
                            padding: 8px;
                            spacing: 4px;
                            ToolbarButton { text: "+ 인바운드"; clicked => { root.add-node-requested(0); } }
                            ToolbarButton { text: "+ 아웃바운드"; clicked => { root.add-node-requested(2); } }
                            ToolbarButton { text: "+ 릴레이"; clicked => { root.add-node-requested(3); } }
                            ToolbarButton { text: "노드 100개"; clicked => { root.add-many-requested(100); } }
                            ToolbarButton { text: "선택 삭제"; filled: true; clicked => { root.delete-selected-requested(); } }
                        }
                    }
                }

                Page {
                    shown: root.page == 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            Text { text: "로그"; font-size: 24px; font-weight: 700; color: M3.on-surface; vertical-alignment: center; }
                            Rectangle { width: 12px; }
                            Text { text: "초당 줄 수"; vertical-alignment: center; color: M3.on-surface-variant; }
                            ComboBox {
                                model: ["0", "100", "500", "2000", "10000"];
                                current-index <=> root.rate-index;
                                selected => { root.rate-changed(self.current-index); }
                            }
                            CheckBox { text: "끝으로 따라가기"; checked <=> root.follow; }
                            Button { text: "지우기"; clicked => { root.clear-logs(); } }
                            Text {
                                text: "받은 줄 \{root.log-total} · 표시 \{root.log-lines.length}";
                                vertical-alignment: center;
                                color: M3.on-surface-variant;
                            }
                        }
                        Rectangle {
                            background: M3.surface-container-low;
                            border-radius: 20px;
                            clip: true;
                            log-view := ListView {
                                for line in root.log-lines: Text {
                                    text: line;
                                    height: 20px;
                                    x: 14px;
                                    font-family: "JetBrains Mono";
                                    font-size: 12px;
                                    color: M3.on-surface;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Page {
                    shown: root.page == 2;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;
                        alignment: start;
                        Text { text: "입력 (한글 IME)"; font-size: 24px; font-weight: 700; color: M3.on-surface; }
                        Text {
                            text: "조합 중인 글자가 입력란 안에 보이는지, 후보 창이 커서 옆에 뜨는지 확인하세요.";
                            color: M3.on-surface-variant;
                        }
                        name := LineEdit { placeholder-text: "프록시 이름 (예: 회사 VPN 경유)"; }
                        Text { text: "입력된 값: " + name.text; color: M3.on-surface; }
                        TextEdit {
                            height: 200px;
                            text: "여러 줄 메모. 선택, 복사, 붙여넣기도 확인해 보세요.\n日本語・中文 混在テキスト";
                        }
                    }
                }
            }
            Text {
                height: 22px;
                text: root.stats;
                font-size: 12px;
                color: M3.on-surface-variant;
                vertical-alignment: center;
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    callback show-requested();
    callback quit-requested();
    in property <image> app-icon;
    icon: app-icon;
    tooltip: "ProxyDock prototype";
    clicked => { root.show-requested(); }
    Menu {
        MenuItem { title: "창 열기"; activated => { root.show-requested(); } }
        MenuItem { title: "종료"; activated => { root.quit-requested(); } }
    }
}
