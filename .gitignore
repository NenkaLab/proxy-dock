# Python
__pycache__/
*.py[cod]
*$py.class

# virtual environments (tools/build.py creates one per OS)
.venv/
.venv-linux/
.venv-mac/
venv/
env/

# build output (PyInstaller)
build/
dist/
# ProxyDock.spec is the build configuration and stays in the repo (no generic *.spec ignore rule)

# archived single-file version (local only)
legacy/

# runtime files - settings/certificates/logs live in the OS settings folder, but block stray copies
config.json
config.json.*
window.json
*.crt
*.key
*.pem
logs/
*.log

# tools / OS
.claude/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# sing-box binaries (tools/fetch_singbox.py; the installer ships them)
bin/
